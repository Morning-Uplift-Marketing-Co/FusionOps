---
import Layout from '../layouts/Layout.astro';
const brand = import.meta.env.PUBLIC_BRAND || 'FusionOps Sample';
const cta = import.meta.env.PUBLIC_CTA || 'Get Started';
const sub = import.meta.env.PUBLIC_SUB || 'Fast Astro template import test';
---
<Layout title={brand} description={sub}>
  <main style="font-family: Arial, sans-serif; padding: 48px; max-width: 960px; margin: 0 auto;">
    <section style="background: linear-gradient(135deg, #eff6ff, #ffffff); border: 1px solid #bfdbfe; border-radius: 24px; padding: 40px;">
      <p style="color: #2563eb; font-weight: 700; margin: 0 0 12px;">Astro Import Test</p>
      <h1 style="font-size: 48px; line-height: 1.1; margin: 0 0 16px;">{brand}</h1>
      <p style="font-size: 18px; color: #475569; margin: 0 0 24px;">{sub}</p>
      <a href="/apply" style="display: inline-block; background: #2563eb; color: #fff; padding: 14px 22px; border-radius: 999px; text-decoration: none; font-weight: 700;">{cta}</a>
    </section>
  </main>
</Layout>
