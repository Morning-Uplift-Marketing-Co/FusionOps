# ─── FusionOps Automation Stack — Environment Variables ───────────────────────
# Copy to .env and fill in values

# Cloudflare API Worker
FBIS_API_BASE=https://lp-factory-api.misty-feather-556e.workers.dev
FBIS_API_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USERS=         # comma-separated Telegram user IDs
TELEGRAM_HOME_CHANNEL=          # default chat ID for cron reports
TELEGRAM_WEBHOOK_URL=           # https://YOUR_SERVER_IP/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=        # openssl rand -hex 32

# Hermes Agent — OpenRouter
OPENROUTER_API_KEY=             # sk-or-...
HERMES_INFERENCE_PROVIDER=openrouter
HERMES_INFERENCE_MODEL=anthropic/claude-haiku-4-5   # cheap, fast

# Mission Control
MC_USER=admin
MC_PASS=                        # generate: openssl rand -base64 16
MC_API_KEY=                     # generate: openssl rand -hex 32

# mem0 (managed, free tier)
MEM0_API_KEY=                   # from app.mem0.ai

# Google Ads (for reporting agents)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
