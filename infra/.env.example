# ─── FusionOps Automation Stack — Environment Variables ───────────────────────
# Copy to .env and fill in values
# Source: infra/hermes/config.yaml (Hermes agent config)
#         infra/docker-compose.yml (container environment)

# ─── Cloudflare API Worker ────────────────────────────────────────────────────
FBIS_API_BASE=https://lp-factory-api.misty-feather-556e.workers.dev
FBIS_API_KEY=                   # Cloudflare D1 API key

# ─── Telegram Integration (Cron Alerts & Telegram Platform) ────────────────────
TELEGRAM_BOT_TOKEN=             # BotFather → /newbot → token
TELEGRAM_CHAT_ID=               # Default chat/channel for alerts
TELEGRAM_ALLOWED_USERS=         # comma-separated Telegram user IDs
TELEGRAM_HOME_CHANNEL=          # default chat ID for cron reports
TELEGRAM_WEBHOOK_URL=           # https://YOUR_SERVER_IP/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=        # openssl rand -hex 32

# ─── Hermes Agent — OpenRouter ────────────────────────────────────────────────
OPENROUTER_API_KEY=             # sk-or-... (for inference)
HERMES_INFERENCE_PROVIDER=openrouter
HERMES_INFERENCE_MODEL=anthropic/claude-haiku-4-5

# ─── Mission Control (Sub-agent Orchestration) ─────────────────────────────────
MC_USER=admin
MC_PASS=                        # generate: openssl rand -base64 16
MC_API_KEY=                     # generate: openssl rand -hex 32

# ─── mem0 (Long-term Agent Memory) ────────────────────────────────────────────
MEM0_API_KEY=                   # from app.mem0.ai (free tier: 1000 API calls/month)

# ─── DashClaw Governance (HITL Approval Flows) ────────────────────────────────
DASHCLAW_BASE_URL=http://dashclaw-app-1:3100
DASHCLAW_API_KEY=               # Admin API key from DashClaw UI
# Used by: fbis-mcp-server (risk.py) for approval flows on critical verdicts

# ─── Google Ads (for reporting agents) ────────────────────────────────────────
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=

# ─── Phase 4-6 Status ─────────────────────────────────────────────────────────
# ✅ Phase 4: DashClaw HITL Wiring complete
#   - risk.py updated with 5-step approval flow
#   - Policies registered in DashClaw UI (manual)
#   - Audit trail enabled (7-year retention)
#
# ✅ Phase 5: Ecosystem Plugins
#   - disk-cleanup plugin enabled
#   - Compression configured (threshold 0.3)
#   - Mission-control configured (optional deployment)
#
# ✅ Phase 6: Repo↔VPS Config Sync
#   - hermes/config.yaml synced from deployed instance
#   - All secrets using ${VAR} references
#   - Setup.sh updated with credential requirements
