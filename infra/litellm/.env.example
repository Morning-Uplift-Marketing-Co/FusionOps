# LiteLLM Proxy Configuration

# OpenRouter API key (required)
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Langfuse tracing credentials (from Langfuse UI → Settings → API Keys)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...

# Langfuse host (if same Docker network as Langfuse stack)
LANGFUSE_HOST=http://langfuse-web:3000
# Alternative: if LiteLLM is on different host/network
# LANGFUSE_HOST=http://178.105.137.23:3030

# Optional: LiteLLM master API key (for proxy authentication)
# Generate: openssl rand -hex 32
LITELLM_MASTER_KEY=
