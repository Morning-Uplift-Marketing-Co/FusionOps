# Dockerfile for Graphify dependency visualization MCP server
# Used in docker-compose.yml for Phase 5 ecosystem plugins

FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Install Graphify
RUN pip install --no-cache-dir graphify

# Health check script
HEALTHCHECK --interval=10s --timeout=5s --retries=3 \
  CMD curl -f http://localhost:${PORT:-8767}/mcp || exit 1

# Expose port for MCP server
EXPOSE 8767

# Start Graphify MCP server
CMD ["python", "-m", "graphify.serve", "--port", "8767", "--dir", "/workspace"]
