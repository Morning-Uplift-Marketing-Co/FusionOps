# Langfuse v3 self-hosted secrets
# Generate values via:
#   openssl rand -hex 32        # for POSTGRES_PASSWORD, CLICKHOUSE_PASSWORD, REDIS_AUTH, MINIO_ROOT_PASSWORD
#   openssl rand -base64 32     # for NEXTAUTH_SECRET, LANGFUSE_SALT
#   openssl rand -base64 32     # for LANGFUSE_ENCRYPTION_KEY (must be exactly 256-bit = 64 hex / 32 bytes base64)
#
# After deploy:
#   1. Visit http://178.105.137.23:3030
#   2. Sign up the FIRST account (becomes admin)
#   3. Create an organization, then a project
#   4. Generate API keys under Settings > API Keys
#   5. Use those keys with LiteLLM proxy below

POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
REDIS_AUTH=
MINIO_ROOT_PASSWORD=
NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=

# LiteLLM proxy config (use after Langfuse is up + API keys generated)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://langfuse-web:3000   # if LiteLLM is in same compose network
# LANGFUSE_HOST=http://178.105.137.23:3030  # if LiteLLM is on different host
