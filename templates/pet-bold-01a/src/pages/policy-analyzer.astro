---
export const prerender = true;

import Layout from '../layouts/Layout.astro';

const title = 'Policy Risk Analyzer — Remove Absolute Language';
const description = 'AI-powered tool to identify and replace zero-risk language in policy documents with legally defensible alternatives.';
---

<Layout title={title} description={description}>
  <div class="min-h-screen pt-24 pb-16 px-6">
    <div class="max-w-7xl mx-auto">
      <!-- Header -->
      <div class="text-center mb-12">
        <h1 class="font-display font-bold text-4xl md:text-5xl text-foreground mb-4">
          Policy Risk Analyzer
        </h1>
        <p class="text-foreground/70 text-lg max-w-2xl mx-auto">
          Automatically identify and replace absolute risk language with qualified, legally defensible alternatives
        </p>
      </div>

      <!-- Main Grid -->
      <div class="grid lg:grid-cols-2 gap-8">
        <!-- Left: Input Section -->
        <div class="space-y-6">
          <div class="premium-card p-6">
            <h2 class="font-display font-bold text-xl text-foreground mb-4">Upload Policy Document</h2>

            <div class="space-y-4">
              <!-- Document Title -->
              <div>
                <label for="doc-title" class="block text-sm font-semibold text-foreground/70 mb-2">
                  Document Title
                </label>
                <input
                  type="text"
                  id="doc-title"
                  placeholder="e.g., Data Security Policy 2024"
                  class="w-full px-4 py-3 rounded-lg border border-border bg-surface text-foreground placeholder-foreground/30 focus:outline-none focus:border-primary/50 focus:ring-1 focus:ring-primary/30"
                />
              </div>

              <!-- Category -->
              <div>
                <label for="doc-category" class="block text-sm font-semibold text-foreground/70 mb-2">
                  Category
                </label>
                <select
                  id="doc-category"
                  class="w-full px-4 py-3 rounded-lg border border-border bg-surface text-foreground focus:outline-none focus:border-primary/50 focus:ring-1 focus:ring-primary/30"
                >
                  <option value="general">General Policy</option>
                  <option value="financial">Financial Services</option>
                  <option value="legal">Legal Agreement</option>
                  <option value="insurance">Insurance Policy</option>
                  <option value="security">Security & Privacy</option>
                  <option value="medical">Medical/Healthcare</option>
                </select>
              </div>

              <!-- Text Area -->
              <div>
                <label for="doc-content" class="block text-sm font-semibold text-foreground/70 mb-2">
                  Policy Text
                </label>
                <textarea
                  id="doc-content"
                  rows="12"
                  placeholder="Paste your policy document here..."
                  class="w-full px-4 py-3 rounded-lg border border-border bg-surface text-foreground placeholder-foreground/30 focus:outline-none focus:border-primary/50 focus:ring-1 focus:ring-primary/30 font-mono text-sm"
                ></textarea>
              </div>

              <!-- Analyze Button -->
              <button
                id="analyze-btn"
                class="btn-primary w-full py-4 justify-center text-base"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                  <path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                </svg>
                Analyze Document
              </button>

              <!-- Status Messages -->
              <div id="status-message" class="hidden"></div>
            </div>
          </div>

          <!-- Risk Patterns Info -->
          <div class="glass-card p-5">
            <h3 class="font-display font-semibold text-foreground text-sm mb-3">
              Patterns Detected
            </h3>
            <div class="space-y-2 text-xs text-foreground/70">
              <div class="flex items-center gap-2">
                <div class="w-2 h-2 rounded-full bg-red-500"></div>
                <span>"zero risk" → "minimal risk"</span>
              </div>
              <div class="flex items-center gap-2">
                <div class="w-2 h-2 rounded-full bg-red-500"></div>
                <span>"no risk" → "substantially reduced risk"</span>
              </div>
              <div class="flex items-center gap-2">
                <div class="w-2 h-2 rounded-full bg-red-500"></div>
                <span>"risk-free" → "low probability of occurrence"</span>
              </div>
              <div class="flex items-center gap-2">
                <div class="w-2 h-2 rounded-full bg-red-500"></div>
                <span>"completely safe" → "robust security measures"</span>
              </div>
              <div class="flex items-center gap-2">
                <div class="w-2 h-2 rounded-full bg-red-500"></div>
                <span>"absolutely secure" → "comprehensive protections"</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Right: Results Section -->
        <div class="space-y-6">
          <div class="premium-card p-6" id="results-container">
            <div id="empty-state" class="text-center py-16">
              <div class="w-16 h-16 rounded-2xl bg-primary/10 flex items-center justify-center mx-auto mb-4">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="hsl(193 46% 44%)" stroke-width="2" stroke-linecap="round">
                  <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
                  <polyline points="14 2 14 8 20 8"/>
                  <line x1="16" y1="13" x2="8" y2="13"/>
                  <line x1="16" y1="17" x2="8" y2="17"/>
                  <polyline points="10 9 9 9 8 9"/>
                </svg>
              </div>
              <h3 class="font-display font-semibold text-foreground text-lg mb-2">
                No Analysis Yet
              </h3>
              <p class="text-foreground/60 text-sm max-w-xs mx-auto">
                Enter your policy document and click "Analyze Document" to see results
              </p>
            </div>

            <!-- Results will be injected here -->
            <div id="analysis-results" class="hidden space-y-6"></div>
          </div>
        </div>
      </div>

      <!-- Document History -->
      <div class="mt-12">
        <div class="premium-card p-6">
          <h2 class="font-display font-bold text-xl text-foreground mb-6">Recent Documents</h2>
          <div id="document-history" class="space-y-3">
            <div class="text-center py-8 text-foreground/50 text-sm">
              No documents analyzed yet
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    import { createClient } from '@supabase/supabase-js';

    const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
    const supabaseKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
    const supabase = createClient(supabaseUrl, supabaseKey);

    const analyzeBtn = document.getElementById('analyze-btn') as HTMLButtonElement;
    const docTitle = document.getElementById('doc-title') as HTMLInputElement;
    const docCategory = document.getElementById('doc-category') as HTMLSelectElement;
    const docContent = document.getElementById('doc-content') as HTMLTextAreaElement;
    const statusMessage = document.getElementById('status-message') as HTMLDivElement;
    const emptyState = document.getElementById('empty-state') as HTMLDivElement;
    const analysisResults = document.getElementById('analysis-results') as HTMLDivElement;
    const documentHistory = document.getElementById('document-history') as HTMLDivElement;

    function showStatus(message: string, type: 'error' | 'success' | 'info') {
      statusMessage.className = `p-4 rounded-lg text-sm ${
        type === 'error' ? 'bg-red-500/10 text-red-600' :
        type === 'success' ? 'bg-green-500/10 text-green-600' :
        'bg-blue-500/10 text-blue-600'
      }`;
      statusMessage.textContent = message;
      statusMessage.classList.remove('hidden');
    }

    function hideStatus() {
      statusMessage.classList.add('hidden');
    }

    async function analyzeDocument() {
      const title = docTitle.value.trim();
      const category = docCategory.value;
      const content = docContent.value.trim();

      if (!title || !content) {
        showStatus('Please provide both a title and document content', 'error');
        return;
      }

      analyzeBtn.disabled = true;
      analyzeBtn.innerHTML = '<span class="animate-spin">⏳</span> Analyzing...';
      hideStatus();

      try {
        // Check if user is authenticated
        const { data: { user } } = await supabase.auth.getUser();

        if (!user) {
          showStatus('Please sign in to use this feature', 'error');
          analyzeBtn.disabled = false;
          analyzeBtn.innerHTML = 'Analyze Document';
          return;
        }

        // Call edge function
        const response = await fetch(`${supabaseUrl}/functions/v1/analyze-policy`, {
          method: 'POST',
          headers: {
            'Authorization': `Bearer ${supabaseKey}`,
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            title,
            category,
            content,
            userId: user.id
          })
        });

        if (!response.ok) {
          throw new Error('Analysis failed');
        }

        const result = await response.json();
        displayResults(result);
        loadDocumentHistory();
        showStatus('Analysis complete!', 'success');

      } catch (error) {
        console.error('Analysis error:', error);
        showStatus('Failed to analyze document. Please try again.', 'error');
      } finally {
        analyzeBtn.disabled = false;
        analyzeBtn.innerHTML = `
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
          Analyze Document
        `;
      }
    }

    function displayResults(result: any) {
      emptyState.classList.add('hidden');
      analysisResults.classList.remove('hidden');

      const changesHtml = result.changes.map((change: any, idx: number) => `
        <div class="glass-card p-4">
          <div class="flex items-start gap-3 mb-3">
            <div class="w-6 h-6 rounded-lg bg-red-500/10 flex items-center justify-center flex-shrink-0 mt-0.5">
              <span class="text-red-600 text-xs font-bold">${idx + 1}</span>
            </div>
            <div class="flex-1 min-w-0">
              <div class="text-xs font-semibold text-red-600 uppercase tracking-wider mb-2">
                ${change.risk_category.replace(/_/g, ' ')}
              </div>
              <div class="space-y-2">
                <div>
                  <div class="text-xs text-foreground/50 mb-1">Original:</div>
                  <div class="p-2 rounded bg-red-500/5 border border-red-500/20 text-sm text-foreground/80 font-mono">
                    "${change.original_text}"
                  </div>
                </div>
                <div>
                  <div class="text-xs text-foreground/50 mb-1">Revised:</div>
                  <div class="p-2 rounded bg-green-500/5 border border-green-500/20 text-sm text-foreground/80 font-mono">
                    "${change.revised_text}"
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      `).join('');

      analysisResults.innerHTML = `
        <div class="flex items-center justify-between mb-4">
          <h3 class="font-display font-semibold text-foreground text-lg">Analysis Results</h3>
          <div class="px-3 py-1 rounded-full bg-primary/10 text-primary text-sm font-semibold">
            ${result.risk_issues_found} issue${result.risk_issues_found !== 1 ? 's' : ''} found
          </div>
        </div>

        <div class="space-y-3 mb-6">
          ${changesHtml}
        </div>

        <div class="pt-4 border-t border-border">
          <h4 class="font-display font-semibold text-foreground text-sm mb-3">Revised Document</h4>
          <div class="p-4 rounded-lg bg-surface border border-border max-h-96 overflow-y-auto">
            <pre class="text-sm text-foreground/80 whitespace-pre-wrap font-mono">${result.revised_content}</pre>
          </div>
        </div>

        <div class="mt-4 flex gap-3">
          <button id="copy-btn" class="btn-primary flex-1 py-3 justify-center">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
              <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/>
            </svg>
            Copy Revised Text
          </button>
          <button id="download-btn" class="glass-card px-6 py-3 flex items-center gap-2 hover:bg-surface/50 transition-colors">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3"/>
            </svg>
            Download
          </button>
        </div>
      `;

      // Add event listeners for buttons
      document.getElementById('copy-btn')?.addEventListener('click', () => {
        navigator.clipboard.writeText(result.revised_content);
        showStatus('Copied to clipboard!', 'success');
      });

      document.getElementById('download-btn')?.addEventListener('click', () => {
        const blob = new Blob([result.revised_content], { type: 'text/plain' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `${docTitle.value.replace(/\s+/g, '_')}_revised.txt`;
        a.click();
        URL.revokeObjectURL(url);
      });
    }

    async function loadDocumentHistory() {
      try {
        const { data: { user } } = await supabase.auth.getUser();
        if (!user) return;

        const { data: documents } = await supabase
          .from('policy_documents')
          .select('id, title, category, created_at, status')
          .eq('user_id', user.id)
          .order('created_at', { ascending: false })
          .limit(10);

        if (!documents || documents.length === 0) {
          documentHistory.innerHTML = `
            <div class="text-center py-8 text-foreground/50 text-sm">
              No documents analyzed yet
            </div>
          `;
          return;
        }

        documentHistory.innerHTML = documents.map(doc => `
          <div class="glass-card p-4 flex items-center justify-between hover:bg-surface/50 transition-colors cursor-pointer" data-doc-id="${doc.id}">
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-lg bg-primary/10 flex items-center justify-center">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="hsl(193 46% 44%)" stroke-width="2" stroke-linecap="round">
                  <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
                  <polyline points="14 2 14 8 20 8"/>
                </svg>
              </div>
              <div>
                <div class="font-semibold text-foreground text-sm">${doc.title}</div>
                <div class="text-xs text-foreground/50">${doc.category} · ${new Date(doc.created_at).toLocaleDateString()}</div>
              </div>
            </div>
            <div class="px-2 py-1 rounded text-xs font-semibold ${
              doc.status === 'approved' ? 'bg-green-500/10 text-green-600' :
              doc.status === 'under_review' ? 'bg-yellow-500/10 text-yellow-600' :
              'bg-gray-500/10 text-gray-600'
            }">
              ${doc.status}
            </div>
          </div>
        `).join('');

        // Add click handlers to view document details
        documentHistory.querySelectorAll('[data-doc-id]').forEach(el => {
          el.addEventListener('click', async () => {
            const docId = el.getAttribute('data-doc-id');
            await viewDocumentDetails(docId);
          });
        });
      } catch (error) {
        console.error('Failed to load document history:', error);
      }
    }

    async function viewDocumentDetails(docId: string) {
      try {
        const { data: document } = await supabase
          .from('policy_documents')
          .select('*')
          .eq('id', docId)
          .maybeSingle();

        const { data: revisions } = await supabase
          .from('policy_revisions')
          .select('*')
          .eq('document_id', docId)
          .order('created_at', { ascending: false });

        const latestRevision = revisions?.[0];

        if (!document || !latestRevision) return;

        const { data: changes } = await supabase
          .from('change_tracking')
          .select('*')
          .eq('revision_id', latestRevision.id)
          .order('line_number', { ascending: true });

        // Populate form with document data
        docTitle.value = document.title;
        docCategory.value = document.category;
        docContent.value = document.original_content;

        // Display results
        displayResults({
          document_id: document.id,
          revision_id: latestRevision.id,
          revised_content: latestRevision.revised_content,
          changes: changes || [],
          risk_issues_found: latestRevision.risk_issues_found
        });

        // Scroll to results
        analysisResults.scrollIntoView({ behavior: 'smooth', block: 'start' });
      } catch (error) {
        console.error('Failed to load document:', error);
        showStatus('Failed to load document details', 'error');
      }
    }

    analyzeBtn?.addEventListener('click', analyzeDocument);
    loadDocumentHistory();
  </script>
</Layout>
