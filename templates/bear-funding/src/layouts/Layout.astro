<!-- STICKY BAR JS -->
<script data-cfasync="false">
(function(){
  var bar = document.getElementById('sticky-bar');
  var closeBtn = document.getElementById('sticky-close-btn');
  var dismissed = false;

  function getScrollPct(){
    var scrolled = window.scrollY || document.documentElement.scrollTop;
    var total = document.documentElement.scrollHeight - window.innerHeight;
    return total > 0 ? (scrolled / total) * 100 : 0;
  }

  function isFormVisible(){
    var form = document.getElementById('get-matched');
    if(!form) return false;
    var rect = form.getBoundingClientRect();
    return rect.top < window.innerHeight && rect.bottom > 0;
  }

  function updateBar(){
    if(dismissed) return;
    var pct = getScrollPct();
    var formVisible = isFormVisible();
    if(pct >= 30 && !formVisible){
      bar.classList.add('visible');
    } else {
      bar.classList.remove('visible');
    }
  }

  window.addEventListener('scroll', updateBar, {passive:true});
  window.addEventListener('resize', updateBar, {passive:true});

  closeBtn.addEventListener('click', function(){
    dismissed = true;
    bar.classList.remove('visible');
  });

  window.scrollToForm = function(){
    var target = document.getElementById('get-matched');
    if(target){
      target.scrollIntoView({behavior:'smooth', block:'start'});
      setTimeout(function(){
        var zip = document.getElementById('zip');
        if(zip) zip.focus();
      }, 600);
    }
  };
})();
</script>

