---
import '../styles/global.css';
const brand          = import.meta.env.PUBLIC_BRAND          || 'BearFunding';
const domain         = import.meta.env.PUBLIC_DOMAIN         || 'example.com';
const sub            = import.meta.env.PUBLIC_SUB            || "Checking your rate won't affect your credit score.";
const cta            = import.meta.env.PUBLIC_CTA            || 'See My Offers — Free';
const phone          = import.meta.env.PUBLIC_PHONE          || '(800) 555-0100';
const email          = import.meta.env.PUBLIC_EMAIL          || `support@${import.meta.env.PUBLIC_DOMAIN || 'example.com'}`;
const address        = import.meta.env.PUBLIC_ADDRESS        || '2055 Limestone Rd STE 200-C, Wilmington, DE 19808';
const aid            = import.meta.env.PUBLIC_AID            || '';
const amountMin      = import.meta.env.PUBLIC_AMOUNTMIN      || '$500';
const amountMax      = import.meta.env.PUBLIC_AMOUNTMAX      || '$10,000';
const primaryColor   = import.meta.env.PUBLIC_PRIMARYCOLOR   || '#D4931F';
const accentColor    = import.meta.env.PUBLIC_ACCENTCOLOR    || '#F0B040';
const aprMin         = import.meta.env.PUBLIC_APRMIN         || '5.99';
const aprMax         = import.meta.env.PUBLIC_APRMAX         || '35.99';
const conversionId      = import.meta.env.PUBLIC_CONVERSIONID      || '';
const formStartLabel    = import.meta.env.PUBLIC_FORMSTARTLABEL    || 'form_start';
const formSubmitLabel   = import.meta.env.PUBLIC_FORMSUBMITLABEL   || 'form_submit';
const voluumId          = import.meta.env.PUBLIC_VOLUUMID          || '';
const voluumDomain      = import.meta.env.PUBLIC_VOLUUMDOMAIN      || '';
const voluumClickUrl    = import.meta.env.PUBLIC_VOLUUM_CLICK_URL  || '';
const ctaHref           = voluumClickUrl || '#apply';

const brandPrefix = brand.includes('Funding') ? brand.replace('Funding', '') : brand;
const brandSuffix = brand.includes('Funding') ? 'Funding' : '';

interface Props { title?: string; }
const { title = brand } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="color-scheme" content="dark light">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title} — Check Your Rate | {brand}</title>
  <meta name="description" content={sub}>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"></noscript>

  <style define:vars={{ primaryColor, accentColor }}>
    :root {
      --gold: var(--primaryColor);
      --gold-2: var(--accentColor);
    }
  </style>
  <script>
    (function(){
      function setNavH(){
        var nav = document.querySelector('nav');
        var apr = document.getElementById('apr-bar');
        var navH = nav ? nav.offsetHeight : 62;
        var aprH = apr ? apr.offsetHeight : 33;
        document.documentElement.style.setProperty('--nav-h', navH + 'px');
        document.documentElement.style.setProperty('--header-h', (navH + aprH) + 'px');
      }
      if(document.readyState === 'loading'){
        document.addEventListener('DOMContentLoaded', setNavH);
      } else {
        setNavH();
      }
      window.addEventListener('resize', setNavH);
    })();
  </script>

  <script data-cfasync="false" define:vars={{ conversionId, formStartLabel, formSubmitLabel, voluumId, voluumDomain, voluumClickUrl, ctaHref, aid }}>
    window.__conversionId    = conversionId;
    window.__formStartLabel  = formStartLabel;
    window.__formSubmitLabel = formSubmitLabel;
    window.__voluumId        = voluumId;
    window.__voluumDomain    = voluumDomain;
    window.__ctaHref         = ctaHref;
    window.__aid             = aid;
  </script>
</head>
<body>

<!-- NAV -->
<nav>
  <div class="wrap nav-inner">
    <a href="/" class="logo" aria-label={`${brand} Home`}>
      <div class="logo-icon">
        <svg viewBox="0 0 18 18"><path d="M9 1C5.13 1 2 4.13 2 8c0 2.3 1.1 4.3 2.8 5.6V15h8.4v-1.4C14.9 12.3 16 10.3 16 8c0-3.87-3.13-7-7-7z"/><circle cx="7" cy="8" r=".9" fill="#D4931F"/><circle cx="11" cy="8" r=".9" fill="#D4931F"/></svg>
      </div>
      <span class="logo-name">{brandPrefix}{brandSuffix && <span>{brandSuffix}</span>}</span>
    </a>
    <div class="nav-r">
      <div class="nav-badge">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M7 1L1.5 4v4.5C1.5 11.5 4 13.5 7 14c3-.5 5.5-2.5 5.5-5.5V4L7 1z" stroke="currentColor" stroke-width="1.2" fill="none"/><path d="M4.5 7.5l2 2 3.5-3.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
        SSL Secure
      </div>
      <button class="btn-ghost" onclick="document.getElementById('hero-form').scrollIntoView({behavior:'smooth'})">{cta}</button>
    </div>
  </div>
</nav>

<!-- STICKY APR BAR -->
<div id="apr-bar" role="note" aria-label="Rate and lender disclosure">
  APR range: <span class="apr-hl">{aprMin}% – {aprMax}%</span> &nbsp;·&nbsp; {amountMin}–{amountMax} &nbsp;·&nbsp; 6–60 month terms
  <span class="not-lender-tag">
    <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true"><path d="M5 1L1 3v2.5C1 7.8 3 9.2 5 9.5c2-.3 4-1.7 4-4V3L5 1z" stroke="currentColor" stroke-width="1" fill="none"/><path d="M3 5l1.5 1.5 3-2.5" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"/></svg>
    Not a Lender
  </span>
</div>

<slot />

<!-- FOOTER -->
<footer role="contentinfo">
  <div class="wrap">
    <div class="foot-cols">
      <div class="foot-brand-col">
        <a href="/" class="logo" aria-label={brand} style="opacity:.65">
          <div class="logo-icon" style="width:28px;height:28px">
            <svg viewBox="0 0 18 18" fill="#fff" width="14" height="14"><path d="M9 1C5.13 1 2 4.13 2 8c0 2.3 1.1 4.3 2.8 5.6V15h8.4v-1.4C14.9 12.3 16 10.3 16 8c0-3.87-3.13-7-7-7z"/></svg>
          </div>
          <span class="logo-name" style="font-size:15px;opacity:.55">{brandPrefix}{brandSuffix && <span>{brandSuffix}</span>}</span>
        </a>
        <p style="font-size:12px;color:rgba(255,255,255,.3);line-height:1.65;max-width:220px">
          Free loan-matching service. Not a lender. Connecting consumers with licensed lenders since 2021.
        </p>
        <div class="foot-contact-block">
          <div class="foot-contact-row">
            <svg width="13" height="13" viewBox="0 0 14 14" fill="none"><path d="M7 1C4.24 1 2 3.24 2 6c0 3.5 5 8 5 8s5-4.5 5-8c0-2.76-2.24-5-5-5zm0 6.5c-.83 0-1.5-.67-1.5-1.5S6.17 4.5 7 4.5s1.5.67 1.5 1.5S7.83 7.5 7 7.5z" stroke="currentColor" stroke-width="1" fill="none"/></svg>
            <span>{address}</span>
          </div>
          <div class="foot-contact-row">
            <svg width="13" height="13" viewBox="0 0 14 14" fill="none"><path d="M12 9.33l-2.08-.25a1 1 0 00-.82.28L7.63 10.8c-1.93-1-3.44-2.5-4.44-4.44l1.45-1.47c.22-.22.32-.53.27-.83L4.67 2A1 1 0 003.68 1h-1.6C1.48 1 1 1.48 1 2.08 1 7.98 6.02 13 11.92 13c.6 0 1.08-.48 1.08-1.08V10.3a1 1 0 00-.99-.97z" stroke="currentColor" stroke-width="1" fill="none"/></svg>
            <a href={`tel:${phone.replace(/\D/g,'')}`}>{phone}</a>
          </div>
          <div class="foot-contact-row">
            <svg width="13" height="13" viewBox="0 0 14 14" fill="none"><rect x="1" y="3" width="12" height="8" rx="1.5" stroke="currentColor" stroke-width="1"/><path d="M1 4l6 4.5L13 4" stroke="currentColor" stroke-width="1" stroke-linecap="round"/></svg>
            <a href={`mailto:${email}`}>{email}</a>
          </div>
          <div class="foot-contact-row">
            <svg width="13" height="13" viewBox="0 0 14 14" fill="none"><circle cx="7" cy="7" r="5.5" stroke="currentColor" stroke-width="1"/><path d="M7 4v4l2 1.5" stroke="currentColor" stroke-width="1" stroke-linecap="round"/></svg>
            <span>Mon–Fri 9am–6pm ET</span>
          </div>
        </div>
      </div>

      <div>
        <div class="foot-col-title">Company</div>
        <div class="foot-col-links">
          <span onclick="openSheet('about')">About Us</span>
          <span onclick="openSheet('privacy')">Privacy Policy</span>
          <span onclick="openSheet('terms')">Terms of Use</span>
          <a href="/sitemap.xml">Sitemap</a>
          <span onclick="openSheet('accessibility')">Accessibility</span>
        </div>
      </div>

      <div>
        <div class="foot-col-title">Consumer Rights</div>
        <div class="foot-col-links">
          <span onclick="openSheet('ccpa')">Do Not Sell My Info</span>
          <span onclick="openSheet('unsub')">Unsubscribe</span>
          <span onclick="openStateModal()">State Availability</span>
          <span onclick="openSheet('rates')">Rates &amp; Fees</span>
          <span onclick="openSheet('cfpb')">CFPB Resources</span>
          <a href="https://www.nfcc.org" target="_blank" rel="noopener">Credit Counseling</a>
        </div>
      </div>

      <div>
        <div class="foot-col-title">Support</div>
        <div class="foot-col-links">
          <span onclick="openSheet('contact')">Contact Us</span>
          <span onclick="openSheet('rates')">How It Works</span>
          <span onclick="openSheet('faq')">FAQ</span>
          <span onclick="openSheet('privacy')">Data Request</span>
          <a href={`mailto:legal@${domain}`}>Legal Notices</a>
          <a href={`mailto:compliance@${domain}`}>Compliance</a>
        </div>
      </div>
    </div>

    <div class="comply">
      <div class="comply-block">
        <b>NOT A LENDER:</b> {brand} is not a lender, broker, or agent for any lender or broker. We are a free loan-matching service that connects consumers with licensed third-party lenders. We are not involved in any lending decision, loan agreement, or fee determination. All credit decisions are made solely by lenders in our network.
      </div>
      <div class="comply-block">
        <b>APR &amp; REPRESENTATIVE LOAN DISCLOSURE:</b> Annual Percentage Rates (APR) offered by lenders in our network range from <b>{aprMin}% to {aprMax}%</b>. Loan amounts range from <b>{amountMin} to {amountMax}</b> with repayment terms of <b>6 to 60 months</b>. Actual APR, loan amount, and term are determined solely by the lender based on your creditworthiness, income, state of residence, and other factors. <b>Representative Example:</b> A $2,500 installment loan with a 36-month term at an APR of 24.00% results in 36 monthly payments of $98.62, for a total repayment of $3,550.32 (including $1,050.32 in interest). Not all applicants will qualify. Late or missed payments may result in additional fees and collection activity.
      </div>
      <div class="comply-block">
        <b>NO HIDDEN FEES:</b> {brand} does not charge consumers any fee. Any origination fees, late fees, or other charges are set and disclosed by individual lenders before you accept any offer.
      </div>
      <div class="comply-block">
        <b>STATE NOTICE:</b> This is an advertisement. Service may not be available in all states. Unavailable in: NY, WV, VT, SD, CT, MA. Limited availability in: CO, MT, NH, AR. By using this site you agree to our <a href="#" onclick="event.preventDefault();openSheet('terms')">Terms of Use</a> and <a href="#" onclick="event.preventDefault();openSheet('privacy')">Privacy Policy</a>. Consent to contact is not a condition of service.
      </div>
      <div class="comply-block">
        <b>CREDIT REPORTING:</b> Checking your rate does not constitute a hard credit inquiry and will not affect your credit score. Lenders may perform a hard pull when you formally accept a loan offer.
      </div>
      <div class="comply-block">
        <b>FINANCIAL HARDSHIP RESOURCES:</b> If you are experiencing financial difficulty, free resources are available. Visit <a href="https://www.consumerfinance.gov" target="_blank" rel="noopener">consumerfinance.gov</a> (CFPB) or contact the National Foundation for Credit Counseling at <a href="https://www.nfcc.org" target="_blank" rel="noopener">nfcc.org</a> or call <a href="tel:18002514440">1-800-251-4440</a>.
      </div>
    </div>

    <div class="foot-bottom-bar">
      <p style="font-size:11.5px;color:rgba(255,255,255,.2)">
        &copy; 2026 {brand} &nbsp;·&nbsp; Operated by Morning Uplift Marketing Co. &nbsp;·&nbsp; {address} &nbsp;·&nbsp; All rights reserved.
      </p>
      <div class="foot-bottom-links">
        <span onclick="openSheet('privacy')">Privacy</span>
        <span onclick="openSheet('terms')">Terms</span>
        <span onclick="openSheet('ccpa')">Do Not Sell</span>
        <span onclick="openSheet('rates')">Rates</span>
        <a href="/sitemap.xml">Sitemap</a>
      </div>
    </div>
  </div>
</footer>

<!-- MAIN LP SCRIPT -->
<script data-cfasync="false">
(function(){
"use strict";

!function(){
  var p = new URLSearchParams(location.search);
  var g = p.get('gclid') || p.get('wbraid') || p.get('gbraid') || '';
  var v = p.get('voluum_cid') || '';
  if(g) document.cookie = 'gclid=' + encodeURIComponent(g) + ';path=/;max-age=2592000;SameSite=Lax';
  if(v) document.cookie = 'voluum_cid=' + encodeURIComponent(v) + ';path=/;max-age=86400;SameSite=Lax';
}();

function getCookie(n){
  var m = document.cookie.match('(?:^|; )' + n + '=([^;]*)');
  return m ? decodeURIComponent(m[1]) : '';
}

var amountInput = document.getElementById('loan-amount');
var amountGrid  = document.getElementById('amount-grid');
if(amountGrid && amountInput){
  amountGrid.addEventListener('click', function(e){
    var btn = e.target.closest('.amt-btn');
    if(!btn) return;
    this.querySelectorAll('.amt-btn').forEach(function(b){ b.classList.remove('active'); });
    btn.classList.add('active');
    amountInput.value = btn.dataset.v;
  });
}

function validZip(v){ return /^\d{5}$/.test(v); }
function showErr(id, msg){
  var el = document.getElementById(id);
  if(!el) return;
  el.textContent = msg; el.classList.add('show');
}
function clearErr(id){
  var el = document.getElementById(id);
  if(!el) return;
  el.textContent = ''; el.classList.remove('show');
}

var zipEl = document.getElementById('zip');
if(zipEl){
  zipEl.addEventListener('input', function(){
    this.value = this.value.replace(/\D/g, '').slice(0, 5);
    if(this.value.length === 5){ clearErr('err-zip'); this.classList.remove('err'); }
  });
}

var heroForm = document.getElementById('hero-form');
if(heroForm){
  heroForm.addEventListener('submit', function(e){
    e.preventDefault();
    var a = amountInput ? amountInput.value : '';
    var z = zipEl ? zipEl.value.trim() : '';
    var ok = true;
    if(!a){ showErr('err-amount', 'Please select a loan amount.'); ok = false; }
    else clearErr('err-amount');
    if(!validZip(z)){
      showErr('err-zip', 'Please enter a valid 5-digit ZIP code.');
      if(zipEl) zipEl.classList.add('err'); ok = false;
    } else { clearErr('err-zip'); if(zipEl) zipEl.classList.remove('err'); }
    if(!ok) return;
    var btn = document.getElementById('hero-cta');
    if(btn) btn.classList.add('loading');
    var dest = '/apply?' + new URLSearchParams({
      amount:     a,
      zip:        z,
      gclid:      getCookie('gclid') || '',
      voluum_cid: getCookie('voluum_cid') || '',
      tcpa_ts:    getCookie('bf_tcpa_consent') || ''
    });
    setTimeout(function(){ location.href = dest; }, 750);
  });
}

document.querySelectorAll('a[href^="#"]').forEach(function(a){
  a.addEventListener('click', function(e){
    var t = document.querySelector(this.getAttribute('href'));
    if(t){ e.preventDefault(); t.scrollIntoView({behavior:'smooth', block:'start'}); }
  });
});

})();
</script>

<!-- COOKIE BANNER -->
<div id="cookie-banner" role="dialog" aria-label="Cookie consent">
  <div class="cookie-inner">
    <p class="cookie-text"><b>We use cookies</b> to operate our matching service and — with your consent — share attribution data with advertising partners (Google Ads). See our <a href="/privacy-policy">Privacy Policy</a> and <a href="#" onclick="openCookieModal();return false;">manage preferences</a>.</p>
    <div class="cookie-actions">
      <button class="btn-ck-accept" onclick="acceptAll()">Accept All</button>
      <button class="btn-ck-manage" onclick="openCookieModal()">Manage</button>
      <button class="btn-ck-decline" onclick="declineOptional()">Decline optional</button>
    </div>
  </div>
</div>

<!-- COOKIE MANAGE MODAL -->
<div class="ck-modal-bg" id="ck-modal-bg" role="dialog" aria-modal="true" aria-label="Cookie preferences" onclick="if(event.target===this)closeCookieModal()">
  <div class="ck-modal">
    <div class="ck-modal-title">Cookie Preferences</div>
    <p class="ck-modal-sub">Control which cookies we set. Required cookies cannot be disabled.</p>
    <div class="ck-row">
      <div><div class="ck-name">Required</div><div class="ck-desc">Session management, fraud prevention, and TCPA consent logging. Always active.</div></div>
      <label class="ck-toggle"><input type="checkbox" checked disabled><div class="ck-track"></div><div class="ck-thumb"></div></label>
    </div>
    <div class="ck-row">
      <div><div class="ck-name">Analytics</div><div class="ck-desc">Google Analytics — helps us understand site usage. No personally identifiable data.</div></div>
      <label class="ck-toggle"><input type="checkbox" id="pref-analytics" checked><div class="ck-track"></div><div class="ck-thumb"></div></label>
    </div>
    <div class="ck-row">
      <div><div class="ck-name">Advertising</div><div class="ck-desc">Google Ads conversion tracking and GCLID attribution for lender matching.</div></div>
      <label class="ck-toggle"><input type="checkbox" id="pref-ads" checked><div class="ck-track"></div><div class="ck-thumb"></div></label>
    </div>
    <div class="ck-row">
      <div><div class="ck-name">Functional</div><div class="ck-desc">Remembers your selected loan amount and ZIP during this session.</div></div>
      <label class="ck-toggle"><input type="checkbox" id="pref-functional" checked><div class="ck-track"></div><div class="ck-thumb"></div></label>
    </div>
    <button class="btn-save-prefs" onclick="savePrefs()">Save My Preferences</button>
  </div>
</div>

<!-- STATE AVAILABILITY MODAL -->
<div id="state-modal-bg" role="dialog" aria-modal="true" aria-label="State availability" onclick="if(event.target===this)closeStateModal()">
  <div class="state-card">
    <div class="state-card-hd">
      <div class="state-card-title">State Availability</div>
      <button class="state-close-btn" onclick="closeStateModal()" aria-label="Close">
        <svg viewBox="0 0 12 12" fill="none" width="11" height="11"><path d="M2 2l8 8M10 2l-8 8" stroke="#374151" stroke-width="1.5" stroke-linecap="round"/></svg>
      </button>
    </div>
    <p class="state-sub">Check if our lender network operates in your state, or enter your ZIP for a quick check.</p>
    <div class="zip-row-check">
      <input type="text" id="state-zip" maxlength="5" inputmode="numeric" placeholder="Enter ZIP code" oninput="this.value=this.value.replace(/\D/g,'')">
      <button class="btn-zip-go" onclick="checkZip()">Check ZIP</button>
    </div>
    <div id="zip-avail" aria-live="polite"></div>
    <div class="sg-label">Not Available</div>
    <div class="sc-grid">
      <div class="sc red">New York</div><div class="sc red">West Virginia</div><div class="sc red">Vermont</div>
      <div class="sc red">South Dakota</div><div class="sc red">Connecticut</div><div class="sc red">Massachusetts</div>
    </div>
    <div class="sg-label" style="margin-top:8px">Limited Availability</div>
    <div class="sc-grid">
      <div class="sc amber">Colorado</div><div class="sc amber">Montana</div>
      <div class="sc amber">New Hampshire</div><div class="sc amber">Arkansas</div>
    </div>
    <div class="state-note">Limited availability means fewer lenders may participate due to local rate caps or licensing requirements. Maximum amounts and APRs may differ. This list is updated periodically.</div>
    <button class="btn-state-done" onclick="closeStateModal()">Got It</button>
  </div>
</div>

<!-- P0 COMPLIANCE JS -->
<script data-cfasync="false">
(function(){
"use strict";
function setCk(n,v,d){var x=new Date();x.setTime(x.getTime()+(d*864e5));document.cookie=n+'='+encodeURIComponent(v)+';expires='+x.toUTCString()+';path=/;SameSite=Lax';}
function getCk(n){var m=document.cookie.match('(?:^|; )'+n+'=([^;]*)');return m?decodeURIComponent(m[1]):'';}
function hideBanner(){var b=document.getElementById('cookie-banner');if(b)b.classList.add('hide');}
function updateGtag(ads,anal){if(typeof gtag==='function'){gtag('consent','update',{ad_storage:ads?'granted':'denied',analytics_storage:anal?'granted':'denied'});}}
function initConsent(){
  window.dataLayer=window.dataLayer||[];
  if(!window.gtag){window.gtag=function(){dataLayer.push(arguments);};}
  if(!getCk('bf_consent')){
    gtag('consent','default',{ad_storage:'denied',analytics_storage:'denied',wait_for_update:500});
  } else {
    var ads=getCk('bf_ads')==='1', anal=getCk('bf_anal')==='1';
    updateGtag(ads,anal);
    hideBanner();
  }
}
window.acceptAll=function(){setCk('bf_consent','all',365);setCk('bf_ads','1',365);setCk('bf_anal','1',365);updateGtag(true,true);hideBanner();closeCookieModal();};
window.declineOptional=function(){setCk('bf_consent','req',365);setCk('bf_ads','0',365);setCk('bf_anal','0',365);updateGtag(false,false);hideBanner();closeCookieModal();};
window.savePrefs=function(){var ads=document.getElementById('pref-ads').checked,anal=document.getElementById('pref-analytics').checked;setCk('bf_consent','custom',365);setCk('bf_ads',ads?'1':'0',365);setCk('bf_anal',anal?'1':'0',365);updateGtag(ads,anal);hideBanner();closeCookieModal();};
window.openCookieModal=function(){document.getElementById('ck-modal-bg').classList.add('open');};
window.closeCookieModal=function(){document.getElementById('ck-modal-bg').classList.remove('open');};
window.openStateModal=function(){document.getElementById('state-modal-bg').classList.add('open');};
window.closeStateModal=function(){document.getElementById('state-modal-bg').classList.remove('open');document.getElementById('zip-avail').innerHTML='';document.getElementById('state-zip').value='';};

var form=document.getElementById('hero-form');
var tcpa=document.getElementById('tcpa-check');
if(form&&tcpa){
  form.addEventListener('submit',function(e){
    if(!tcpa.checked){
      e.preventDefault();e.stopImmediatePropagation();
      document.getElementById('tcpa-err').classList.add('show');
      tcpa.closest('.tcpa-wrap').scrollIntoView({behavior:'smooth',block:'center'});
      return;
    }
    document.getElementById('tcpa-err').classList.remove('show');
    var ts=new Date().toISOString();
    setCk('bf_tcpa',ts,365);
    var h=document.createElement('input');h.type='hidden';h.name='tcpa_consent_ts';h.value=ts;form.appendChild(h);
  },true);
  tcpa.addEventListener('change',function(){if(this.checked)document.getElementById('tcpa-err').classList.remove('show');});
}

