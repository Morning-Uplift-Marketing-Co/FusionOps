window.checkZip=function(){
  var zip=document.getElementById('state-zip').value.trim();
  var el=document.getElementById('zip-avail');
  if(!/^\d{5}$/.test(zip)){el.innerHTML='<span style="color:#EF4444;font-size:12px">Enter a valid 5-digit ZIP.</span>';return;}
  var p=parseInt(zip.slice(0,3),10),found=null,st=null;
  for(var s in unavail){unavail[s].forEach(function(r){if(p>=r[0]&&p<=r[1]){found='no';st=s;}});}
  if(!found){for(var s in limited){limited[s].forEach(function(r){if(p>=r[0]&&p<=r[1]){found='ltd';st=s;}});}}
  if(found==='no')el.innerHTML='<span class="zip-no">Not available in '+st+'. We cannot match you with lenders in this state.</span>';
  else if(found==='ltd')el.innerHTML='<span class="zip-warn">Limited availability in '+st+'. Fewer lenders, lower maximums may apply.</span>';
  else el.innerHTML='<span class="zip-ok">Great — our service is available in your area.</span>';
};

