---
const categories = [
  {
    title: "Veterinary Care",
    icon: "M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z",
    items: [
      "Emergency vet visits",
      "Surgeries and procedures",
      "Diagnostic tests and X-rays",
      "Medications and treatments",
      "Dental procedures",
      "Specialist consultations"
    ]
  },
  {
    title: "Preventive Care",
    icon: "M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z",
    items: [
      "Annual check-ups",
      "Vaccinations",
      "Spay/neuter procedures",
      "Microchipping",
      "Wellness exams",
      "Flea and tick prevention"
    ]
  },
  {
    title: "Grooming & Boarding",
    icon: "M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z",
    items: [
      "Professional grooming",
      "Boarding services",
      "Daycare facilities",
      "Pet sitting",
      "Bathing and styling",
      "Nail trimming"
    ]
  },
  {
    title: "Training & Behavior",
    icon: "M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253",
    items: [
      "Obedience training",
      "Behavioral consultations",
      "Puppy/kitten classes",
      "Agility training",
      "Service animal training",
      "Private sessions"
    ]
  },
  {
    title: "Pet Supplies",
    icon: "M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z",
    items: [
      "Pet food and treats",
      "Beds and crates",
      "Toys and enrichment",
      "Leashes and collars",
      "Litter and accessories",
      "Feeding supplies"
    ]
  },
  {
    title: "Specialty Services",
    icon: "M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z",
    items: [
      "Pet insurance premiums",
      "Adoption fees",
      "Pet photography",
      "End-of-life care",
      "Pet transport",
      "Specialized equipment"
    ]
  }
];
---

<section class="py-20 bg-gradient-to-br from-gray-50 to-blue-50">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <div class="inline-block bg-gradient-to-r from-blue-100 to-purple-100 text-blue-700 font-bold text-xs uppercase tracking-wider px-4 py-2 rounded-full mb-4">
        Eligible Expenses
      </div>
      <h2 class="text-4xl md:text-5xl font-bold bg-gradient-to-r from-slate-900 to-slate-700 bg-clip-text text-transparent mb-4">
        What Can You Finance?
      </h2>
      <p class="text-xl text-gray-600 max-w-2xl mx-auto">
        TPL-USA-B02 covers a wide range of pet care expenses so you can focus on what matters most
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-7xl mx-auto">
      {categories.map((category) => (
        <div class="group bg-white rounded-2xl shadow-lg p-8 hover:shadow-2xl transition-all border border-gray-100 hover:border-blue-200 hover:-translate-y-1">
          <div class="flex items-center mb-6">
            <div class="w-14 h-14 bg-gradient-to-br from-blue-500 to-purple-600 rounded-xl flex items-center justify-center mr-4 shadow-lg group-hover:shadow-xl transition-shadow">
              <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={category.icon} />
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-gray-900 group-hover:text-blue-600 transition-colors">
              {category.title}
            </h3>
          </div>
          <ul class="space-y-3">
            {category.items.map((item) => (
              <li class="flex items-start">
                <svg class="w-5 h-5 text-blue-500 mr-3 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                </svg>
                <span class="text-gray-700">{item}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-16 max-w-4xl mx-auto">
      <div class="bg-gradient-to-br from-orange-50 to-orange-100 rounded-2xl shadow-xl p-8 border border-orange-200">
        <div class="flex items-start">
          <svg class="w-10 h-10 text-orange-500 mr-4 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
          </svg>
          <div>
            <h4 class="text-2xl font-bold text-gray-900 mb-3">
              Not Sure If Your Expense Qualifies?
            </h4>
            <p class="text-gray-700 mb-6 text-lg">
              If it's related to your pet's health, happiness, or well-being, chances are we can help finance it. Our team is here to answer any questions about eligible expenses.
            </p>
            <a
              href="/apply.html"
              class="inline-flex items-center space-x-2 bg-gradient-to-r from-orange-500 to-orange-600 text-white px-8 py-4 rounded-xl font-bold hover:from-orange-600 hover:to-orange-700 transition-all shadow-lg hover:shadow-xl hover:scale-105"
            >
              <span>Apply Now</span>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
