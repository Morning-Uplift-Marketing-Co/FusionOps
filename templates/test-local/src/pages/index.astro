---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header';
import HeroWithModal from '../components/HeroWithModal';
import HowItWorks from '../components/HowItWorks.astro';
import Features from '../components/Features';
import APRComparison from '../components/APRComparison.astro';
import EligibleExpenses from '../components/EligibleExpenses.astro';
import Testimonials from '../components/Testimonials';
import FAQ from '../components/FAQ';
import FooterWithModals from '../components/FooterWithModals';

// Environment variables
const brand          = import.meta.env.PUBLIC_BRAND          || 'TPL-USA-B02';
const h1             = import.meta.env.PUBLIC_H1             || 'Get Up to $5,000 Today';
const cta            = import.meta.env.PUBLIC_CTA            || 'Apply Now';
const phone          = import.meta.env.PUBLIC_PHONE          || '';
const amountMin      = import.meta.env.PUBLIC_AMOUNTMIN      || '100';
const amountMax      = import.meta.env.PUBLIC_AMOUNTMAX      || '5000';
const accentColor    = import.meta.env.PUBLIC_ACCENTCOLOR    || '#f97316';
---

<Layout>
  <Header client:load brand={brand} phone={phone} />
  <HeroWithModal client:load 
    h1={h1}
    cta={cta}
    amountMin={amountMin}
    amountMax={amountMax}
  />
  <HowItWorks />
  <Features client:visible accentColor={accentColor} amountMin={amountMin} amountMax={amountMax} />
  <APRComparison />
  <EligibleExpenses />
  <Testimonials client:visible />
  <FAQ client:visible />
  <FooterWithModals client:load />
</Layout>
