---
const aid = import.meta.env.PUBLIC_AID || '';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Apply</title>
  <link rel="dns-prefetch" href="//apikeep.com" />
</head>
<body>

<script is:inline data-cfasync="false" define:vars={{ aid }}>
window.dataLayer = window.dataLayer || [];

var SafeStorage = {
  _mem: {},
  set: function(k, v) { try { sessionStorage.setItem(k, v); } catch(e) { this._mem[k] = v; } },
  get: function(k) { try { return sessionStorage.getItem(k); } catch(e) { return this._mem[k] || null; } }
};

// First-party pixel for apply page (no Layout here)
var PX_DOMAIN = window.location.hostname;
function fpPixel(evt, extra) {
  try {
    var q = Object.assign({ e: evt, d: PX_DOMAIN, ts: Date.now() }, extra || {});
    var img = new Image(1,1);
    img.src = 'https://t.' + PX_DOMAIN + '/e?' + new URLSearchParams(q).toString();
  } catch(_) {}
}

function getVoluumClickId() {
  var p = new URLSearchParams(window.location.search);
  return p.get('vlcid') || p.get('clickid') || p.get('cid') || p.get('click_id') || p.get('cpid')
    || SafeStorage.get('voluum_cpid') || SafeStorage.get('voluum_cid') || '';
}

// Page view
fpPixel('pv', { click_id: getVoluumClickId() });

var _lg_form_init_ = {
  aid: aid,
  template: "fresh",
  ref: window.location.hostname,
  click_id: getVoluumClickId(),

  hooks: {
    onFormLoad: function() {
      fpPixel('lg_form_load', { click_id: getVoluumClickId() });
      window.dataLayer.push({ event: 'lg_form_load', clickId: getVoluumClickId() });
    },
    onStepChange: function(data) {
      fpPixel('lg_step', { step: data && data.step, click_id: getVoluumClickId() });
      window.dataLayer.push({ event: 'lg_step', step: data && data.step, clickId: getVoluumClickId() });
    },
    onSubmit: function() {
      fpPixel('lg_submit', { click_id: getVoluumClickId() });
      window.dataLayer.push({ event: 'lg_submit', clickId: getVoluumClickId() });
    },
    onLeadSold: function(data) {
      fpPixel('lg_success', { lead_id: data && data.leadId, payout: data && data.price, click_id: getVoluumClickId() });
      window.dataLayer.push({ event: 'lg_success', leadId: data && data.leadId, payout: data && data.price, clickId: getVoluumClickId() });
    },
    onLeadRejected: function(data) {
      fpPixel('lg_finished', { lead_id: data && data.leadId, payout: data && data.price, click_id: getVoluumClickId() });
      window.dataLayer.push({ event: 'lg_declined', leadId: data && data.leadId, payout: data && data.price, clickId: getVoluumClickId() });
    },
    onLeadFinished: function(data) {
      fpPixel('lg_finished', { lead_id: data && data.leadId, payout: data && data.price, click_id: getVoluumClickId() });
      window.dataLayer.push({ event: 'lg_finished', leadId: data && data.leadId, payout: data && data.price, clickId: getVoluumClickId() });
    }
  }
};

// MutationObserver fallback — LeadsGate sometimes fires onFormLoad before callback registers
(function() {
  var fired = false;
  var observer = new MutationObserver(function() {
    var form = document.getElementById('_lg_form_');
    if (form && form.children.length > 0 && !fired) {
      fired = true;
      observer.disconnect();
      if (window._lg_form_init_ && window._lg_form_init_.hooks && typeof window._lg_form_init_.hooks.onFormLoad === 'function') {
        window._lg_form_init_.hooks.onFormLoad();
      }
    }
  });
  observer.observe(document.body, { childList: true, subtree: true });
  setTimeout(function() { if (!fired) { fired = true; observer.disconnect(); fpPixel('lg_form_load_timeout'); } }, 10000);
})();

var lgScript = document.createElement('script');
lgScript.type = 'text/javascript';
lgScript.async = true;
lgScript.setAttribute('data-cfasync', 'false');
lgScript.src = 'https://apikeep.com/form/applicationInit.js';
document.head.appendChild(lgScript);
</script>

<div id="_lg_form_"></div>
</body>
</html>
