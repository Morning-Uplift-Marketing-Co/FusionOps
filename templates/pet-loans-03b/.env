PUBLIC_REVIEWS=[{"name":"Maria G.","location":"Austin, TX","rating":5,"text":"When my cat was diagnosed with diabetes, PawCare Plus approved me instantly for a 0% plan. The monthly payments are affordable and I didn't have to delay her treatment. Best decision ever.","amount":"$2,400","purpose":"Diabetes treatment"},{"name":"James P.","location":"Seattle, WA","rating":5,"text":"My rescue dog needed hip surgery urgently. PawCare Plus gave me three plan options in under a minute. The transparency was incredible — I knew exactly what I'd pay before signing anything.","amount":"$4,200","purpose":"Hip surgery"},{"name":"Rebecca L.","location":"Miami, FL","rating":5,"text":"I was worried about my credit affecting approval, but PawCare Plus only did a soft check. Got approved for $3,000 with a low APR. Now my golden retriever is recovering beautifully from his ACL repair.","amount":"$3,000","purpose":"ACL surgery"}]