---
const comparisons = [
  {
    creditScore: "Excellent (720+)",
    bearLoanAPR: "0% - 9.99%",
    creditCardAPR: "15.99% - 24.99%",
    savings: "Up to $500",
    loanAmount: "$5,000 over 12 months"
  },
  {
    creditScore: "Good (680-719)",
    bearLoanAPR: "10% - 19.99%",
    creditCardAPR: "18.99% - 27.99%",
    savings: "Up to $400",
    loanAmount: "$5,000 over 12 months"
  },
  {
    creditScore: "Fair (640-679)",
    bearLoanAPR: "20% - 29.99%",
    creditCardAPR: "24.99% - 29.99%",
    savings: "Up to $200",
    loanAmount: "$5,000 over 12 months"
  },
  {
    creditScore: "Building (600-639)",
    bearLoanAPR: "30% - 35.99%",
    creditCardAPR: "29.99%+",
    savings: "Competitive rates",
    loanAmount: "$5,000 over 12 months"
  }
];
---

<section class="py-20 bg-white">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <div class="inline-block bg-gradient-to-r from-blue-100 to-purple-100 text-blue-700 font-bold text-xs uppercase tracking-wider px-4 py-2 rounded-full mb-4">
        Save Money
      </div>
      <h2 class="text-4xl md:text-5xl font-bold bg-gradient-to-r from-slate-900 to-slate-700 bg-clip-text text-transparent mb-4">
        Better Rates Than Credit Cards
      </h2>
      <p class="text-xl text-gray-600 max-w-2xl mx-auto">
        See how much you could save with TPL-USA-B02 compared to typical credit card rates
      </p>
    </div>

    {/* Comparison Table */}
    <div class="max-w-6xl mx-auto overflow-x-auto">
      <table class="w-full bg-white rounded-2xl shadow-xl overflow-hidden border border-gray-200">
        <thead class="bg-gradient-to-r from-blue-600 to-purple-600 text-white">
          <tr>
            <th class="px-6 py-5 text-left font-bold">Credit Score Range</th>
            <th class="px-6 py-5 text-left font-bold">TPL-USA-B02 APR</th>
            <th class="px-6 py-5 text-left font-bold">Typical Credit Card APR</th>
            <th class="px-6 py-5 text-left font-bold">Potential Savings</th>
          </tr>
        </thead>
        <tbody>
          {comparisons.map((row, index) => (
            <tr class={index % 2 === 0 ? 'bg-blue-50/30' : 'bg-white'}>
              <td class="px-6 py-4 border-b border-gray-100">
                <div class="font-bold text-gray-900">{row.creditScore}</div>
                <div class="text-sm text-gray-600">{row.loanAmount}</div>
              </td>
              <td class="px-6 py-4 border-b border-gray-100">
                <div class="text-blue-600 font-bold text-lg">{row.bearLoanAPR}</div>
              </td>
              <td class="px-6 py-4 border-b border-gray-100">
                <div class="text-gray-700 font-semibold">{row.creditCardAPR}</div>
              </td>
              <td class="px-6 py-4 border-b border-gray-100">
                <div class="text-orange-600 font-bold">{row.savings}</div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    {/* Disclaimer */}
    <div class="mt-8 max-w-4xl mx-auto">
      <div class="bg-orange-50 border-l-4 border-orange-400 p-6 rounded-r-xl">
        <p class="text-sm text-gray-700 leading-relaxed">
          <strong>Note:</strong> APR ranges are estimates based on typical credit profiles. Your actual rate will be determined based on your creditworthiness, income, loan amount, and term selected. Savings calculations assume typical credit card APRs and do not include potential credit card rewards or benefits. All rates and savings are illustrative examples.
        </p>
      </div>
    </div>

    {/* CTA */}
    <div class="mt-12 text-center">
      <a
        href="/apply.html"
        class="inline-flex items-center space-x-2 bg-gradient-to-r from-orange-500 to-orange-600 text-white px-10 py-4 rounded-xl font-bold text-lg hover:from-orange-600 hover:to-orange-700 transition-all shadow-xl hover:shadow-2xl hover:scale-105"
      >
        <span>Check Your Rate Now</span>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
      </a>
      <p class="text-gray-600 mt-4 flex items-center justify-center space-x-2">
        <svg class="w-4 h-4 text-green-500" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
        </svg>
        <span>Won't affect your credit score</span>
      </p>
    </div>
  </div>
</section>
