---
const reviews = [
  {
    name: 'Sarah M.',
    location: 'Austin, TX',
    amount: '$18,000',
    purpose: 'Debt Consolidation',
    rating: 5,
    quote: "I consolidated three high-interest cards into one clean payment. The rate was better than I expected, and the whole process took less than a day.",
    avatar: 'SM',
    color: 'hsl(14 85% 62%)',
  },
  {
    name: 'James R.',
    location: 'Chicago, IL',
    amount: '$8,500',
    purpose: 'Home Improvement',
    rating: 5,
    quote: "Finally renovated my kitchen. The funds hit my account the morning after I signed. No runaround, no confusing paperwork. Exceptional service.",
    avatar: 'JR',
    color: 'hsl(174 72% 45%)',
  },
  {
    name: 'Priya N.',
    location: 'San Jose, CA',
    amount: '$25,000',
    purpose: 'Medical Bills',
    rating: 5,
    quote: "Faced a $25K surgery bill and was terrified. GoldRush approved me within hours, fixed rate, manageable payments. Genuinely life-changing.",
    avatar: 'PN',
    color: 'hsl(142 60% 55%)',
  },
  {
    name: 'Marcus T.',
    location: 'Atlanta, GA',
    amount: '$5,000',
    purpose: 'Emergency Fund',
    rating: 5,
    quote: "The soft credit check meant I could compare options without damaging my score. Transparent from start to finish — rare in this industry.",
    avatar: 'MT',
    color: 'hsl(14 85% 62%)',
  },
  {
    name: 'Linda K.',
    location: 'Denver, CO',
    amount: '$12,000',
    purpose: 'Car Repair',
    rating: 5,
    quote: "My car broke down and I needed cash fast. Applied at 9pm, approved by midnight, money in my account the next morning. Absolutely incredible.",
    avatar: 'LK',
    color: 'hsl(174 72% 45%)',
  },
  {
    name: 'David L.',
    location: 'Seattle, WA',
    amount: '$30,000',
    purpose: 'Business Startup',
    rating: 5,
    quote: "Used the loan to fund my first six months of inventory. The fixed payments made forecasting easy. I'm now profitable and already paid it off early.",
    avatar: 'DL',
    color: 'hsl(142 60% 55%)',
  },
];

const stats = [
  { val: '4.8', unit: '/ 5.0', label: 'Average rating across 12,400+ reviews' },
  { val: '96%', unit: '', label: 'Customers would recommend us' },
  { val: '24h', unit: '', label: 'Average time from approval to funding' },
];
---

<section id="testimonials" class="py-20 md:py-28 px-6 overflow-hidden">
  <div class="max-w-6xl mx-auto">

    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-14">
      <div>
        <span class="section-label">Customer Stories</span>
        <h2 class="section-title mb-2">Real People. Real Results.</h2>
        <p class="text-foreground/50 text-base max-w-md">Over 50,000 borrowers have trusted us with their financial goals.</p>
      </div>

      <!-- Aggregate rating -->
      <div class="glass-card px-6 py-4 flex items-center gap-4 flex-shrink-0">
        <div class="text-center">
          <div class="font-display font-bold text-3xl text-foreground mono-num">4.8</div>
          <div class="flex gap-0.5 justify-center mt-1">
            {[1,2,3,4,5].map(() => (
              <svg width="12" height="12" viewBox="0 0 24 24" fill="hsl(14 85% 62%)" stroke="none">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
              </svg>
            ))}
          </div>
        </div>
        <div class="h-10 w-px bg-border"></div>
        <div>
          <div class="text-foreground/70 text-sm font-semibold">12,400+ reviews</div>
          <div class="text-foreground/35 text-xs mt-0.5">Verified customers</div>
        </div>
      </div>
    </div>

    <!-- Review cards -->
    <div class="grid md:grid-cols-3 gap-4 mb-10">
      {reviews.map(r => (
        <div class="premium-card p-6 flex flex-col gap-5 reveal hover:-translate-y-0.5 transition-transform duration-200">
          <!-- Stars -->
          <div class="flex gap-0.5">
            {Array(r.rating).fill(0).map(() => (
              <svg width="14" height="14" viewBox="0 0 24 24" fill="hsl(14 85% 62%)" stroke="none">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
              </svg>
            ))}
          </div>

          <!-- Quote -->
          <blockquote class="text-foreground/65 text-sm leading-relaxed flex-1">
            &ldquo;{r.quote}&rdquo;
          </blockquote>

          <!-- Author row -->
          <div class="flex items-center justify-between border-t border-border pt-4">
            <div class="flex items-center gap-3">
              <div class="w-9 h-9 rounded-xl flex items-center justify-center text-xs font-bold flex-shrink-0"
                style={`background: ${r.color}18; color: ${r.color};`}>
                {r.avatar}
              </div>
              <div>
                <div class="text-foreground/80 text-sm font-semibold">{r.name}</div>
                <div class="text-foreground/35 text-xs">{r.location}</div>
              </div>
            </div>
            <div class="text-right">
              <div class="font-mono font-bold text-sm" style={`color: ${r.color};`}>{r.amount}</div>
              <div class="text-foreground/30 text-xs">{r.purpose}</div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Stats row -->
    <div class="grid grid-cols-3 gap-4">
      {stats.map(s => (
        <div class="glass-card p-5 text-center">
          <div class="font-display font-bold text-2xl text-foreground mono-num mb-1">
            {s.val}<span class="text-base text-foreground/40">{s.unit}</span>
          </div>
          <div class="text-foreground/40 text-xs leading-relaxed">{s.label}</div>
        </div>
      ))}
    </div>
  </div>
</section>
