---
export const prerender = true;

import Layout from "../layouts/Layout.astro";

const brand = import.meta.env.PUBLIC_BRAND || "TPL-USA-L01";
const h1 = import.meta.env.PUBLIC_H1 || "Pet Care Financing From $200 to $10,000";
const sub =
  import.meta.env.PUBLIC_SUB ||
  "Compare options in minutes and see flexible repayment plans for vet bills and emergency pet care.";
const cta = import.meta.env.PUBLIC_CTA || "Check Eligibility";
const domain = import.meta.env.PUBLIC_DOMAIN || "";
const voluumClickUrl = import.meta.env.PUBLIC_VOLUUM_CLICK_URL || "";
const ctaHref = voluumClickUrl || "/apply";

const colorId = import.meta.env.PUBLIC_COLORID || "teal";
const fontId = import.meta.env.PUBLIC_FONTID || "inter";
const radius = import.meta.env.PUBLIC_RADIUS || "rounded";
const layout = import.meta.env.PUBLIC_LAYOUT || "hero-left-form-right";

const colors = {
  teal: { primary: "#0d9488", bg: "#f0fdfa", accent: "#0f766e" },
  indigo: { primary: "#4f46e5", bg: "#eef2ff", accent: "#4338ca" },
  coral: { primary: "#ea580c", bg: "#fff7ed", accent: "#c2410c" },
  slate: { primary: "#334155", bg: "#f8fafc", accent: "#1e293b" },
};
const fonts = {
  inter: "Inter, system-ui, sans-serif",
  outfit: "Outfit, Inter, system-ui, sans-serif",
  manrope: "Manrope, Inter, system-ui, sans-serif",
  sora: "Sora, Inter, system-ui, sans-serif",
};
const radiusMap = {
  sharp: "8px",
  subtle: "14px",
  rounded: "22px",
  pill: "999px",
};
const selectedColor = colors[colorId] || colors.teal;
const selectedFont = fonts[fontId] || fonts.inter;
const selectedRadius = radiusMap[radius] || radiusMap.rounded;
const isStack = layout === "hero-center-form-below";
---

<Layout title={`${brand} | ${h1}`} description={sub}>
  <main class={isStack ? "stack" : "split"}>
    <section class="hero">
      <p class="badge">Trusted matching network</p>
      <h1>{h1}</h1>
      <p class="sub">{sub}</p>
      <div class="checks">
        <span>No hidden fees</span>
        <span>Soft-check first</span>
        <span>Mobile friendly</span>
      </div>
      <a href={ctaHref} class="cta">{cta}</a>
    </section>

    <section class="card">
      <h2>Start with your ZIP code</h2>
      <form id="zip-form">
        <input id="zip" name="zip" placeholder="Enter ZIP" inputmode="numeric" maxlength="5" required />
        <button type="submit">{cta}</button>
      </form>
      <p class="note">
        Offers are subject to eligibility and provider review. Terms and availability may vary.
      </p>
    </section>
  </main>

  <footer>
    <span>© {new Date().getFullYear()} {brand}</span>
    {domain && <span class="domain">{domain}</span>}
  </footer>
</Layout>

<style is:inline define:vars={{ selectedColor, selectedFont, selectedRadius }}>
  :root {
    --fo-primary: {selectedColor.primary};
    --fo-bg: {selectedColor.bg};
    --fo-accent: {selectedColor.accent};
    --fo-font: {selectedFont};
    --fo-radius: {selectedRadius};
  }
  body { margin: 0; font-family: var(--fo-font); background: linear-gradient(180deg, var(--fo-bg), #ffffff); color: #0f172a; }
  .split, .stack { max-width: 1080px; margin: 0 auto; padding: 40px 20px; gap: 24px; display: grid; }
  .split { grid-template-columns: 1.2fr 1fr; align-items: center; }
  .stack { grid-template-columns: 1fr; }
  .hero h1 { font-size: clamp(30px, 6vw, 54px); line-height: 1.08; margin: 8px 0; }
  .sub { font-size: 18px; color: #334155; max-width: 60ch; }
  .badge { display: inline-block; background: #ffffff; border: 1px solid #cbd5e1; border-radius: 999px; padding: 6px 12px; font-size: 12px; color: #334155; }
  .checks { display: flex; flex-wrap: wrap; gap: 10px; margin: 16px 0 22px; font-size: 14px; color: #334155; }
  .checks span { background: #ffffff; border: 1px solid #e2e8f0; padding: 8px 10px; border-radius: 10px; }
  .cta { display: inline-block; text-decoration: none; background: var(--fo-primary); color: #fff; border-radius: var(--fo-radius); padding: 13px 18px; font-weight: 700; }
  .card { background: #fff; border: 1px solid #e2e8f0; border-radius: 24px; padding: 22px; box-shadow: 0 10px 25px rgba(15, 23, 42, 0.08); }
  #zip-form { display: grid; gap: 12px; margin-top: 12px; }
  input { border: 1px solid #cbd5e1; border-radius: 12px; padding: 12px; font-size: 16px; }
  button { border: 0; border-radius: var(--fo-radius); background: var(--fo-accent); color: #fff; padding: 12px; font-weight: 700; cursor: pointer; }
  .note { font-size: 12px; color: #64748b; margin-top: 12px; line-height: 1.5; }
  footer { max-width: 1080px; margin: 0 auto 30px; padding: 0 20px; color: #64748b; font-size: 12px; display: flex; justify-content: space-between; gap: 8px; flex-wrap: wrap; }
  @media (max-width: 900px) { .split { grid-template-columns: 1fr; } }
</style>

<script data-cfasync="false" is:inline define:vars={{ ctaHref }}>
  (() => {
    const form = document.getElementById("zip-form");
    const zip = document.getElementById("zip");
    if (!(form instanceof HTMLFormElement) || !(zip instanceof HTMLInputElement)) return;

    zip.addEventListener("input", () => {
      zip.value = zip.value.replace(/\D/g, "").slice(0, 5);
    });

    let formStartFired = false;
    zip.addEventListener("focus", () => {
      if (formStartFired) return;
      formStartFired = true;
      if (typeof window.__fpPixel === "function") {
        window.__fpPixel("form_start", window.__fpClickId ? { click_id: window.__fpClickId } : {});
      }
    }, { once: true });

    form.addEventListener("submit", (e) => {
      e.preventDefault();
      if (zip.value.length !== 5) return;

      if (typeof window.__fpPixel === "function") {
        window.__fpPixel("form_submit", {
          zip: zip.value,
          click_id: window.__fpClickId || "",
        });
      }

      const q = new URLSearchParams(window.location.search);
      q.set("zip", zip.value);
      const next = ctaHref && ctaHref !== "#apply"
        ? ctaHref + (ctaHref.includes("?") ? "&" : "?") + q.toString()
        : "/apply?" + q.toString();
      window.location.assign(next);
    });
  })();
</script>
