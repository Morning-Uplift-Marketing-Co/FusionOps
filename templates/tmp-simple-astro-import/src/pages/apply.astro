---
import Layout from '../layouts/Layout.astro';
const brand = import.meta.env.PUBLIC_BRAND || 'FusionOps Sample';
---
<Layout title={`Apply | ${brand}`} description="Apply page for Astro import test">
  <main style="font-family: Arial, sans-serif; padding: 48px; max-width: 760px; margin: 0 auto;">
    <section style="border: 1px solid #e2e8f0; border-radius: 24px; padding: 32px; background: #fff;">
      <h1 style="font-size: 36px; margin: 0 0 12px;">Apply with {brand}</h1>
      <p style="color: #475569; margin: 0 0 24px;">This page verifies multi-page Astro template import.</p>
      <form style="display: grid; gap: 12px;">
        <input type="text" placeholder="Full name" style="padding: 12px; border: 1px solid #cbd5e1; border-radius: 12px;" />
        <input type="email" placeholder="Email address" style="padding: 12px; border: 1px solid #cbd5e1; border-radius: 12px;" />
        <button type="submit" style="background: #0f172a; color: #fff; border: 0; padding: 14px 20px; border-radius: 999px; font-weight: 700;">Submit</button>
      </form>
    </section>
  </main>
</Layout>
