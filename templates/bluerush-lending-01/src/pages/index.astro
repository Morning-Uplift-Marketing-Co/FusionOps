---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Testimonials from '../components/Testimonials.astro';
import Calculator from '../components/Calculator.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Eligibility from '../components/Eligibility.astro';
import APRTable from '../components/APRTable.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';

const brand = import.meta.env.PUBLIC_BRAND || 'BlueRush Lending';
---

<Layout
  title={`${brand} — Premium Installment Loans Up to $35,000`}
  description="Apply for a personal installment loan in minutes. Fixed monthly payments, competitive APR, no hidden fees. Borrow $1,000–$35,000."
>
  <Hero />
  <Testimonials />
  <hr class="section-divider" />
  <Calculator />
  <hr class="section-divider" />
  <HowItWorks />
  <hr class="section-divider" />
  <Eligibility />
  <hr class="section-divider" />
  <APRTable />
  <hr class="section-divider" />
  <FAQ />
  <Footer />

  <div id="sticky-cta-bar">
    <div class="sticky-bar-inner">
      <div class="sticky-bar-text">
        <span class="sticky-bar-rate">From 5.99% APR</span>
        <span class="sticky-bar-label">Fixed-rate loans up to $5,000</span>
      </div>
      <a href="/apply" class="sticky-bar-btn">
        Check My Rate
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </div>

  <style is:inline>
    @media (max-width: 768px) {
      body { padding-bottom: 88px; }
    }

    #sticky-cta-bar {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      z-index: 100;
      transform: translateY(100%);
      transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.35s ease;
      opacity: 0;
      pointer-events: none;
    }

    #sticky-cta-bar.bar-visible {
      transform: translateY(0);
      opacity: 1;
      pointer-events: auto;
    }

    .sticky-bar-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      padding: 0.875rem 1.25rem;
      background: hsl(0 0% 100% / 0.98);
      border-top: 1px solid hsl(213 20% 88%);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
    }

    .sticky-bar-text {
      display: flex;
      flex-direction: column;
      gap: 0.1rem;
      min-width: 0;
    }

    .sticky-bar-rate {
      font-family: 'Sora', sans-serif;
      font-weight: 700;
      font-size: 0.9375rem;
      color: hsl(168 100% 30%);
      line-height: 1.2;
    }

    .sticky-bar-label {
      font-size: 0.75rem;
      color: hsl(213 70% 10% / 0.45);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .sticky-bar-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.375rem;
      flex-shrink: 0;
      padding: 0.625rem 1.25rem;
      background: linear-gradient(135deg, hsl(168 100% 40%), hsl(168 100% 30%));
      color: #fff;
      font-family: 'Sora', sans-serif;
      font-weight: 700;
      font-size: 0.875rem;
      border-radius: 0.75rem;
      text-decoration: none;
      transition: all 0.2s ease;
      box-shadow: 0 4px 16px hsl(168 100% 38% / 0.3);
      white-space: nowrap;
    }

    .sticky-bar-btn:active {
      transform: scale(0.97);
    }
  </style>

  <script is:inline>
    const io = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('visible');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.08, rootMargin: '0px 0px -32px 0px' });

    document.querySelectorAll('.reveal').forEach(el => io.observe(el));

    (function() {
      var bar = document.getElementById('sticky-cta-bar');
      function onScroll() {
        var scrolled = window.scrollY || document.documentElement.scrollTop;
        var total = document.documentElement.scrollHeight - window.innerHeight;
        var pct = total > 0 ? scrolled / total : 0;
        if (pct >= 0.5) {
          bar.classList.add('bar-visible');
        } else {
          bar.classList.remove('bar-visible');
        }
      }
      window.addEventListener('scroll', onScroll, { passive: true });
    })();
  </script>
</Layout>
