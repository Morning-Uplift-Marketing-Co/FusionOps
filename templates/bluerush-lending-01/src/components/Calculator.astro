---
const amountMin = Number(import.meta.env.PUBLIC_AMOUNTMIN || 1000);
const amountMax = Number(import.meta.env.PUBLIC_AMOUNTMAX || 5000);
const aprMin    = Number(import.meta.env.PUBLIC_APRMIN    || 5.99);
const aprMax    = Number(import.meta.env.PUBLIC_APRMAX    || 34.99);
---

<section id="calculator" class="py-20 md:py-28 px-6">
  <div class="max-w-6xl mx-auto">

    <div class="text-center mb-14">
      <span class="section-label">Loan Estimator</span>
      <h2 class="section-title">Payment Calculator</h2>
      <p class="text-base max-w-md mx-auto" style="color: hsl(213 20% 52%);">
        Slide to your desired amount and term — see your fixed monthly payment instantly.
      </p>
    </div>

    <div class="grid lg:grid-cols-[1fr_380px] gap-6 items-start">

      <!-- Controls panel -->
      <div class="premium-card p-8 flex flex-col gap-8 reveal">

        <!-- Loan Amount -->
        <div>
          <div class="flex justify-between items-end mb-4">
            <label class="text-xs font-semibold uppercase tracking-widest" style="color: hsl(213 20% 52%);">Loan Amount</label>
            <span id="amount-display" class="font-display font-bold text-2xl mono-num" style="color: hsl(213 70% 10%);">$3,000</span>
          </div>
          <input id="amount-slider" type="range"
            min={amountMin} max={amountMax} step="100" value="3000"
            class="range-slider w-full" style="--progress: 50%" />
          <div class="flex justify-between text-xs mt-2" style="color: hsl(213 20% 65%);">
            <span>${amountMin.toLocaleString()}</span>
            <span>${amountMax.toLocaleString()}</span>
          </div>
        </div>

        <!-- Term -->
        <div>
          <label class="block text-xs font-semibold uppercase tracking-widest mb-4" style="color: hsl(213 20% 52%);">Loan Term</label>
          <div class="grid grid-cols-5 gap-2" id="term-selector">
            {[12, 24, 36, 48, 60].map(t => (
              <button data-term={t} class={`term-btn py-3 rounded-xl text-sm font-bold border transition-all duration-200 ${
                t === 36
                  ? 'term-btn-active'
                  : 'term-btn-inactive'
              }`}>
                {t}<span class="text-xs font-normal opacity-70">mo</span>
              </button>
            ))}
          </div>
        </div>

        <!-- APR -->
        <div>
          <div class="flex justify-between items-end mb-4">
            <label class="text-xs font-semibold uppercase tracking-widest" style="color: hsl(213 20% 52%);">Estimated APR</label>
            <span id="apr-display" class="font-display font-bold text-2xl mono-num"
              style="color: hsl(168 100% 34%);">{aprMin}%</span>
          </div>
          <input id="apr-slider" type="range"
            min={aprMin} max={aprMax} step="0.25" value={aprMin}
            class="range-slider w-full" style="--progress: 0%" />
          <div class="flex justify-between text-xs mt-2" style="color: hsl(213 20% 65%);">
            <span>Excellent credit</span>
            <span>Fair credit</span>
          </div>
        </div>

        <p class="text-xs leading-relaxed pt-5" style="border-top: 1px solid hsl(213 20% 88%); color: hsl(213 20% 65%);">
          This calculator is for illustrative purposes only. Actual rate and payment depend on creditworthiness, income verification, and lender underwriting criteria.
        </p>
      </div>

      <!-- Result panel -->
      <div class="flex flex-col gap-4">

        <!-- Big monthly payment -->
        <div class="premium-card p-8 text-center reveal" style="border-top: 2px solid hsl(168 100% 38% / 0.4);">
          <p class="text-xs font-semibold uppercase tracking-widest mb-3" style="color: hsl(213 20% 52%);">Monthly Payment</p>
          <div id="monthly-payment" class="font-display font-bold text-5xl mono-num mb-2" style="color: hsl(213 70% 10%);">$294</div>
          <div class="h-px mx-auto w-16 mb-3" style="background: linear-gradient(90deg, transparent, hsl(168 100% 38% / 0.5), transparent);"></div>
          <p class="text-xs" style="color: hsl(213 20% 65%);">Fixed for the life of the loan</p>
        </div>

        <!-- Breakdown -->
        <div class="grid grid-cols-3 gap-3">
          {[
            { id: 'total-interest', label: 'Interest', color: 'hsl(37 91% 52%)' },
            { id: 'total-paid',     label: 'Total Cost', color: 'hsl(213 70% 10%)' },
            { id: 'term-months',    label: 'Term', color: 'hsl(204 100% 45%)' },
          ].map(({ id, label, color }) => (
            <div class="glass-card p-4 text-center">
              <div id={id} class="font-display font-bold text-lg mono-num" style={`color: ${color};`}>—</div>
              <div class="text-xs mt-0.5" style="color: hsl(213 20% 60%);">{label}</div>
            </div>
          ))}
        </div>

        <!-- Amortization mini bar -->
        <div class="glass-card p-5">
          <p class="text-xs font-semibold uppercase tracking-widest mb-3" style="color: hsl(213 20% 52%);">Principal vs Interest</p>
          <div class="h-2 rounded-full overflow-hidden flex" id="amort-bar">
            <div id="amort-principal" class="h-full transition-all duration-500"
              style="background: linear-gradient(90deg, hsl(168 100% 40%), hsl(168 100% 55%)); width: 95%;"></div>
            <div id="amort-interest" class="h-full transition-all duration-500"
              style="background: hsl(37 91% 55% / 0.7); width: 5%;"></div>
          </div>
          <div class="flex gap-4 mt-3">
            <div class="flex items-center gap-1.5 text-xs" style="color: hsl(213 20% 60%);">
              <span class="w-2 h-2 rounded-full" style="background: hsl(168 100% 40%);"></span> Principal
            </div>
            <div class="flex items-center gap-1.5 text-xs" style="color: hsl(213 20% 60%);">
              <span class="w-2 h-2 rounded-full" style="background: hsl(37 91% 55%);"></span> Interest
            </div>
          </div>
        </div>

        <!-- CTA -->
        <a href="/apply" class="btn-primary w-full text-base py-4">
          Apply for This Loan
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style is:inline>
  .term-btn-active {
    border-color: hsl(168 100% 38% / 0.4);
    color: hsl(168 100% 30%);
    background: hsl(168 100% 38% / 0.08);
  }
  .term-btn-inactive {
    border-color: hsl(213 20% 88%);
    color: hsl(213 70% 10% / 0.4);
    background: transparent;
  }
  .term-btn-inactive:hover {
    border-color: hsl(168 100% 38% / 0.3);
    color: hsl(213 70% 10% / 0.7);
  }
</style>

<script>
  function initCalculator() {
    const amountSlider  = document.getElementById('amount-slider') as HTMLInputElement;
    const aprSlider     = document.getElementById('apr-slider') as HTMLInputElement;
    const amountDisplay = document.getElementById('amount-display')!;
    const aprDisplay    = document.getElementById('apr-display')!;
    const monthlyEl     = document.getElementById('monthly-payment')!;
    const interestEl    = document.getElementById('total-interest')!;
    const totalEl       = document.getElementById('total-paid')!;
    const termEl        = document.getElementById('term-months')!;
    const principalBar  = document.getElementById('amort-principal')!;
    const interestBar   = document.getElementById('amort-interest')!;
    const termBtns      = document.querySelectorAll<HTMLButtonElement>('.term-btn');

    if (!amountSlider || !aprSlider) return;

    let selectedTerm = 36;

    function calcMonthly(p: number, r: number, n: number): number {
      if (r === 0) return p / n;
      const m = r / 100 / 12;
      return p * (m * Math.pow(1 + m, n)) / (Math.pow(1 + m, n) - 1);
    }

    function setProgress(slider: HTMLInputElement) {
      const pct = ((+slider.value - +slider.min) / (+slider.max - +slider.min)) * 100;
      slider.style.setProperty('--progress', pct + '%');
    }

    function fmt(n: number) {
      return '$' + Math.round(n).toLocaleString();
    }

    function update() {
      const amount = +amountSlider.value;
      const apr    = +aprSlider.value;
      const months = selectedTerm;

      const monthly  = calcMonthly(amount, apr, months);
      const total    = monthly * months;
      const interest = total - amount;
      const pPct     = Math.max(0, Math.min(100, (amount / total) * 100)).toFixed(1);
      const iPct     = Math.max(0, Math.min(100, (interest / total) * 100)).toFixed(1);

      amountDisplay.textContent = '$' + amount.toLocaleString();
      aprDisplay.textContent    = apr.toFixed(2) + '%';
      monthlyEl.textContent     = fmt(monthly);
      interestEl.textContent    = fmt(interest);
      totalEl.textContent       = fmt(total);
      termEl.textContent        = months + 'mo';
      principalBar.style.width  = pPct + '%';
      interestBar.style.width   = iPct + '%';

      setProgress(amountSlider);
      setProgress(aprSlider);
    }

    amountSlider.addEventListener('input', update);
    aprSlider.addEventListener('input', update);

    termBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        selectedTerm = Number(btn.dataset.term);
        termBtns.forEach(b => {
          b.classList.remove('term-btn-active');
          b.classList.add('term-btn-inactive');
        });
        btn.classList.add('term-btn-active');
        btn.classList.remove('term-btn-inactive');
        update();
      });
    });

    update();
  }

  initCalculator();
  document.addEventListener('astro:page-load', initCalculator);
</script>
