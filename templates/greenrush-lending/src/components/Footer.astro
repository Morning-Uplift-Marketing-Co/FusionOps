---
const brand    = import.meta.env.PUBLIC_BRAND   || 'GreenRush Lending';
const aprMin   = import.meta.env.PUBLIC_APRMIN  || '5.99';
const aprMax   = import.meta.env.PUBLIC_APRMAX  || '35.99';
const amtMin   = import.meta.env.PUBLIC_AMOUNTMIN || '1,000';
const amtMax   = import.meta.env.PUBLIC_AMOUNTMAX || '5,000';

const popupContent: Record<string, { title: string; body: string }> = {
  'Debt Consolidation': {
    title: 'Debt Consolidation',
    body: 'Combine multiple high-interest debts into one simple monthly payment. Many borrowers reduce their overall interest cost significantly by consolidating credit cards and other loans.',
  },
  'Home Improvement': {
    title: 'Home Improvement',
    body: 'Finance repairs, renovations, or upgrades without tapping into your home equity. Fixed monthly payments make it easy to budget for your project from start to finish.',
  },
  'Medical Loans': {
    title: 'Medical Loans',
    body: 'Cover unexpected medical expenses with a fixed-rate loan. We work with borrowers across a wide credit spectrum and offer same-day funding in most cases.',
  },
  'How It Works': {
    title: 'How It Works',
    body: '1. Check your rate in minutes with no impact to your credit score.\n2. Review your personalized offers and choose the best fit.\n3. Sign your documents electronically.\n4. Receive funds directly in your bank account — often the same day.',
  },
  'Payment Calculator': {
    title: 'Payment Calculator',
    body: 'Use our interactive calculator to estimate your monthly payment. Adjust the loan amount, term, and APR to see how different scenarios affect your budget before you apply.',
  },
  'APR & Rates': {
    title: 'APR & Rates',
    body: `Rates range from ${aprMin}% to ${aprMax}% APR based on creditworthiness and loan term. Rates are fixed for the life of the loan — your payment will never change. No hidden fees or prepayment penalties.`,
  },
  'FAQ': {
    title: 'Frequently Asked Questions',
    body: 'Q: Will checking my rate hurt my credit?\nA: No. Rate checks use a soft inquiry.\n\nQ: How fast can I receive funds?\nA: As fast as same business day after approval.\n\nQ: Are there prepayment penalties?\nA: Never. Pay off early at no cost.',
  },
  'About Us': {
    title: 'About Us',
    body: `${brand} connects borrowers with a network of trusted lenders to deliver competitive fixed-rate personal loans. Our mission is to make borrowing transparent, fast, and fair for everyone.`,
  },
  'Privacy Policy': {
    title: 'Privacy Policy',
    body: 'We collect only the information necessary to process your loan application. Your data is encrypted, never sold to third parties, and stored in compliance with applicable federal and state privacy laws. You may request deletion of your data at any time.',
  },
  'Terms of Service': {
    title: 'Terms of Service',
    body: `By using ${brand}, you agree to our terms governing loan applications, rate inquiries, and communications. ${brand} operates as a loan marketplace. Loan approval and terms are determined by individual lenders. All loans subject to credit review.`,
  },
  'Accessibility': {
    title: 'Accessibility',
    body: `${brand} is committed to ensuring digital accessibility for people with disabilities. We continually improve the user experience for everyone and apply relevant accessibility standards. Contact us at accessibility@GreenRush.com if you encounter barriers.`,
  },
};
---

<!-- Popup modals -->
{Object.entries(popupContent).map(([key, { title, body }]) => (
  <div
    id={`popup-${key.replace(/\s+/g, '-').toLowerCase()}`}
    class="popup-overlay fixed inset-0 z-[200] flex items-center justify-center p-4 opacity-0 pointer-events-none transition-opacity duration-200"
    style="background: hsl(50 30% 97% / 0.95);"
  >
    <div class="popup-box premium-card max-w-md w-full p-8 relative scale-95 transition-transform duration-200">
      <button
        class="popup-close absolute top-4 right-4 w-8 h-8 rounded-lg flex items-center justify-center text-foreground/40 hover:text-foreground/80 hover:bg-border/50 transition-colors"
        aria-label="Close"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
          <path d="M18 6L6 18M6 6l12 12"/>
        </svg>
      </button>
      <h3 class="font-display font-bold text-foreground text-lg mb-4">{title}</h3>
      <p class="text-foreground/55 text-sm leading-relaxed whitespace-pre-line">{body}</p>
    </div>
  </div>
))}

<!-- Pre-footer CTA -->
<section class="py-16 px-6">
  <div class="max-w-6xl mx-auto">
    <div class="premium-card p-10 md:p-14 text-center relative overflow-hidden">
      <div class="absolute inset-0 pointer-events-none"
        style="background: radial-gradient(ellipse 60% 60% at 50% 120%, hsl(142 38% 42% / 0.08), transparent);"></div>
      <span class="section-label relative">Limited-Time Offer</span>
      <h2 class="font-display font-bold text-3xl md:text-4xl text-foreground relative mb-4">
        Your Best Rate Is Waiting
      </h2>
      <p class="text-foreground/50 text-base max-w-xl mx-auto mb-8 relative">
        Check your rate in 3 minutes with no impact to your credit. Join 50,000+ borrowers who chose GreenRush.
      </p>
      <a href="/apply" class="btn-primary text-base py-4 px-10 relative">
        Get My Rate Now — It's Free
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>

      <!-- Trust row -->
      <div class="flex flex-wrap justify-center gap-6 mt-8 text-foreground/35 text-xs">
        {[
          'No hard credit pull to check rate',
          'Funds as fast as same day',
          'Fixed monthly payments',
          'No prepayment penalties',
        ].map(item => (
          <div class="flex items-center gap-1.5">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="hsl(142 38% 42%)" stroke-width="2.5" stroke-linecap="round">
              <path d="M20 6L9 17l-5-5"/>
            </svg>
            {item}
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- Regulatory Disclosure -->
<section id="disclosure" class="px-6 pb-10">
  <div class="max-w-6xl mx-auto">
    <div class="glass-card p-6 border-l-2 mb-8" style="border-left-color: hsl(142 38% 42% / 0.5);">
      <h3 class="font-display font-semibold text-foreground/70 text-sm mb-3 flex items-center gap-2">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="hsl(142 38% 42%)" stroke-width="2" stroke-linecap="round">
          <circle cx="12" cy="12" r="10"/><path d="M12 8v4"/><path d="M12 16h.01"/>
        </svg>
        Important Regulatory Disclosures
      </h3>
      <div class="space-y-2 text-foreground/30 text-xs leading-relaxed">
        <p><strong class="text-foreground/45">Representative APR:</strong> Loans carry an APR ranging from {aprMin}% to {aprMax}%. Loan amounts from ${amtMin} to ${amtMax}. Loan terms from 12 to 60 months. Representative example: $5,000 borrowed over 36 months at a representative APR of 14.99% (fixed) results in 36 monthly payments of $173.17, total repayable $6,234.12 (including $1,234.12 interest). Representative APR 14.99%.</p>
        <p><strong class="text-foreground/45">No Guarantee:</strong> Submitting an application does not guarantee approval. All applications subject to credit review, income verification, and underwriting. Not all applicants will qualify.</p>
        <p><strong class="text-foreground/45">Credit Check:</strong> Rate inquiries use a soft pull and do not affect your credit score. Full applications may result in a hard inquiry. State availability and loan terms vary.</p>
        <p><strong class="text-foreground/45">Not a Direct Lender:</strong> {brand} may operate as a loan marketplace connecting consumers with a network of lenders. Compensation may be received from lenders for referrals.</p>
      </div>
    </div>
  </div>
</section>

<!-- Footer -->
<footer class="border-t border-border px-6 py-10">
  <div class="max-w-6xl mx-auto">
    <div class="grid grid-cols-2 md:grid-cols-5 gap-8 mb-10">
      <div class="col-span-2">
        <div class="flex items-center gap-2.5 mb-4">
          <div class="w-7 h-7 rounded-lg flex items-center justify-center"
            style="background: linear-gradient(135deg, hsl(142 38% 46%), hsl(142 42% 36%));">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="hsl(50 30% 97%)" stroke-width="2.5" stroke-linecap="round">
              <path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/>
            </svg>
          </div>
          <span class="font-display font-bold text-foreground text-sm">{brand}</span>
        </div>
        <p class="text-foreground/35 text-xs leading-relaxed max-w-xs mb-4">
          Premium installment loans with fixed payments and transparent terms. NMLS #123456.
        </p>
        <div class="flex items-center gap-1.5 text-foreground/30 text-xs">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="hsl(142 38% 42%)" stroke-width="2" stroke-linecap="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
          256-bit SSL Encrypted
        </div>
      </div>

      {[
        { heading: 'Loans', links: ['Debt Consolidation', 'Home Improvement', 'Medical Loans'] },
        { heading: 'Learn', links: ['How It Works', 'Payment Calculator', 'APR & Rates', 'FAQ'] },
        { heading: 'Company', links: ['About Us', 'Privacy Policy', 'Terms of Service', 'Accessibility'] },
      ].map(col => (
        <div>
          <h4 class="font-semibold text-foreground/50 text-xs uppercase tracking-widest mb-4">{col.heading}</h4>
          <ul class="space-y-2.5">
            {col.links.map(link => (
              <li>
                <button
                  data-popup={link.replace(/\s+/g, '-').toLowerCase()}
                  class="text-foreground/35 text-xs hover:text-foreground/70 transition-colors text-left cursor-pointer"
                >
                  {link}
                </button>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="border-t border-border pt-6 flex flex-col md:flex-row items-center justify-between gap-3">
      <p class="text-foreground/25 text-xs">&copy; {new Date().getFullYear()} {brand}. All rights reserved.</p>
      <p class="text-foreground/20 text-xs">Loans subject to state laws. Not available in all states.</p>
    </div>
  </div>
</footer>

<!-- Sticky mobile CTA — hidden by default, shown after 35px scroll -->
<div
  id="sticky-mobile-cta"
  class="md:hidden fixed bottom-0 left-0 right-0 z-50 p-3 translate-y-full transition-transform duration-300"
  style="background: linear-gradient(to top, hsl(50 30% 97% / 0.97) 70%, transparent);"
>
  <a href="/apply" class="btn-primary w-full text-base py-4 flex items-center justify-center gap-2">
    Check My Rate — It's Free
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
      <path d="M5 12h14M12 5l7 7-7 7"/>
    </svg>
  </a>
</div>

<script>
  // Sticky mobile CTA scroll trigger
  const stickyCta = document.getElementById('sticky-mobile-cta');
  if (stickyCta) {
    const onScroll = () => {
      if (window.scrollY > 35) {
        stickyCta.classList.remove('translate-y-full');
      } else {
        stickyCta.classList.add('translate-y-full');
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }

  // Popup logic
  document.querySelectorAll<HTMLButtonElement>('[data-popup]').forEach(btn => {
    btn.addEventListener('click', () => {
      const id = `popup-${btn.dataset.popup}`;
      const modal = document.getElementById(id);
      if (!modal) return;
      modal.classList.remove('opacity-0', 'pointer-events-none');
      modal.querySelector<HTMLElement>('.popup-box')?.classList.remove('scale-95');
      document.body.style.overflow = 'hidden';
    });
  });

  const closePopup = (modal: HTMLElement) => {
    modal.classList.add('opacity-0', 'pointer-events-none');
    modal.querySelector<HTMLElement>('.popup-box')?.classList.add('scale-95');
    document.body.style.overflow = '';
  };

  document.querySelectorAll<HTMLElement>('.popup-overlay').forEach(modal => {
    modal.querySelector('.popup-close')?.addEventListener('click', () => closePopup(modal));
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closePopup(modal);
    });
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      document.querySelectorAll<HTMLElement>('.popup-overlay:not(.pointer-events-none)').forEach(closePopup);
    }
  });
</script>
