---
export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
}

const {
  title = 'LendPath — Find Loans Up to $5,000',
  description = 'Compare loan offers from multiple lenders. Check rates in minutes with no impact to your credit score. Amounts from $1,000 to $5,000.',
  canonical = 'https://lendpath.com/',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <!-- Performance: viewport with width=device-width for mobile-first CLS=0 -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="LendPath" />
    <meta property="og:image" content="/og-image.svg" />
    <meta property="og:image:type" content="image/svg+xml" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="LendPath — Find Loans Up to $5,000. Compare offers from 40+ lenders with no hard credit pull." />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/og-image.svg" />
    <meta name="twitter:image:alt" content="LendPath — Find Loans Up to $5,000" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <meta name="theme-color" content="#0057FF" />

    <!-- Performance: preconnect for font -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Performance: font loaded with display=swap to prevent render blocking -->
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
        rel="stylesheet"
      />
    </noscript>

    <!-- Structured data: Organization -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "LendPath",
        "url": "https://lendpath.com",
        "description": "Loan marketplace connecting borrowers with lenders across the United States.",
        "areaServed": "US",
        "serviceType": "Loan Marketplace"
      }
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
