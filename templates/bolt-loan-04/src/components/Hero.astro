---
---

<section class="relative overflow-hidden pt-24 pb-20 md:pt-36 md:pb-32" aria-label="Hero">
  <div class="pointer-events-none absolute inset-0 z-0" aria-hidden="true">
    <div style="background: radial-gradient(ellipse 80% 60% at 50% -10%, rgba(0,87,255,0.18) 0%, transparent 70%); position: absolute; inset: 0;"></div>
    <div style="background: radial-gradient(ellipse 40% 40% at 80% 60%, rgba(0,87,255,0.07) 0%, transparent 70%); position: absolute; inset: 0;"></div>
    <div style="background-image: linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px); background-size: 64px 64px; position: absolute; inset: 0;"></div>
  </div>

  <div class="relative z-10 mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl text-center">

      <div class="mb-6 inline-flex items-center gap-2 rounded-full border px-4 py-1.5 text-sm font-medium"
        style="border-color: rgba(0,87,255,0.3); background: rgba(0,87,255,0.08); color: #93bbff;">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <circle cx="7" cy="7" r="3" fill="#0057ff"/>
          <circle cx="7" cy="7" r="6" stroke="#0057ff" stroke-width="1.5" stroke-dasharray="2 2"/>
        </svg>
        Comparing offers from 40+ lenders nationwide
      </div>

      <h1 class="mb-6 text-4xl font-extrabold leading-tight sm:text-5xl md:text-6xl" style="letter-spacing: -0.03em; color: #f1f5f9;">
        Get Up To $5,000 Funding Fast
        <span class="gradient-text-blue block">Without the Hassle</span>
      </h1>

      <p class="mx-auto mb-8 max-w-2xl text-lg text-slate-400 md:text-xl" style="line-height: 1.6;">
        Simple application, fast processing, and 24-hour funding time.
      </p>

      <form method="GET" action="#apply" class="flex flex-col items-stretch gap-3 sm:flex-row sm:justify-center sm:items-center w-full max-w-md mx-auto">
        <div class="relative flex-1">
          <label for="hero-zip" class="sr-only">ZIP Code</label>
          <input
            id="hero-zip"
            name="zip"
            type="text"
            inputmode="numeric"
            pattern="[0-9]{5}"
            maxlength="5"
            autocomplete="postal-code"
            placeholder="Enter ZIP Code"
            required
            title="Enter a valid 5-digit ZIP code"
            class="w-full rounded-xl px-5 py-4 text-base text-white placeholder-slate-500 outline-none"
            style="background: rgba(255,255,255,0.07); border: 1px solid rgba(255,255,255,0.12);"
          />
        </div>
        <button
          type="submit"
          class="btn-primary shrink-0 text-base px-8 py-4"
          aria-label="Check your loan rate — no hard credit pull"
        >
          Check My Rate
          <svg class="ml-2 inline-block" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M2.5 8h11M9.5 4.5L13 8l-3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </form>

      <p class="mt-3 text-xs text-slate-500">
        No hard credit pull &nbsp;·&nbsp; No obligation &nbsp;·&nbsp; 2-minute form
      </p>

      <p class="mt-5 text-sm text-slate-500">
        Trusted by <strong class="text-slate-300">120,000+</strong> borrowers across the US &nbsp;·&nbsp;
        <span class="text-slate-300">&#9733; 4.8/5</span> average rating
      </p>
    </div>

    <div class="mt-16 grid grid-cols-2 gap-4 md:grid-cols-4">
      {[
        { value: '$5K', label: 'Maximum loan amount' },
        { value: '5.90%', label: 'Rates starting from APR' },
        { value: '2 min', label: 'To check your rate' },
        { value: '40+', label: 'Lender partners' },
      ].map((stat) => (
        <div class="card text-center py-5">
          <div class="text-2xl font-extrabold text-primary md:text-3xl">{stat.value}</div>
          <div class="mt-1 text-xs text-slate-500">{stat.label}</div>
        </div>
      ))}
    </div>

    <div class="mt-10 flex flex-wrap items-center justify-center gap-x-8 gap-y-4">
      <div class="flex items-center gap-2">
        <svg width="18" height="18" viewBox="0 0 22 22" fill="none" aria-hidden="true">
          <path d="M11 2L4 5v5c0 4.4 3 8.5 7 9.5C15 18.5 18 14.4 18 10V5l-7-3z" stroke="#10b981" stroke-width="1.5" stroke-linejoin="round"/>
          <path d="M8 11l2 2 4-4" stroke="#10b981" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span class="text-xs font-medium text-slate-400">256-bit SSL</span>
      </div>
      <div class="h-3 w-px bg-slate-700" aria-hidden="true"></div>
      <div class="flex items-center gap-2">
        <svg width="18" height="18" viewBox="0 0 22 22" fill="none" aria-hidden="true">
          <circle cx="11" cy="11" r="8" stroke="#f59e0b" stroke-width="1.5"/>
          <text x="11" y="15" text-anchor="middle" font-size="6.5" font-weight="700" fill="#f59e0b" font-family="Inter,sans-serif">BBB</text>
        </svg>
        <span class="text-xs font-medium text-slate-400">BBB A+ Accredited</span>
      </div>
      <div class="h-3 w-px bg-slate-700" aria-hidden="true"></div>
      <div class="flex items-center gap-2">
        <svg width="18" height="18" viewBox="0 0 22 22" fill="none" aria-hidden="true">
          <rect x="4" y="9" width="14" height="10" rx="2" stroke="#0057ff" stroke-width="1.5"/>
          <path d="M7 9V7a4 4 0 018 0v2" stroke="#0057ff" stroke-width="1.5" stroke-linecap="round"/>
          <circle cx="11" cy="14" r="1.5" fill="#0057ff"/>
        </svg>
        <span class="text-xs font-medium text-slate-400">No Hard Credit Pull</span>
      </div>
      <div class="h-3 w-px bg-slate-700" aria-hidden="true"></div>
      <div class="flex items-center gap-2">
        <svg width="18" height="18" viewBox="0 0 22 22" fill="none" aria-hidden="true">
          <circle cx="11" cy="11" r="8" stroke="#10b981" stroke-width="1.5"/>
          <path d="M7 11l3 3 5-5" stroke="#10b981" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span class="text-xs font-medium text-slate-400">CCPA Compliant</span>
      </div>
      <div class="h-3 w-px bg-slate-700" aria-hidden="true"></div>
      <div class="flex items-center gap-2">
        <svg width="18" height="18" viewBox="0 0 22 22" fill="none" aria-hidden="true">
          <path d="M11 2l2.6 5.3 5.9.9-4.3 4.2 1 5.9L11 15.6l-5.2 2.7 1-5.9L2.5 8.2l5.9-.9L11 2z" fill="#f59e0b" stroke="#f59e0b" stroke-width="1.2" stroke-linejoin="round"/>
        </svg>
        <span class="text-xs font-medium text-slate-400">4.8/5 on Trustpilot</span>
      </div>
    </div>
  </div>
</section>
