---
---

<section id="apply" class="py-20 md:py-28" aria-labelledby="apply-form-heading">
  <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:px-8">
    <div class="mb-10 text-center">
      <p class="section-label mb-3">Get Your Offers</p>
      <h2 id="apply-form-heading" class="text-3xl font-extrabold sm:text-4xl" style="color: #f1f5f9; letter-spacing: -0.02em;">
        Check Your Rate
      </h2>
      <p class="mt-3 text-slate-400 text-sm">Takes about 2 minutes. No hard credit pull.</p>
    </div>

    <form
      method="GET"
      action="#apply"
      aria-label="Loan rate check form"
      class="card py-8 px-6 sm:px-10 space-y-5"
      style="background: var(--surface-2);"
    >
      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <label for="loan-amount" class="block text-xs font-semibold text-slate-300 mb-1.5 uppercase tracking-wide">Loan Amount</label>
          <div class="relative">
            <span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-sm" aria-hidden="true">$</span>
            <input
              id="loan-amount"
              name="loan_amount"
              type="number"
              min="1000"
              max="50000"
              step="100"
              inputmode="numeric"
              placeholder="10000"
              required
              class="apply-input w-full pl-7 pr-4 py-3 text-sm text-white rounded-lg outline-none"
              style="background: var(--surface-3); border: 1px solid var(--border);"
            />
          </div>
        </div>
        <div>
          <label for="loan-purpose" class="block text-xs font-semibold text-slate-300 mb-1.5 uppercase tracking-wide">Loan Purpose</label>
          <select
            id="loan-purpose"
            name="loan_purpose"
            required
            class="apply-input w-full px-4 py-3 text-sm text-white rounded-lg outline-none appearance-none"
            style="background: var(--surface-3); border: 1px solid var(--border);"
          >
            <option value="">Select purpose</option>
            <option value="debt_consolidation">Debt Consolidation</option>
            <option value="home_improvement">Home Improvement</option>
            <option value="medical">Medical Expenses</option>
            <option value="auto">Auto Repair</option>
            <option value="major_purchase">Major Purchase</option>
            <option value="business">Business</option>
            <option value="other">Other</option>
          </select>
        </div>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <label for="first-name" class="block text-xs font-semibold text-slate-300 mb-1.5 uppercase tracking-wide">First Name</label>
          <input
            id="first-name"
            name="first_name"
            type="text"
            autocomplete="given-name"
            placeholder="Jane"
            required
            minlength="1"
            class="apply-input w-full px-4 py-3 text-sm text-white rounded-lg outline-none"
            style="background: var(--surface-3); border: 1px solid var(--border);"
          />
        </div>
        <div>
          <label for="last-name" class="block text-xs font-semibold text-slate-300 mb-1.5 uppercase tracking-wide">Last Name</label>
          <input
            id="last-name"
            name="last_name"
            type="text"
            autocomplete="family-name"
            placeholder="Smith"
            required
            minlength="1"
            class="apply-input w-full px-4 py-3 text-sm text-white rounded-lg outline-none"
            style="background: var(--surface-3); border: 1px solid var(--border);"
          />
        </div>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <label for="email" class="block text-xs font-semibold text-slate-300 mb-1.5 uppercase tracking-wide">Email Address</label>
          <input
            id="email"
            name="email"
            type="email"
            autocomplete="email"
            placeholder="jane@email.com"
            required
            class="apply-input w-full px-4 py-3 text-sm text-white rounded-lg outline-none"
            style="background: var(--surface-3); border: 1px solid var(--border);"
          />
        </div>
        <div>
          <label for="zip-code" class="block text-xs font-semibold text-slate-300 mb-1.5 uppercase tracking-wide">ZIP Code</label>
          <input
            id="zip-code"
            name="zip"
            type="text"
            inputmode="numeric"
            pattern="[0-9]{5}"
            maxlength="5"
            autocomplete="postal-code"
            placeholder="90210"
            required
            title="Enter a valid 5-digit ZIP code"
            class="apply-input w-full px-4 py-3 text-sm text-white rounded-lg outline-none"
            style="background: var(--surface-3); border: 1px solid var(--border);"
          />
        </div>
      </div>

      <div>
        <label for="credit-score" class="block text-xs font-semibold text-slate-300 mb-1.5 uppercase tracking-wide">Estimated Credit Score</label>
        <select
          id="credit-score"
          name="credit_score"
          required
          class="apply-input w-full px-4 py-3 text-sm text-white rounded-lg outline-none appearance-none"
          style="background: var(--surface-3); border: 1px solid var(--border);"
        >
          <option value="">Select range</option>
          <option value="excellent">Excellent (720+)</option>
          <option value="good">Good (680–719)</option>
          <option value="fair">Fair (640–679)</option>
          <option value="poor">Poor (580–639)</option>
          <option value="bad">Bad (below 580)</option>
          <option value="unsure">Not Sure</option>
        </select>
      </div>

      <button
        type="submit"
        class="btn-primary w-full py-4 text-base"
      >
        See My Offers
        <svg class="ml-2 inline-block" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M2.5 8h11M9.5 4.5L13 8l-3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

      <p class="disclaimer-text text-center">
        By submitting, you agree to our
        <a href="#modal-terms" class="underline hover:text-slate-200 transition-colors">Terms</a>
        &amp;
        <a href="#modal-privacy" class="underline hover:text-slate-200 transition-colors">Privacy Policy</a>.
        Consent is not a condition of purchase.
      </p>

      <div class="flex flex-wrap justify-center gap-5 pt-1 text-xs text-slate-500">
        <span class="flex items-center gap-1.5">
          <svg width="12" height="12" viewBox="0 0 13 13" fill="none" aria-hidden="true"><path d="M6.5 1L2 3v3.5c0 3 2.5 5.8 4.5 6.5C8.5 12.3 11 9.5 11 6.5V3L6.5 1z" fill="rgba(16,185,129,0.2)" stroke="#10b981" stroke-width="1.2"/></svg>
          256-bit SSL
        </span>
        <span class="flex items-center gap-1.5">
          <svg width="12" height="12" viewBox="0 0 13 13" fill="none" aria-hidden="true"><circle cx="6.5" cy="6.5" r="5.5" stroke="#0057ff" stroke-width="1.2"/><path d="M4 6.5l2 2 3.5-3.5" stroke="#0057ff" stroke-width="1.2" stroke-linecap="round"/></svg>
          No Hard Pull
        </span>
        <span class="flex items-center gap-1.5">
          <svg width="12" height="12" viewBox="0 0 13 13" fill="none" aria-hidden="true"><rect x="1.5" y="4" width="10" height="7.5" rx="1.5" stroke="#f59e0b" stroke-width="1.2"/><path d="M4 4V3a2.5 2.5 0 015 0v1" stroke="#f59e0b" stroke-width="1.2" stroke-linecap="round"/></svg>
          No Obligation
        </span>
      </div>
    </form>
  </div>
</section>

<style>
  select option { background: #1c2030; color: #e2e8f0; }

  .apply-input:focus {
    border-color: rgba(0,87,255,0.5) !important;
    box-shadow: 0 0 0 3px rgba(0,87,255,0.1);
  }

  .apply-input:invalid:not(:placeholder-shown) {
    border-color: rgba(239,68,68,0.5) !important;
  }
</style>
