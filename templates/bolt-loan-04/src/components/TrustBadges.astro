---
---

<section class="border-y py-10" style="border-color: var(--border); background: var(--surface-2);" aria-label="Trust indicators">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <p class="mb-8 text-center text-xs font-semibold uppercase tracking-widest text-slate-500">
      Trusted, Secure &amp; Compliant
    </p>
    <div class="grid grid-cols-2 gap-6 sm:grid-cols-3 md:grid-cols-5">

      <!-- SSL Secured -->
      <div class="flex flex-col items-center gap-2 text-center">
        <div class="flex h-12 w-12 items-center justify-center rounded-xl" style="background: rgba(16,185,129,0.1); border: 1px solid rgba(16,185,129,0.2);">
          <svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
            <path d="M11 2L4 5v5c0 4.4 3 8.5 7 9.5C15 18.5 18 14.4 18 10V5l-7-3z" stroke="#10b981" stroke-width="1.5" stroke-linejoin="round"/>
            <path d="M8 11l2 2 4-4" stroke="#10b981" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <div>
          <div class="text-sm font-semibold text-white">256-bit SSL</div>
          <div class="text-xs text-slate-500">Encrypted</div>
        </div>
      </div>

      <!-- BBB-style accreditation -->
      <div class="flex flex-col items-center gap-2 text-center">
        <div class="flex h-12 w-12 items-center justify-center rounded-xl" style="background: rgba(0,87,255,0.1); border: 1px solid rgba(0,87,255,0.2);">
          <svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
            <circle cx="11" cy="11" r="8" stroke="#0057ff" stroke-width="1.5"/>
            <path d="M7.5 11l2.5 2.5 4.5-5" stroke="#0057ff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <div>
          <!-- COMPLIANCE REVIEW REQUIRED: verify accreditation status -->
          <div class="text-sm font-semibold text-white">BBB Accredited</div>
          <div class="text-xs text-slate-500">A+ Rating</div>
        </div>
      </div>

      <!-- No hard pull -->
      <div class="flex flex-col items-center gap-2 text-center">
        <div class="flex h-12 w-12 items-center justify-center rounded-xl" style="background: rgba(245,158,11,0.1); border: 1px solid rgba(245,158,11,0.2);">
          <svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
            <rect x="4" y="9" width="14" height="10" rx="2" stroke="#f59e0b" stroke-width="1.5"/>
            <path d="M7 9V7a4 4 0 018 0v2" stroke="#f59e0b" stroke-width="1.5" stroke-linecap="round"/>
            <circle cx="11" cy="14" r="1.5" fill="#f59e0b"/>
          </svg>
        </div>
        <div>
          <div class="text-sm font-semibold text-white">No Hard Pull</div>
          <div class="text-xs text-slate-500">Check rates safely</div>
        </div>
      </div>

      <!-- Privacy protected -->
      <div class="flex flex-col items-center gap-2 text-center">
        <div class="flex h-12 w-12 items-center justify-center rounded-xl" style="background: rgba(0,87,255,0.1); border: 1px solid rgba(0,87,255,0.2);">
          <svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
            <path d="M11 3a8 8 0 100 16A8 8 0 0011 3z" stroke="#0057ff" stroke-width="1.5"/>
            <path d="M11 7v4l3 1.5" stroke="#0057ff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <div>
          <div class="text-sm font-semibold text-white">Data Privacy</div>
          <div class="text-xs text-slate-500">CCPA Compliant</div>
        </div>
      </div>

      <!-- Star rating -->
      <div class="flex flex-col items-center gap-2 text-center col-span-2 sm:col-span-1">
        <div class="flex h-12 w-12 items-center justify-center rounded-xl" style="background: rgba(245,158,11,0.1); border: 1px solid rgba(245,158,11,0.2);">
          <svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
            <path d="M11 2l2.6 5.3 5.9.9-4.3 4.2 1 5.9L11 15.6l-5.2 2.7 1-5.9L2.5 8.2l5.9-.9L11 2z" fill="#f59e0b" stroke="#f59e0b" stroke-width="1.2" stroke-linejoin="round"/>
          </svg>
        </div>
        <div>
          <!-- COMPLIANCE REVIEW REQUIRED: verify rating source -->
          <div class="text-sm font-semibold text-white">4.8 / 5 Stars</div>
          <div class="text-xs text-slate-500">Trustpilot</div>
        </div>
      </div>

    </div>
  </div>
</section>
