---
---

<section class="relative overflow-hidden py-20 md:py-28" aria-labelledby="cta-heading">
  <div class="pointer-events-none absolute inset-0 z-0" aria-hidden="true">
    <div style="background: radial-gradient(ellipse 70% 60% at 50% 50%, rgba(0,87,255,0.14) 0%, transparent 70%); position: absolute; inset: 0;"></div>
  </div>

  <div class="relative z-10 mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-center">
    <div class="card mx-auto max-w-3xl py-14 px-8 md:py-16 md:px-12"
      style="background: linear-gradient(135deg, var(--surface-2) 0%, var(--surface-3) 100%); border-color: rgba(0,87,255,0.2);">

      <p class="section-label mb-4">Get Started Today</p>
      <h2 id="cta-heading" class="mb-5 text-3xl font-extrabold sm:text-4xl md:text-5xl" style="color: #f1f5f9; letter-spacing: -0.03em;">
        Ready to Find <br class="hidden sm:block"/>Your Best Rate?
      </h2>
      <p class="mb-8 text-slate-400 max-w-xl mx-auto text-lg">
        It takes under 2 minutes. No hard credit pull. No obligation to accept any offer.
      </p>

      <div class="flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
        <a
          href="#apply"
          class="btn-primary w-full sm:w-auto text-base px-10 py-4"
          aria-label="Start your free loan rate check"
        >
          Check My Rate — It's Free
        </a>
      </div>

      <p class="mt-6 disclaimer-text mx-auto max-w-lg">
        By clicking, you agree to our
        <a href="#modal-terms" class="underline text-slate-400 hover:text-slate-200 transition-colors">Terms</a>
        &amp;
        <a href="#modal-privacy" class="underline text-slate-400 hover:text-slate-200 transition-colors">Privacy Policy</a>
        and consent to be contacted about your inquiry. Consent is not a condition of purchase.
        <a href="#modal-disclosures" class="underline text-slate-500 hover:text-slate-300 transition-colors">Full disclosures</a>.
      </p>
    </div>
  </div>
</section>
