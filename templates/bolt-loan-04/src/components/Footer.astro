---
---

<footer
  role="contentinfo"
  style="background: var(--surface); border-top: 1px solid var(--border); contain: layout style;"
>
  <!-- Trust Badges Row -->
  <div style="background: var(--surface-2); border-bottom: 1px solid var(--border);">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-4">
      <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-3">

        <div class="flex items-center gap-2">
          <div
            class="flex items-center justify-center rounded"
            style="width:32px;height:32px;background:var(--primary);flex-shrink:0;"
            aria-hidden="true"
          >
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
              <rect x="2" y="5" width="14" height="10" rx="1.5" stroke="white" stroke-width="1.3"/>
              <path d="M5 5V4a4 4 0 018 0v1" stroke="white" stroke-width="1.3" stroke-linecap="round"/>
              <circle cx="9" cy="10.5" r="1.5" fill="white"/>
            </svg>
          </div>
          <div>
            <p class="text-xs font-semibold text-white leading-none">NMLS</p>
            <p class="text-xs leading-none" style="color:var(--muted);">ID #2847391</p>
          </div>
        </div>

        <div style="width:1px;height:28px;background:var(--border);" aria-hidden="true"></div>

        <div class="flex items-center gap-2">
          <div aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 22 22" fill="none">
              <path d="M11 2L4 5v5.5c0 4.5 3.3 8.7 7 9.5 3.7-.8 7-5 7-9.5V5L11 2z" fill="rgba(16,185,129,0.15)" stroke="#10b981" stroke-width="1.4"/>
              <path d="M8 11l2 2 4-4" stroke="#10b981" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <div>
            <p class="text-xs font-semibold text-white leading-none">SSL Secured</p>
            <p class="text-xs leading-none" style="color:var(--muted);">256-bit encryption</p>
          </div>
        </div>

        <div style="width:1px;height:28px;background:var(--border);" aria-hidden="true"></div>

        <div class="flex items-center gap-2">
          <div aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 22 22" fill="none">
              <circle cx="11" cy="11" r="9" stroke="#f59e0b" stroke-width="1.4"/>
              <text x="11" y="15" text-anchor="middle" font-size="8" font-weight="700" fill="#f59e0b" font-family="Inter,sans-serif">BBB</text>
            </svg>
          </div>
          <div>
            <p class="text-xs font-semibold text-white leading-none">BBB Accredited</p>
            <p class="text-xs leading-none" style="color:var(--muted);">A+ Rating</p>
          </div>
        </div>

        <div style="width:1px;height:28px;background:var(--border);" aria-hidden="true"></div>

        <div class="flex items-center gap-2">
          <div aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 22 22" fill="none">
              <path d="M11 2L3 6v6c0 4 3.5 7.5 8 8 4.5-.5 8-4 8-8V6L11 2z" fill="rgba(0,87,255,0.12)" stroke="#0057ff" stroke-width="1.4"/>
              <path d="M7.5 11l2.5 2.5 5-5" stroke="#0057ff" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <div>
            <p class="text-xs font-semibold text-white leading-none">Norton Secured</p>
            <p class="text-xs leading-none" style="color:var(--muted);">Verified &amp; Safe</p>
          </div>
        </div>

        <div style="width:1px;height:28px;background:var(--border);" aria-hidden="true"></div>

        <div class="flex items-center gap-2">
          <div aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 22 22" fill="none">
              <circle cx="11" cy="11" r="9" stroke="#10b981" stroke-width="1.4"/>
              <path d="M7 11l3 3 5-5" stroke="#10b981" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <div>
            <p class="text-xs font-semibold text-white leading-none">No Hard Pull</p>
            <p class="text-xs leading-none" style="color:var(--muted);">Soft inquiry only</p>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- 3-Column Grid -->
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-3">

      <!-- Column 1: Brand & Contact -->
      <div class="sm:col-span-2 lg:col-span-1">
        <div class="flex items-center gap-2 mb-4">
          <div
            class="flex items-center justify-center rounded-lg"
            style="width:36px;height:36px;background:var(--primary);flex-shrink:0;"
            aria-hidden="true"
          >
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
              <path d="M3 9c0-3.31 2.69-6 6-6s6 2.69 6 6-2.69 6-6 6" stroke="white" stroke-width="1.6" stroke-linecap="round"/>
              <path d="M9 6v3.5l2.5 1.5" stroke="white" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <span class="font-bold text-white text-base">LendPath</span>
        </div>

        <p class="text-xs leading-relaxed mb-5" style="color:var(--muted);">
          A loan marketplace connecting borrowers with licensed lenders across the United States. We are not a lender.
        </p>

        <address
          class="not-italic text-xs leading-relaxed space-y-1"
          style="color:var(--muted);"
          itemscope
          itemtype="https://schema.org/PostalAddress"
        >
          <p class="text-xs font-semibold text-white">LendPath Inc.</p>
          <p itemprop="streetAddress">1801 Congress Ave, Suite 14.100</p>
          <p>
            <span itemprop="addressLocality">Austin</span>,&nbsp;<span itemprop="addressRegion">TX</span>&nbsp;<span itemprop="postalCode">78701</span>
          </p>
          <span itemprop="addressCountry" class="sr-only">United States</span>
        </address>

        <div class="mt-4 space-y-1.5">
          <a
            href="tel:+18005550123"
            class="flex items-center gap-2 text-xs transition-colors hover:text-white"
            style="color:var(--muted);"
            aria-label="Call support at 1-800-555-0123"
          >
            <svg width="13" height="13" viewBox="0 0 13 13" fill="none" aria-hidden="true">
              <path d="M2 2.5c0 4.97 4.03 9 9 9l.5-2.5-2.5-.5c-.5 1-1 1.5-1 1.5S6 9 5 8 3.5 6 3.5 6s.5-.5 1.5-1L4.5 2.5 2 2z" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            1-800-555-0123
          </a>
          <a
            href="mailto:support@lendpath.com"
            class="flex items-center gap-2 text-xs transition-colors hover:text-white"
            style="color:var(--muted);"
            aria-label="Email support at support@lendpath.com"
          >
            <svg width="13" height="13" viewBox="0 0 13 13" fill="none" aria-hidden="true">
              <rect x="1.5" y="3" width="10" height="7.5" rx="1.5" stroke="currentColor" stroke-width="1.2"/>
              <path d="M1.5 4.5l5 3.5 5-3.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
            </svg>
            support@lendpath.com
          </a>
        </div>
      </div>

      <!-- Column 2: Company Links -->
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-widest mb-4" style="color:var(--primary-light);">Company</h3>
        <nav aria-label="Company navigation">
          <ul class="space-y-3">
            <li><a href="#how-it-works" class="text-sm transition-colors hover:text-white" style="color:var(--muted);">How It Works</a></li>
            <li><a href="#calculator" class="text-sm transition-colors hover:text-white" style="color:var(--muted);">Rate Calculator</a></li>
            <li><a href="#rates" class="text-sm transition-colors hover:text-white" style="color:var(--muted);">APR &amp; Rates</a></li>
            <li><a href="#faq" class="text-sm transition-colors hover:text-white" style="color:var(--muted);">FAQ</a></li>
            <li>
              <a href="mailto:support@lendpath.com" class="text-sm transition-colors hover:text-white" style="color:var(--muted);">Contact Us</a>
            </li>
          </ul>
        </nav>
      </div>

      <!-- Column 3: Legal Links (open modals) -->
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-widest mb-4" style="color:var(--primary-light);">Legal</h3>
        <nav aria-label="Legal and compliance navigation">
          <ul class="space-y-3">
            <li>
              <button data-modal="modal-privacy" class="footer-modal-btn text-sm transition-colors hover:text-white" style="color:var(--muted);">Privacy Policy</button>
            </li>
            <li>
              <button data-modal="modal-terms" class="footer-modal-btn text-sm transition-colors hover:text-white" style="color:var(--muted);">Terms of Service</button>
            </li>
            <li>
              <button data-modal="modal-ada" class="footer-modal-btn text-sm transition-colors hover:text-white" style="color:var(--muted);">ADA Accessibility</button>
            </li>
            <li>
              <button data-modal="modal-datasafety" class="footer-modal-btn text-sm transition-colors hover:text-white" style="color:var(--muted);">Data Safety</button>
            </li>
            <li>
              <button data-modal="modal-disclosures" class="footer-modal-btn text-sm transition-colors hover:text-white" style="color:var(--muted);">Rate Disclosures</button>
            </li>
          </ul>
        </nav>
      </div>

    </div>
  </div>

  <!-- Full-Width Compliance Disclosure Block -->
  <section aria-label="Financial disclosures and compliance" style="border-top: 1px solid var(--border);">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-8 space-y-3">
      <p class="disclaimer-text leading-relaxed">
        <strong class="text-slate-400">Important Disclosures:</strong> LendPath is not a lender, financial institution, loan broker, or agent for any lender or broker. LendPath is a marketing and lead generation platform that connects consumers with lenders and financial service providers. Not all lenders can provide loan amounts up to $5,000. Availability of funds is subject to lender approval and individual eligibility. Approval is not guaranteed.
      </p>
      <p class="disclaimer-text leading-relaxed">
        <strong class="text-slate-400">APR &amp; Cost of Credit:</strong> Annual Percentage Rates (APR) available through lenders in our network range from <strong class="text-slate-400">5.90% to 34.99%</strong>. Repayment terms range from <strong class="text-slate-400">6 to 72 months</strong>. Your actual APR, monthly payment, and total cost of credit will depend on your credit history, income, debt-to-income ratio, requested loan amount, loan term, and the lender's criteria. <strong class="text-slate-400">Representative Example:</strong> A loan of $5,000 at a fixed rate of 10.00% APR for 36 months results in 36 monthly payments of approximately $161.33, a total repayment of approximately $5,808.06, and total interest of approximately $808.06. This example is for illustrative purposes only and does not constitute a guarantee of credit terms.
      </p>
      <p class="disclaimer-text leading-relaxed">
        <strong class="text-slate-400">Credit Inquiries:</strong> Submitting a loan inquiry through LendPath typically results in a soft credit inquiry that does not impact your credit score. However, lenders to whom your information is submitted may perform hard credit inquiries as part of their approval process, which may affect your credit score.
      </p>
      <p class="disclaimer-text leading-relaxed">
        <strong class="text-slate-400">State Availability &amp; Licensing:</strong> LendPath (NMLS ID: #2847391) operates as a marketing platform. Loan products and lenders in our network are independently licensed and regulated by applicable state and federal agencies. Not all lenders operate in all states; product availability and terms vary by location. This is not an offer or solicitation to lend. All lending decisions are made by independent lenders.
      </p>
      <p class="disclaimer-text leading-relaxed">
        <strong class="text-slate-400">TCPA Notice:</strong> By submitting a loan inquiry, you provide express written consent for LendPath and its lender partners to contact you regarding your inquiry at the number provided, including by autodialer, pre-recorded messages, and text messages. Message and data rates may apply. Consent is not a condition of any purchase or loan approval. To opt out, contact us at support@lendpath.com.
      </p>
    </div>
  </section>

  <!-- Bottom Bar -->
  <div style="border-top: 1px solid var(--border); background: var(--surface-2);">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-4">
      <div class="flex flex-col items-center gap-2 sm:flex-row sm:justify-between">
        <p class="text-xs" style="color:#475569;">
          &copy; {new Date().getFullYear()} LendPath Inc. All rights reserved. Not a lender.
        </p>
        <p class="text-xs" style="color:#475569;">
          NMLS ID: #2847391 &middot; Licensed by State Regulators
        </p>
      </div>
    </div>
  </div>

</footer>

<style>
  .footer-modal-btn {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    text-align: left;
  }
</style>
