---
const rateRows = [
  { creditScore: '720 – 850 (Excellent)', aprRange: '5.90% – 12.99%', loanAmounts: '$1,000 – $5,000', terms: '6 – 72 months', note: 'Best available rates' },
  { creditScore: '660 – 719 (Good)', aprRange: '10.99% – 19.99%', loanAmounts: '$1,000 – $40,000', terms: '6 – 72 months', note: '' },
  { creditScore: '580 – 659 (Fair)', aprRange: '18.00% – 29.99%', loanAmounts: '$1,000 – $20,000', terms: '6 – 72 months', note: '' },
  { creditScore: 'Below 580', aprRange: '24.00% – 34.99%', loanAmounts: '$1,000 – $10,000', terms: '6 – 72 months', note: 'Limited lender options' },
];
---

<section class="py-20 md:py-28" style="background: var(--surface-2);" aria-labelledby="rates-heading">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="mb-14 text-center">
      <p class="section-label mb-3">Rate Transparency</p>
      <h2 id="rates-heading" class="text-3xl font-extrabold sm:text-4xl" style="color: #f1f5f9; letter-spacing: -0.02em;">
        Representative APR Range
      </h2>
      <p class="mt-4 text-slate-400 max-w-xl mx-auto text-sm">
        <!-- COMPLIANCE REVIEW REQUIRED: APR ranges must reflect actual lender network data -->
        Rates are estimates based on credit score tiers. Your actual APR depends on your creditworthiness,
        loan amount, term, and the lender you choose.
      </p>
    </div>

    <!-- Responsive table wrapper — horizontal scroll on mobile -->
    <div class="overflow-x-auto rounded-xl" style="border: 1px solid var(--border);">
      <table class="w-full min-w-[600px] text-sm" aria-label="Representative APR ranges by credit score tier">
        <caption class="sr-only">Representative APR Range by credit score</caption>
        <thead>
          <tr style="background: var(--surface-3); border-bottom: 1px solid var(--border);">
            <th scope="col" class="px-5 py-4 text-left text-xs font-semibold uppercase tracking-wider text-slate-400">Credit Score Range</th>
            <th scope="col" class="px-5 py-4 text-left text-xs font-semibold uppercase tracking-wider text-slate-400">APR Range</th>
            <th scope="col" class="px-5 py-4 text-left text-xs font-semibold uppercase tracking-wider text-slate-400">Loan Amounts</th>
            <th scope="col" class="px-5 py-4 text-left text-xs font-semibold uppercase tracking-wider text-slate-400">Loan Terms</th>
          </tr>
        </thead>
        <tbody>
          {rateRows.map((row, i) => (
            <tr style={`background: ${i % 2 === 0 ? 'var(--surface-2)' : 'var(--surface-3)'}; border-bottom: 1px solid var(--border);`}>
              <td class="px-5 py-4 font-medium text-white whitespace-nowrap">
                {row.creditScore}
                {row.note && (
                  <span class="ml-2 rounded-full px-2 py-0.5 text-xs" style="background: rgba(0,87,255,0.12); color: #93bbff;">
                    {row.note}
                  </span>
                )}
              </td>
              <td class="px-5 py-4 font-semibold text-primary whitespace-nowrap">{row.aprRange}</td>
              <td class="px-5 py-4 text-slate-300 whitespace-nowrap">{row.loanAmounts}</td>
              <td class="px-5 py-4 text-slate-300 whitespace-nowrap">{row.terms}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Regulatory disclosure below table -->
    <div class="mt-6 rounded-xl p-5" style="background: var(--surface-3); border: 1px solid var(--border);">
      <p class="disclaimer-text">
        <strong class="text-slate-300">APR Disclosure:</strong> The Annual Percentage Rates (APRs) shown above are
        representative examples and do not constitute an offer or guarantee of credit terms.
        <!-- COMPLIANCE REVIEW REQUIRED: verify example loan values for accuracy -->
        For example, a $10,000 loan at 12.99% APR over 36 months results in a monthly payment of approximately $337 and a total repayment of approximately $12,132. Repayment terms range from 6 to 72 months.
        Your actual APR and monthly payment will vary based on your specific credit profile, loan amount, and term selected.
        LendPath is not a lender. We connect consumers with third-party lenders.
        Not all applicants will qualify for the lowest rates. All loans are subject to lender approval and individual credit evaluation.
      </p>
    </div>
  </div>
</section>
