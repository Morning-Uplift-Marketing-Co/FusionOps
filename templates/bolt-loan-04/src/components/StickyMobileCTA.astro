<div
  id="sticky-mobile-cta"
  class="fixed bottom-0 left-0 right-0 z-50 md:hidden"
  style="transform: translateY(100%); transition: transform 0.35s cubic-bezier(0.4,0,0.2,1); will-change: transform;"
  aria-label="Apply now sticky bar"
>
  <div style="background: rgba(10,14,26,0.97); backdrop-filter: blur(12px); border-top: 1px solid rgba(255,255,255,0.1); padding: 12px 16px 20px;">
    <a
      href="#apply"
      class="btn-primary block w-full text-center text-base py-4 rounded-xl font-semibold"
      aria-label="Check your rate — no hard credit pull"
    >
      Check My Rate — No Credit Impact
    </a>
    <p class="mt-2 text-center text-xs text-slate-500">No hard credit pull &bull; Results in minutes</p>
  </div>
</div>

<script>
  (function () {
    const bar = document.getElementById('sticky-mobile-cta');
    if (!bar) return;

    let shown = false;

    function onScroll() {
      const scrolled = window.scrollY;
      const total = document.documentElement.scrollHeight - window.innerHeight;
      if (total <= 0) return;

      const pct = scrolled / total;

      if (!shown && pct >= 0.35) {
        shown = true;
        bar.style.transform = 'translateY(0)';
      } else if (shown && pct < 0.35) {
        shown = false;
        bar.style.transform = 'translateY(100%)';
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
  })();
</script>
