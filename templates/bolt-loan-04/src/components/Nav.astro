---
---

<header
  id="site-header"
  class="site-header fixed top-0 left-0 right-0 z-50"
  role="banner"
>
  <input type="checkbox" id="nav-toggle" class="nav-toggle sr-only" aria-hidden="true" />

  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between gap-4">

      <a href="/" class="flex shrink-0 items-center gap-2" aria-label="LendPath home">
        <div class="flex h-8 w-8 items-center justify-center rounded-lg" style="background: var(--primary);">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8c0-2.76 2.24-5 5-5s5 2.24 5 5-2.24 5-5 5" stroke="white" stroke-width="1.5" stroke-linecap="round"/>
            <path d="M8 5v3l2 1.5" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <span class="font-bold text-white text-base tracking-tight">LendPath</span>
      </a>

      <nav class="hidden items-center gap-6 md:flex" aria-label="Main navigation">
        <a href="#how-it-works" class="text-sm text-slate-400 hover:text-white transition-colors">How It Works</a>
        <a href="#calculator" class="text-sm text-slate-400 hover:text-white transition-colors">Calculator</a>
        <a href="#faq" class="text-sm text-slate-400 hover:text-white transition-colors">FAQ</a>
        <a href="#apply" class="btn-primary text-sm px-5 py-2">Check My Rate</a>
      </nav>

      <div class="flex items-center gap-3 md:hidden">
        <a href="#apply" class="btn-primary text-sm px-4 py-2">Check My Rate</a>
        <label
          for="nav-toggle"
          class="hamburger-btn flex h-9 w-9 cursor-pointer items-center justify-center rounded-lg"
          style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.08);"
          aria-label="Toggle navigation menu"
        >
          <span class="hamburger-icon" aria-hidden="true"></span>
        </label>
      </div>
    </div>
  </div>

  <nav
    class="mobile-menu md:hidden"
    aria-label="Mobile navigation"
    style="border-top: 1px solid rgba(255,255,255,0.06); background: rgba(11,14,20,0.97); backdrop-filter: blur(12px);"
  >
    <div class="mx-auto max-w-6xl px-4 py-5 flex flex-col gap-1">
      <a href="#how-it-works" class="rounded-lg px-4 py-3 text-sm font-medium text-slate-300 hover:bg-white/5 hover:text-white transition-colors">How It Works</a>
      <a href="#calculator" class="rounded-lg px-4 py-3 text-sm font-medium text-slate-300 hover:bg-white/5 hover:text-white transition-colors">Calculator</a>
      <a href="#faq" class="rounded-lg px-4 py-3 text-sm font-medium text-slate-300 hover:bg-white/5 hover:text-white transition-colors">FAQ</a>
      <div class="mt-3 pt-3" style="border-top: 1px solid rgba(255,255,255,0.06);">
        <a href="#apply" class="btn-primary block w-full text-center text-sm py-3 px-5">Check My Rate — It's Free</a>
      </div>
    </div>
  </nav>
</header>

<style>
  .nav-toggle { display: none; }

  .site-header {
    background: transparent;
    transition: background 0.3s, border-color 0.3s, backdrop-filter 0.3s;
  }

  .mobile-menu {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }

  .nav-toggle:checked ~ * .mobile-menu,
  .nav-toggle:checked + div + nav.mobile-menu {
    max-height: 400px;
  }

  .hamburger-icon {
    display: block;
    width: 16px;
    height: 2px;
    background: white;
    border-radius: 2px;
    position: relative;
    transition: background 0.2s;
  }

  .hamburger-icon::before,
  .hamburger-icon::after {
    content: '';
    display: block;
    width: 16px;
    height: 2px;
    background: white;
    border-radius: 2px;
    position: absolute;
    left: 0;
    transition: transform 0.2s, top 0.2s;
  }

  .hamburger-icon::before { top: -5px; }
  .hamburger-icon::after  { top:  5px; }

  .nav-toggle:checked ~ div .hamburger-icon {
    background: transparent;
  }
  .nav-toggle:checked ~ div .hamburger-icon::before {
    top: 0;
    transform: rotate(45deg);
  }
  .nav-toggle:checked ~ div .hamburger-icon::after {
    top: 0;
    transform: rotate(-45deg);
  }
</style>
