---
const scenarios = [
  {
    id: 'calc-5k-36',
    amount: 5000,
    term: 36,
    apr: 9.99,
    monthly: 161,
    total: 5796,
    interest: 796,
  },
  {
    id: 'calc-10k-36',
    amount: 10000,
    term: 36,
    apr: 12.00,
    monthly: 332,
    total: 11952,
    interest: 1952,
  },
  {
    id: 'calc-15k-48',
    amount: 15000,
    term: 48,
    apr: 14.99,
    monthly: 415,
    total: 19920,
    interest: 4920,
  },
  {
    id: 'calc-25k-60',
    amount: 25000,
    term: 60,
    apr: 18.00,
    monthly: 634,
    total: 38040,
    interest: 13040,
  },
  {
    id: 'calc-35k-72',
    amount: 35000,
    term: 72,
    apr: 24.00,
    monthly: 836,
    total: 60192,
    interest: 25192,
  },
];
---

<section id="calculator" class="py-20 md:py-28" aria-labelledby="calc-heading">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="mb-14 text-center">
      <p class="section-label mb-3">Payment Calculator</p>
      <h2 id="calc-heading" class="text-3xl font-extrabold sm:text-4xl" style="color: #f1f5f9; letter-spacing: -0.02em;">
        Estimate Your Monthly Payment
      </h2>
      <p class="mt-4 text-slate-400 max-w-xl mx-auto text-sm">
        Select a loan scenario to see estimated monthly payments. Actual rates depend on your credit profile.
      </p>
    </div>

    <div class="mx-auto max-w-3xl space-y-3">
      {scenarios.map((s) => (
        <details class="calc-card card overflow-hidden py-0">
          <summary class="flex cursor-pointer list-none items-center justify-between px-6 py-5 select-none">
            <div class="flex items-center gap-4 flex-wrap">
              <span class="text-base font-bold text-white">
                ${s.amount.toLocaleString('en-US')}
              </span>
              <span class="text-xs text-slate-500">{s.term} months</span>
              <span class="rounded-full px-2.5 py-0.5 text-xs font-semibold" style="background: rgba(0,87,255,0.12); color: #93bbff;">
                {s.apr.toFixed(2)}% APR
              </span>
            </div>
            <div class="flex items-center gap-4 ml-4">
              <div class="text-right">
                <div class="text-lg font-extrabold text-white">${s.monthly}/mo</div>
                <div class="text-xs text-slate-500 hidden sm:block">est. monthly</div>
              </div>
              <svg class="calc-chevron shrink-0 transition-transform duration-200" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                <path d="M4.5 6.75L9 11.25L13.5 6.75" stroke="#8892a4" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
          </summary>
          <div class="px-6 pb-6">
            <div class="grid grid-cols-3 gap-3">
              <div class="rounded-xl p-4 text-center" style="background: rgba(0,87,255,0.08); border: 1px solid rgba(0,87,255,0.15);">
                <p class="text-xs text-slate-500 mb-1">Loan Amount</p>
                <p class="text-xl font-extrabold text-white">${s.amount.toLocaleString('en-US')}</p>
              </div>
              <div class="rounded-xl p-4 text-center" style="background: rgba(0,87,255,0.08); border: 1px solid rgba(0,87,255,0.15);">
                <p class="text-xs text-slate-500 mb-1">Total Repayment</p>
                <p class="text-xl font-extrabold text-white">${s.total.toLocaleString('en-US')}</p>
              </div>
              <div class="rounded-xl p-4 text-center" style="background: rgba(0,87,255,0.08); border: 1px solid rgba(0,87,255,0.15);">
                <p class="text-xs text-slate-500 mb-1">Total Interest</p>
                <p class="text-xl font-extrabold" style="color: #f59e0b;">${s.interest.toLocaleString('en-US')}</p>
              </div>
            </div>
            <p class="mt-4 disclaimer-text text-center">
              Example only. APR range 5.90%–34.99%, terms 6–72 months. Actual rate depends on creditworthiness and lender criteria.
            </p>
            <div class="mt-4 text-center">
              <a href="#apply" class="btn-primary inline-block px-8 py-3 text-sm">
                See Real Offers for Your Profile
              </a>
            </div>
          </div>
        </details>
      ))}
    </div>

    <p class="mt-8 disclaimer-text text-center mx-auto max-w-2xl">
      These scenarios are for illustrative purposes only and do not constitute a loan offer.
      APRs shown reflect sample rates from our network. Your rate will be disclosed before you commit.
    </p>
  </div>
</section>

<style>
  .calc-card summary::-webkit-details-marker { display: none; }
  .calc-card[open] .calc-chevron { transform: rotate(180deg); }
  .calc-card[open] summary { background: rgba(0,87,255,0.04); }
</style>
