<!-- fusionops-voluum-cta: (runtime: window.__VOLUUM_CLICK_URL__) -->

<script data-cfasync="false" data-fusionops="voluum-cta-rewriter">
(function(){
  function destBase() {
    try {
      var w = window.__VOLUUM_CLICK_URL__ || '';
      return (w && /^https?:\/\//i.test(String(w))) ? String(w).trim() : '';
    } catch (_) { return ''; }
  }
  function mergeLandingQueryIntoUrl(base) {
    try {
      var u = new URL(base, window.location.href);
      var land = new URLSearchParams(window.location.search);
      land.forEach(function(v, k) {
        u.searchParams.set(k, v);
      });
      return u.toString();
    } catch (_) {
      return base;
    }
  }
  function patch() {
    var base = destBase();
    if (!base) return;
    var dest = mergeLandingQueryIntoUrl(base);
    document.querySelectorAll('a[href="/apply"],a[href="#apply"],a[href="/apply/"],a[data-fusionops-cta="1"]').forEach(function(a) {
      var h = a.getAttribute('href') || '';
      if (h === '/apply' || h === '/apply/' || h === '#apply') a.setAttribute('href', dest);
    });
    document.querySelectorAll('a[href^="/apply?"]').forEach(function(a) {
      a.setAttribute('href', dest);
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', patch);
  else patch();
  try { new MutationObserver(patch).observe(document.documentElement, { childList: true, subtree: true }); } catch (_) {}
  setTimeout(patch, 0);
  setTimeout(patch, 400);
  setTimeout(patch, 1500);
})();
</script>








