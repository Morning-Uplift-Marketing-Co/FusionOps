---
// Deploy-config → PUBLIC_* : AID, CONVERSIONID, FORMSTARTLABEL, FORMSUBMITLABEL, LEADSGATE_FORM_SRC
// String + lgAid name avoids clashing with globals LeadsGate scripts may use (bare aid identifier issues).
const lgAid = String(import.meta.env.PUBLIC_AID || '14881').trim() || '14881';
const conversionId = import.meta.env.PUBLIC_CONVERSIONID || '';
const formStartLabel = String(import.meta.env.PUBLIC_FORMSTARTLABEL || '').trim();
const formSubmitLabel = String(import.meta.env.PUBLIC_FORMSUBMITLABEL || '').trim();
const formStartSendTo = conversionId && formStartLabel ? conversionId + '/' + formStartLabel : '';
const formSubmitSendTo = conversionId && formSubmitLabel ? conversionId + '/' + formSubmitLabel : '';
const leadsGateFormSrc =
  import.meta.env.PUBLIC_LEADSGATE_FORM_SRC || 'https://apikeep.com/form/applicationInit.js';
const leadsGateHost = (() => {
  try {
    return new URL(leadsGateFormSrc).host || 'apikeep.com';
  } catch {
    return 'apikeep.com';
  }
})();
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Apply</title>
  <link rel="dns-prefetch" href={'//' + leadsGateHost} />
  {conversionId ? <script async src={'https://www.googletagmanager.com/gtag/js?id=' + conversionId}></script> : null}
  {conversionId ? (
    <script is:inline define:vars={{ conversionId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', conversionId);
    </script>
  ) : null}
  <style is:inline>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { height: 100%; min-height: 100vh; background: #f8fafc; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; }
    body { display: flex; flex-direction: column; align-items: center; justify-content: flex-start; padding: 24px 16px 48px; }
    #_lg_form_ { width: 100%; max-width: 640px; }
  </style>
</head>
<body>
<!-- #_lg_form_ before async LeadsGate inject — avoids mount race -->
<div id="_lg_form_"></div>

<script is:inline define:vars={{ lgAid, leadsGateFormSrc, formStartSendTo, formSubmitSendTo }}>
window.dataLayer = window.dataLayer || [];

function fpPixel(eventName, extra) {
  try {
    var h = window.location.hostname || '';
    if (h === 'localhost' || h === '127.0.0.1' || h === '::1' || /^(\d{1,3}\.){3}\d{1,3}$/.test(h)) {
      if (window.__DEBUG_FP_PIXEL) console.debug('[fpPixel]', eventName, extra);
      return;
    }
    var endpoint = 'https://t.' + h + '/e';
    var payload = Object.assign({ e: eventName, d: h, ts: Math.floor(Date.now()/1000) }, extra || {});
    if (lgAid != null && String(lgAid) !== '') payload.aid = String(lgAid);
    navigator.sendBeacon(endpoint, JSON.stringify(payload));
  } catch(_) {}
}

function safeGtag() {
  try {
    if (typeof gtag !== 'function') return;
    gtag.apply(null, arguments);
  } catch(_) {}
}

function safePixel(name, extra) {
  try {
    fpPixel(name, extra || {});
  } catch(_) {}
}

var SafeStorage = {
  _mem: {},
  set: function(k, v) {
    try { sessionStorage.setItem(k, v); }
    catch (e) { this._mem[k] = v; }
  },
  get: function(k) {
    try { return sessionStorage.getItem(k); }
    catch (e) { return this._mem[k] || null; }
  }
};

function getCookie(name) {
  try {
    var m = document.cookie.match(new RegExp('(^| )' + name + '=([^;]+)'));
    return m ? decodeURIComponent(m.pop()) : '';
  } catch (_) { return ''; }
}

function getVoluumClickId() {
  var urlParams = new URLSearchParams(window.location.search);
  var fromUrl =
    urlParams.get('clickid') ||
    urlParams.get('vlcid') ||
    urlParams.get('click_id') ||
    urlParams.get('cid') ||
    urlParams.get('cpid') ||
    urlParams.get('gclid') ||
    '';
  var fromStorage =
    SafeStorage.get('clickid') ||
    SafeStorage.get('vlcid') ||
    SafeStorage.get('voluum_cpid') ||
    SafeStorage.get('voluum_cid') ||
    '';
  var fromCookie = getCookie('clickid') || getCookie('vlcid') || '';
  var fromLs = '';
  try {
    fromLs = localStorage.getItem('clickid') || localStorage.getItem('_cid') || sessionStorage.getItem('clickid') || sessionStorage.getItem('_cid') || '';
  } catch (_) {}
  return fromUrl || fromStorage || fromCookie || fromLs || '';
}

(function() {
  var cid = getVoluumClickId();
  fpPixel('pv', cid ? { clickid: cid } : {});
})();

var _lg_form_init_ = {
  aid: lgAid,
  template: 'fresh',
  get click_id() {
    return getVoluumClickId();
  },

  onFormLoad: function() {
    if (formStartSendTo) safeGtag('event', 'conversion', { send_to: formStartSendTo });
    safePixel('fl');
  },

  onStepChange: function(step) {
    safePixel('step', { step: step });
  },

  onSubmit: function() {
    if (formSubmitSendTo) safeGtag('event', 'conversion', { send_to: formSubmitSendTo });
    safePixel('fs', { clickid: getVoluumClickId() });
  },

  onSuccess: function(response) {
    var cid = getVoluumClickId();
    safePixel('success', { clickid: cid, lead_id: response && response.lead_id });
  },

  onLeadSold: function(data) {
    var cid = getVoluumClickId();
    safePixel('sold', { clickid: cid, lead_id: data && data.lead_id, payout: data && data.price });
  },

  onLeadRejected: function(data) {
    var cid = getVoluumClickId();
    safePixel('rejected', { clickid: cid, lead_id: data && data.lead_id });
  }
};

var script = document.createElement('script');
script.setAttribute('data-cfasync', 'false');
script.type = 'text/javascript';
script.async = true;
script.src = leadsGateFormSrc;
document.body.appendChild(script);

</script>
</body>
</html>
