<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Apply Now</title>
  <link rel="dns-prefetch" href="//apikeep.com" />
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: system-ui, sans-serif; background: #f8fafc; min-height: 100vh; display: flex; align-items: center; justify-content: center; }
    #_lg_form_ { width: 100%; max-width: 600px; margin: 0 auto; padding: 20px; }
  </style>
</head>
<body>
<script is:inline>
window.dataLayer = window.dataLayer || [];
var SafeStorage = {
  _mem: {},
  set: function(k,v){try{sessionStorage.setItem(k,v);}catch(e){this._mem[k]=v;}},
  get: function(k){try{return sessionStorage.getItem(k);}catch(e){return this._mem[k]||null;}}
};
function getVoluumClickId(){
  var p=new URLSearchParams(window.location.search);
  var cid=p.get('cid')||p.get('click_id');
  return SafeStorage.get('voluum_cid')||cid||'';
}
var _lg_form_init_={
  aid:"REPLACE_WITH_AID",
  template:"fresh",
  ref:window.location.hostname,
  click_id:getVoluumClickId(),
  onFormLoad:function(){window.dataLayer.push({event:'leadsgate_form_start'});},
  onStepChange:function(step){window.dataLayer.push({event:'leadsgate_form_progress',step:step});},
  onSubmit:function(){window.dataLayer.push({event:'leadsgate_form_submit'});},
  onSuccess:function(data){
    window.dataLayer.push({event:'lead_conversion_all',lead_type:data.type});
    if(data.type==='soldLead')window.dataLayer.push({event:'lead_conversion_approved'});
    if(data.type==='rejectLead')window.dataLayer.push({event:'lead_declined'});
    if(data.type==='newLead')window.dataLayer.push({event:'lead_pending'});
  }
};
var s=document.createElement('script');
s.type='text/javascript';
s.async=true;
s.src='https://apikeep.com/form/applicationInit.js';
document.body.appendChild(s);
</script>
<div id="_lg_form_"></div>
</body>
</html>
