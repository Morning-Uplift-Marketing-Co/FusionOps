---
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>${site.brand} — ${site.loanLabel}</title>
  <link rel="dns-prefetch" href="//apikeep.com" />
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
      line-height: 1.6;
      color: #1f2937;
      background: #ffffff;
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 20px;
    }

    /* Hero Section */
    .hero {
      background: linear-gradient(135deg, #1e293b 0%, #334155 100%);
      color: #ffffff;
      padding: 60px 20px 80px;
      text-align: center;
    }

    .hero h1 {
      font-size: 2.5rem;
      font-weight: 800;
      margin-bottom: 16px;
      line-height: 1.2;
    }

    .hero p {
      font-size: 1.25rem;
      margin-bottom: 40px;
      opacity: 0.95;
    }

    .hero-form {
      max-width: 500px;
      margin: 0 auto;
      background: #ffffff;
      padding: 32px;
      border-radius: 12px;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
    }

    .hero-form input {
      width: 100%;
      padding: 16px;
      font-size: 1.125rem;
      border: 2px solid #e5e7eb;
      border-radius: 8px;
      margin-bottom: 16px;
      transition: border-color 0.3s;
    }

    .hero-form input:focus {
      outline: none;
      border-color: #f97316;
    }

    .hero-form button {
      width: 100%;
      padding: 16px;
      font-size: 1.125rem;
      font-weight: 700;
      color: #ffffff;
      background: #f97316;
      border: none;
      border-radius: 8px;
      cursor: pointer;
      transition: background 0.3s, transform 0.2s;
      min-height: 56px;
    }

    .hero-form button:hover {
      background: #ea580c;
      transform: translateY(-2px);
    }

    .hero-form button:active {
      transform: translateY(0);
    }

    /* Trust Badges */
    .trust-badges {
      background: #f9fafb;
      padding: 40px 20px;
    }

    .badges-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 24px;
      max-width: 900px;
      margin: 0 auto;
    }

    .badge-item {
      text-align: center;
      padding: 24px;
      background: #ffffff;
      border-radius: 8px;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
    }

    .badge-icon {
      font-size: 2.5rem;
      margin-bottom: 12px;
    }

    .badge-item h3 {
      font-size: 1.125rem;
      font-weight: 700;
      margin-bottom: 8px;
      color: #1f2937;
    }

    .badge-item p {
      font-size: 0.875rem;
      color: #6b7280;
    }

    /* Section Headings */
    .section {
      padding: 60px 20px;
    }

    .section-title {
      font-size: 2rem;
      font-weight: 800;
      text-align: center;
      margin-bottom: 40px;
      color: #1f2937;
    }

    /* APR Table */
    .apr-table {
      background: #ffffff;
      border-radius: 8px;
      overflow: hidden;
      box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
      max-width: 800px;
      margin: 0 auto;
    }

    .apr-table table {
      width: 100%;
      border-collapse: collapse;
    }

    .apr-table th,
    .apr-table td {
      padding: 16px;
      text-align: left;
      border-bottom: 1px solid #e5e7eb;
    }

    .apr-table th {
      background: #f9fafb;
      font-weight: 700;
      color: #1f2937;
    }

    .apr-table tr:last-child td {
      border-bottom: none;
    }

    .apr-table td:last-child {
      font-weight: 600;
      color: #f97316;
    }

    /* FAQ Section */
    .faq {
      background: #f9fafb;
    }

    .faq-list {
      max-width: 800px;
      margin: 0 auto;
    }

    .faq-item {
      background: #ffffff;
      padding: 24px;
      margin-bottom: 16px;
      border-radius: 8px;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
    }

    .faq-item h3 {
      font-size: 1.125rem;
      font-weight: 700;
      margin-bottom: 12px;
      color: #1f2937;
    }

    .faq-item p {
      color: #4b5563;
      line-height: 1.7;
    }

    /* Footer */
    .footer {
      background: #1f2937;
      color: #d1d5db;
      padding: 40px 20px;
      text-align: center;
    }

    .footer-content {
      max-width: 800px;
      margin: 0 auto;
    }

    .footer p {
      font-size: 0.875rem;
      line-height: 1.8;
      margin-bottom: 16px;
    }

    .footer a {
      color: #f97316;
      text-decoration: none;
    }

    .footer a:hover {
      text-decoration: underline;
    }

    .footer-legal {
      margin-top: 24px;
      padding-top: 24px;
      border-top: 1px solid #374151;
      font-size: 0.75rem;
      color: #9ca3af;
    }

    /* Mobile Optimization */
    @media (max-width: 768px) {
      .hero h1 {
        font-size: 1.875rem;
      }

      .hero p {
        font-size: 1.125rem;
      }

      .hero-form {
        padding: 24px;
      }

      .section-title {
        font-size: 1.5rem;
      }

      .apr-table th,
      .apr-table td {
        padding: 12px;
        font-size: 0.875rem;
      }

      .badges-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>
<body>

  <!-- Hero Section -->
  <section class="hero">
    <div class="container">
      <h1>${site.h1}</h1>
      <p>${site.sub}</p>
      <div class="hero-form">
        <form onsubmit="handleZip(event)">
          <input
            type="text"
            id="zip"
            maxlength="5"
            placeholder="Enter ZIP Code"
            inputmode="numeric"
            pattern="\d{5}"
            required
          />
          <button type="submit">${site.cta}</button>
        </form>
        <p style="margin-top: 16px; font-size: 0.875rem; color: #6b7280;">${site.badge}</p>
      </div>
    </div>
  </section>

  <!-- Trust Badges -->
  <section class="trust-badges">
    <div class="container">
      <div class="badges-grid">
        <div class="badge-item">
          <div class="badge-icon">🔒</div>
          <h3>Bank-Level Security</h3>
          <p>256-bit SSL encryption protects your data</p>
        </div>
        <div class="badge-item">
          <div class="badge-icon">✓</div>
          <h3>No Credit Check</h3>
          <p>Checking rates won't affect your credit score</p>
        </div>
        <div class="badge-item">
          <div class="badge-icon">⚡</div>
          <h3>Fast Approval</h3>
          <p>Get approved in minutes, funds same day</p>
        </div>
      </div>
    </div>
  </section>

  <!-- APR Compliance Table -->
  <section class="section">
    <div class="container">
      <h2 class="section-title">Loan Details & APR Rates</h2>
      <div class="apr-table">
        <table>
          <thead>
            <tr>
              <th>Loan Amount</th>
              <th>Term Length</th>
              <th>APR Range</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>${site.amountMin} – $5,000</td>
              <td>6 – 36 months</td>
              <td>${site.aprMin}% – ${site.aprMax}%</td>
            </tr>
            <tr>
              <td>$5,001 – $15,000</td>
              <td>12 – 60 months</td>
              <td>${site.aprMin}% – ${site.aprMax}%</td>
            </tr>
            <tr>
              <td>$15,001 – ${site.amountMax}</td>
              <td>24 – 84 months</td>
              <td>${site.aprMin}% – ${site.aprMax}%</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="section faq">
    <div class="container">
      <h2 class="section-title">Frequently Asked Questions</h2>
      <div class="faq-list">
        <div class="faq-item">
          <h3>How fast can I get my loan?</h3>
          <p>Once approved, most customers receive their funds within 1 business day. In some cases, funds can be deposited the same day if approved before 2 PM ET on a business day.</p>
        </div>
        <div class="faq-item">
          <h3>Will checking my rate affect my credit score?</h3>
          <p>No. Checking your rate is a soft credit inquiry, which will not impact your credit score. Only when you formally apply and accept a loan offer will a hard inquiry be made.</p>
        </div>
        <div class="faq-item">
          <h3>What are the eligibility requirements?</h3>
          <p>You must be at least 18 years old, have a valid bank account, a verifiable source of income, and be a U.S. citizen or permanent resident. Specific requirements may vary by state.</p>
        </div>
        <div class="faq-item">
          <h3>Can I pay off my loan early?</h3>
          <p>Yes. There are no prepayment penalties. You can pay off your loan at any time without incurring additional fees, which can help you save on interest charges.</p>
        </div>
        <div class="faq-item">
          <h3>What can I use the loan for?</h3>
          <p>Personal loans can be used for a variety of purposes including debt consolidation, home improvements, medical expenses, major purchases, or unexpected emergencies.</p>
        </div>
        <div class="faq-item">
          <h3>How is my APR determined?</h3>
          <p>Your APR is based on several factors including your credit history, income, debt-to-income ratio, and loan amount. Borrowers with stronger credit profiles typically receive lower rates.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="footer">
    <div class="footer-content">
      <p><strong>Representative Example:</strong> Loan amounts range from ${site.amountMin} to ${site.amountMax}. APR ranges from ${site.aprMin}% to ${site.aprMax}%. Loan terms from 6 to 84 months. For example, a $10,000 loan at 12.99% APR for 36 months would have a monthly payment of approximately $337 and a total repayment amount of $12,132.</p>

      <p><strong>Important Disclosure:</strong> ${site.brand} is a loan matching service, not a direct lender. We connect borrowers with lending partners who may offer loan products. Loan approval and terms are subject to lender review and approval. Not all applicants will qualify. Rates, terms, and conditions vary by lender and borrower qualifications.</p>

      <p>Contact us: <a href="mailto:${site.email}">${site.email}</a> | <a href="tel:${site.phone}">${site.phone}</a></p>

      <div class="footer-legal">
        <p>&copy; 2026 ${site.brand}. All rights reserved. By using this site, you agree to our Terms of Service and Privacy Policy. Loans are subject to credit approval and state regulations. This is not an offer to lend. We do not guarantee loan approval or specific loan terms.</p>
      </div>
    </div>
  </footer>

  <script is:inline>
  function handleZip(e) {
    e.preventDefault();
    var zip = document.getElementById('zip').value.trim();
    if (!/^\d{5}$/.test(zip)) {
      alert('Please enter a valid 5-digit ZIP code');
      return;
    }
    var params = new URLSearchParams(window.location.search);
    params.set('zip', zip);
    window.location.href = '/apply?' + params.toString();
  }
  </script>

</body>
</html>
