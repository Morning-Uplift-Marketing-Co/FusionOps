---
const redirectUrl = import.meta.env.PUBLIC_REDIRECT_URL || '${redirectUrl}';

const steps = [
  {
    num: '01',
    title: 'Check eligibility in 60 seconds—no credit impact',
    desc: 'Share basic info and instantly see your financing options. We use a soft credit check that protects your credit score—check as many times as you need.',
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>`,
    accent: 'hsl(164 47% 34%)',
    accentBg: 'hsl(164 47% 34% / 0.12)',
  },
  {
    num: '02',
    title: 'Choose the plan that fits your budget',
    desc: 'View transparent payment options side by side. See the exact monthly payment, total cost, and APR upfront—including 0% APR plans for qualified applicants.',
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>`,
    accent: 'hsl(33 79% 57%)',
    accentBg: 'hsl(33 79% 57% / 0.15)',
  },
  {
    num: '03',
    title: 'Get care immediately—100% digital approval',
    desc: 'Once approved, your vet can start treatment right away. No forms to print, no waiting for approval. Everything happens digitally in real-time.',
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>`,
    accent: 'hsl(145 42% 44%)',
    accentBg: 'hsl(145 42% 44% / 0.12)',
  },
  {
    num: '04',
    title: 'Your pet heals—you pay over time',
    desc: 'Fixed monthly payments make budgeting simple. No surprises, no hidden fees, and you can pay early anytime without penalty. Your pet gets care today.',
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg>`,
    accent: 'hsl(164 47% 34%)',
    accentBg: 'hsl(164 47% 34% / 0.12)',
  },
];
---

<section id="how-it-works" class="py-20 md:py-28 px-6">
  <div class="max-w-6xl mx-auto">

    <div class="text-center mb-16">
      <span class="section-label">Pet Care Financing Made Simple</span>
      <h2 class="section-title max-w-xl mx-auto">How It Works</h2>
      <p class="text-foreground/70 text-base max-w-lg mx-auto">
        Four simple steps to affordable pet care. Fast approvals, transparent pricing, and flexible payment plans designed around your budget.
      </p>
    </div>

    <!-- Steps grid -->
    <div class="grid md:grid-cols-4 gap-4 relative">
      <!-- Connecting line (desktop) -->
      <div class="hidden md:block absolute top-[2.75rem] left-[12.5%] right-[12.5%] h-px pointer-events-none"
        style="background: linear-gradient(90deg, transparent, hsl(var(--border)), hsl(var(--border)), transparent);"></div>

      {steps.map((step, i) => (
        <div class={`premium-card p-6 flex flex-col gap-5 relative reveal${i === 1 ? ' reveal-d1' : i === 2 ? ' reveal-d2' : i === 3 ? ' reveal-d3' : ''}`}>
          <!-- Step number -->
          <div class="flex items-center justify-between">
            <div class="w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0"
              style={`background: ${step.accentBg}; color: ${step.accent};`}
              set:html={step.icon}
            />
            <span class="font-mono text-xs font-semibold tracking-widest"
              style={`color: ${step.accent}; opacity: 0.5;`}>{step.num}</span>
          </div>

          <div>
            <h3 class="font-display font-bold text-foreground text-base mb-2">{step.title}</h3>
            <p class="text-foreground/70 text-sm leading-relaxed">{step.desc}</p>
          </div>

          {i < 3 && (
            <div class="md:hidden h-px -mx-6 mt-auto" style="background: hsl(var(--border));"></div>
          )}
        </div>
      ))}
    </div>

    <!-- Bottom CTA strip -->
    <div class="mt-10 glass-card p-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div>
        <p class="font-display font-bold text-foreground text-base">Ready to give your pet the care they deserve?</p>
        <p class="text-foreground/70 text-sm">Check your options in 60 seconds—soft credit check only, zero impact on your score.</p>
      </div>
      <a href={redirectUrl} class="btn-primary flex-shrink-0">
        Check My Options →
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </div>
</section>
