---
// Footer พร้อม Modal สำหรับ Privacy Policy และ Terms of Service
interface Props {
  brand: string;
  phone: string;
  email: string;
}
const { brand = 'LoanMatch', phone = '1-800-555-0100', email = 'support@example.com' } = Astro.props;
const year = new Date().getFullYear();
---

<!-- Disclosure Section -->
<section class="bg-gray-50 border-t border-gray-200 py-10">
  <div class="max-w-4xl mx-auto px-4">
    <h3 class="text-sm font-semibold text-gray-600 uppercase tracking-wider mb-4">Important Disclosures</h3>
    <div class="space-y-3 text-xs text-gray-500 leading-relaxed">
      <p>
        <strong>{brand}</strong> is a loan referral service, not a lender. We connect consumers with a network of licensed lenders.
        We do not make credit decisions or set loan terms. Submission of your information does not guarantee you will be matched with a lender or approved for a loan.
      </p>
      <p>
        Loan amounts, interest rates, fees, and terms are set solely by the lender and may vary based on your creditworthiness, income, and other factors.
        APRs typically range from {brand === 'LoanMatch' ? '5.99%' : 'our minimum'} to 35.99%. Loan terms typically range from 12 to 84 months.
        Example: A $10,000 loan at 15% APR for 36 months results in monthly payments of approximately $347. Total repayment: $12,487.
      </p>
      <p>
        Not all lenders in our network can provide loans up to the advertised amount. Not all applicants will qualify for loan offers.
        Completing our form does not obligate you to accept any offer. There is no fee to use our matching service.
      </p>
      <p>
        We may receive compensation from lenders when consumers are connected or complete transactions.
        This compensation may affect which lenders are presented to you. We encourage you to review multiple offers.
      </p>
    </div>
  </div>
</section>

<!-- Footer Navigation -->
<footer class="bg-foreground text-white py-10">
  <div class="max-w-6xl mx-auto px-4">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-8 mb-8">
      <!-- Brand -->
      <div>
        <div class="text-xl font-bold mb-2">{brand}</div>
        <p class="text-gray-400 text-sm max-w-xs">
          Connecting you with financial options from our network of trusted lenders.
        </p>
      </div>

      <!-- Contact -->
      <div class="text-sm space-y-2">
        <div class="text-gray-300 font-medium mb-1">Contact Us</div>
        <a href={`tel:${phone}`} class="flex items-center gap-2 text-gray-400 hover:text-white transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          {phone}
        </a>
        <a href={`mailto:${email}`} class="flex items-center gap-2 text-gray-400 hover:text-white transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          {email}
        </a>
      </div>
    </div>

    <!-- Legal Links -->
    <div class="border-t border-gray-700 pt-6 flex flex-col sm:flex-row justify-between items-center gap-4">
      <p class="text-xs text-gray-500">
        &copy; {year} {brand}. All rights reserved. This is an advertisement.
      </p>
      <div class="flex gap-5 text-xs">
        <!-- เปิด Privacy Policy Modal -->
        <button
          id="open-privacy"
          class="text-gray-400 hover:text-white transition-colors underline underline-offset-2 cursor-pointer"
        >
          Privacy Policy
        </button>
        <!-- เปิด Terms Modal -->
        <button
          id="open-terms"
          class="text-gray-400 hover:text-white transition-colors underline underline-offset-2 cursor-pointer"
        >
          Terms of Service
        </button>
        <a href="#" class="text-gray-400 hover:text-white transition-colors">Do Not Sell My Info</a>
      </div>
    </div>
  </div>
</footer>

<!-- Privacy Policy Modal -->
<div
  id="modal-privacy"
  class="fixed inset-0 z-50 flex items-center justify-center p-4 opacity-0 pointer-events-none modal-overlay"
  role="dialog"
  aria-modal="true"
  aria-labelledby="privacy-title"
>
  <div class="absolute inset-0 bg-black/60" id="modal-privacy-backdrop"></div>
  <div class="relative bg-white rounded-xl shadow-2xl max-w-2xl w-full max-h-[80vh] flex flex-col modal-content scale-95 opacity-0">
    <div class="flex justify-between items-center px-6 py-4 border-b border-gray-100">
      <h2 id="privacy-title" class="text-lg font-bold text-foreground">Privacy Policy</h2>
      <button id="close-privacy" class="text-gray-400 hover:text-gray-700 transition-colors p-1 rounded-full hover:bg-gray-100" aria-label="Close">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
        </svg>
      </button>
    </div>
    <div class="overflow-y-auto px-6 py-5 text-sm text-gray-600 space-y-4 no-scrollbar">
      <p><strong>Last Updated: January 1, {year}</strong></p>
      <p>
        {brand} ("we," "us," or "our") is committed to protecting your personal information.
        This Privacy Policy explains how we collect, use, disclose, and safeguard your data when you use our service.
      </p>
      <h3 class="font-semibold text-foreground">Information We Collect</h3>
      <p>We collect information you provide, including your name, contact details, financial information, and zip code to match you with appropriate lenders in your area.</p>
      <h3 class="font-semibold text-foreground">How We Use Your Information</h3>
      <p>Your information is used to connect you with lenders in our network, improve our service, communicate with you, and comply with legal obligations.</p>
      <h3 class="font-semibold text-foreground">Information Sharing</h3>
      <p>We share your information with lenders in our network for the purpose of matching you with loan offers. We do not sell your personal data to third-party marketers.</p>
      <h3 class="font-semibold text-foreground">Your Rights</h3>
      <p>You have the right to access, correct, or delete your personal information. Contact us at {email} to exercise these rights.</p>
      <h3 class="font-semibold text-foreground">Security</h3>
      <p>We use industry-standard 256-bit SSL encryption to protect your data in transit and at rest.</p>
      <h3 class="font-semibold text-foreground">Contact</h3>
      <p>For privacy inquiries, contact us at {email} or {phone}.</p>
    </div>
    <div class="px-6 py-4 border-t border-gray-100">
      <button id="close-privacy-btn" class="w-full bg-primary text-white rounded-lg py-2.5 font-medium hover:bg-primary/90 transition-colors">Close</button>
    </div>
  </div>
</div>

<!-- Terms of Service Modal -->
<div
  id="modal-terms"
  class="fixed inset-0 z-50 flex items-center justify-center p-4 opacity-0 pointer-events-none modal-overlay"
  role="dialog"
  aria-modal="true"
  aria-labelledby="terms-title"
>
  <div class="absolute inset-0 bg-black/60" id="modal-terms-backdrop"></div>
  <div class="relative bg-white rounded-xl shadow-2xl max-w-2xl w-full max-h-[80vh] flex flex-col modal-content scale-95 opacity-0">
    <div class="flex justify-between items-center px-6 py-4 border-b border-gray-100">
      <h2 id="terms-title" class="text-lg font-bold text-foreground">Terms of Service</h2>
      <button id="close-terms" class="text-gray-400 hover:text-gray-700 transition-colors p-1 rounded-full hover:bg-gray-100" aria-label="Close">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
        </svg>
      </button>
    </div>
    <div class="overflow-y-auto px-6 py-5 text-sm text-gray-600 space-y-4 no-scrollbar">
      <p><strong>Last Updated: January 1, {year}</strong></p>
      <p>By using the {brand} service, you agree to these Terms of Service. Please read them carefully.</p>
      <h3 class="font-semibold text-foreground">Service Description</h3>
      <p>{brand} is a loan referral and matching service. We are not a lender, broker, or financial advisor. We connect consumers with third-party lenders.</p>
      <h3 class="font-semibold text-foreground">No Guarantee of Loan Approval</h3>
      <p>Submitting your information through our service does not guarantee you will receive a loan offer or be approved for financing. All credit decisions are made solely by the lender.</p>
      <h3 class="font-semibold text-foreground">Eligibility</h3>
      <p>You must be at least 18 years of age, a U.S. citizen or permanent resident, and have a valid bank account to use this service.</p>
      <h3 class="font-semibold text-foreground">Accuracy of Information</h3>
      <p>You agree to provide accurate and truthful information. Providing false information may result in loan denial and potential legal consequences.</p>
      <h3 class="font-semibold text-foreground">Disclaimer</h3>
      <p>The service is provided "as is." We make no warranties regarding matching outcomes, loan terms, or lender availability in your area.</p>
      <h3 class="font-semibold text-foreground">Contact</h3>
      <p>For questions about these terms, contact us at {email}.</p>
    </div>
    <div class="px-6 py-4 border-t border-gray-100">
      <button id="close-terms-btn" class="w-full bg-primary text-white rounded-lg py-2.5 font-medium hover:bg-primary/90 transition-colors">Close</button>
    </div>
  </div>
</div>

<script>
  // ฟังก์ชันจัดการ Modal แบบ Lightweight ไม่ต้องพึ่ง library ภายนอก
  function setupModal(openId: string, closeIds: string[], modalId: string) {
    const openBtn = document.getElementById(openId);
    const modal = document.getElementById(modalId);
    const content = modal?.querySelector('.modal-content') as HTMLElement | null;

    // ฟังก์ชันเปิด Modal พร้อม animation
    function openModal() {
      if (!modal || !content) return;
      modal.classList.remove('opacity-0', 'pointer-events-none');
      modal.classList.add('opacity-100');
      requestAnimationFrame(() => {
        content.classList.remove('scale-95', 'opacity-0');
        content.classList.add('scale-100', 'opacity-100');
      });
      document.body.style.overflow = 'hidden';
    }

    // ฟังก์ชันปิด Modal พร้อม animation
    function closeModal() {
      if (!modal || !content) return;
      content.classList.remove('scale-100', 'opacity-100');
      content.classList.add('scale-95', 'opacity-0');
      setTimeout(() => {
        modal.classList.remove('opacity-100');
        modal.classList.add('opacity-0', 'pointer-events-none');
        document.body.style.overflow = '';
      }, 250);
    }

    openBtn?.addEventListener('click', openModal);

    // ผูก event กับปุ่มปิดทุกปุ่ม
    closeIds.forEach(id => {
      document.getElementById(id)?.addEventListener('click', closeModal);
    });

    // ปิด Modal เมื่อคลิก backdrop
    const backdrop = modal?.querySelector('[id$="-backdrop"]');
    backdrop?.addEventListener('click', closeModal);

    // ปิด Modal เมื่อกด Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal?.classList.contains('pointer-events-none')) {
        closeModal();
      }
    });
  }

  // เริ่มต้น setup modal ทั้งสองอัน
  setupModal('open-privacy', ['close-privacy', 'close-privacy-btn'], 'modal-privacy');
  setupModal('open-terms', ['close-terms', 'close-terms-btn'], 'modal-terms');
</script>
