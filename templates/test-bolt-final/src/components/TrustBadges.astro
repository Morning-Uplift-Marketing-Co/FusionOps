---
// คอมโพเนนต์แสดง Trust Badges และ Social Proof เพื่อสร้างความน่าเชื่อถือ
---
<section class="bg-white border-b border-gray-100 py-8">
  <div class="max-w-6xl mx-auto px-4">
    <!-- แถวที่ 1: ตัวเลขสถิติ -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center mb-8">
      <div class="flex flex-col items-center">
        <span class="text-2xl md:text-3xl font-bold text-primary">500K+</span>
        <span class="text-sm text-gray-500 mt-1">Applications Reviewed</span>
      </div>
      <div class="flex flex-col items-center">
        <span class="text-2xl md:text-3xl font-bold text-primary">300+</span>
        <span class="text-sm text-gray-500 mt-1">Lending Partners</span>
      </div>
      <div class="flex flex-col items-center">
        <span class="text-2xl md:text-3xl font-bold text-primary">4.8★</span>
        <span class="text-sm text-gray-500 mt-1">Average Rating</span>
      </div>
      <div class="flex flex-col items-center">
        <span class="text-2xl md:text-3xl font-bold text-primary">256-bit</span>
        <span class="text-sm text-gray-500 mt-1">SSL Encryption</span>
      </div>
    </div>

    <!-- แถวที่ 2: Badge icons -->
    <div class="flex flex-wrap justify-center items-center gap-6 md:gap-10">
      <!-- Secure SSL Badge -->
      <div class="flex items-center gap-2 text-gray-500">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
        </svg>
        <span class="text-sm font-medium">Secure & Encrypted</span>
      </div>

      <!-- No Hard Pull Badge -->
      <div class="flex items-center gap-2 text-gray-500">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span class="text-sm font-medium">No Hard Credit Pull</span>
      </div>

      <!-- Free to Use Badge -->
      <div class="flex items-center gap-2 text-gray-500">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span class="text-sm font-medium">Results in Minutes</span>
      </div>

      <!-- Privacy Badge -->
      <div class="flex items-center gap-2 text-gray-500">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3" />
        </svg>
        <span class="text-sm font-medium">Privacy Protected</span>
      </div>

      <!-- BBB-style Badge -->
      <div class="flex items-center gap-2 text-gray-500">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
        </svg>
        <span class="text-sm font-medium">Accredited Service</span>
      </div>
    </div>
  </div>
</section>
