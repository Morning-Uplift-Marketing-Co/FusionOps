---
const year = new Date().getFullYear();
---
<footer class="bg-gray-950 text-gray-400">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 pb-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 mb-12">

      <!-- Brand -->
      <div>
        <a href="#" class="flex items-center gap-2 mb-4">
          <div class="w-9 h-9 bg-teal-700 rounded-xl flex items-center justify-center">
            <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M4.5 11a2.5 2.5 0 100-5 2.5 2.5 0 000 5zm0-3.5a1 1 0 110 2 1 1 0 010-2zM9 9.5A2.5 2.5 0 1114 9.5a2.5 2.5 0 01-5 0zm2.5-1a1 1 0 110 2 1 1 0 010-2zM16 11.5a2.5 2.5 0 100-5 2.5 2.5 0 000 5zm0-3.5a1 1 0 110 2 1 1 0 010-2zM12 14c-4 0-6 2-6 3v1h12v-1c0-1-2-3-6-3z"/></svg>
          </div>
          <span class="text-xl font-bold text-white tracking-tight">Bear<span class="text-teal-400">Loan</span>Now</span>
        </a>
        <p class="text-sm leading-relaxed text-gray-400 mb-5">Flexible payment plans and installment loans for pet care expenses. Helping pet owners get the care their animals deserve without financial stress.</p>
        <div class="flex items-center gap-3">
          <a href="#" aria-label="Facebook" class="w-9 h-9 bg-gray-800 hover:bg-teal-700 rounded-lg flex items-center justify-center transition-colors">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/></svg>
          </a>
          <a href="#" aria-label="Twitter" class="w-9 h-9 bg-gray-800 hover:bg-teal-700 rounded-lg flex items-center justify-center transition-colors">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M23 3a10.9 10.9 0 01-3.14 1.53 4.48 4.48 0 00-7.86 3v1A10.66 10.66 0 013 4s-4 9 5 13a11.64 11.64 0 01-7 2c9 5 20 0 20-11.5a4.5 4.5 0 00-.08-.83A7.72 7.72 0 0023 3z"/></svg>
          </a>
          <a href="#" aria-label="LinkedIn" class="w-9 h-9 bg-gray-800 hover:bg-teal-700 rounded-lg flex items-center justify-center transition-colors">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6zM2 9h4v12H2z"/><circle cx="4" cy="4" r="2"/></svg>
          </a>
        </div>
      </div>

      <!-- For Pet Parents -->
      <div>
        <h4 class="text-white font-semibold text-sm mb-4 uppercase tracking-wider">For Pet Parents</h4>
        <ul class="space-y-2.5 text-sm">
          <li><a href="#how-it-works" class="hover:text-teal-400 transition-colors">How It Works</a></li>
          <li><a href="#features" class="hover:text-teal-400 transition-colors">Payment Options</a></li>
          <li><a href="#expenses" class="hover:text-teal-400 transition-colors">Eligible Expenses</a></li>
          <li><a href="#faq" class="hover:text-teal-400 transition-colors">FAQ</a></li>
          <li><a href="#apply" class="hover:text-teal-400 transition-colors">Check Eligibility</a></li>
        </ul>
      </div>

      <!-- Support -->
      <div>
        <h4 class="text-white font-semibold text-sm mb-4 uppercase tracking-wider">Support</h4>
        <ul class="space-y-3 text-sm">
          <li class="flex items-center gap-2.5">
            <svg class="w-3.5 h-3.5 text-teal-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            <a href="mailto:support@bearloannow.com" class="hover:text-teal-400 transition-colors">support@bearloannow.com</a>
          </li>
          <li class="flex items-start gap-2.5">
            <svg class="w-3.5 h-3.5 mt-0.5 text-teal-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <span>Mon–Fri: 8:00 AM – 8:00 PM EST<br />Sat: 9:00 AM – 5:00 PM EST</span>
          </li>
        </ul>
      </div>

      <!-- Legal -->
      <div>
        <h4 class="text-white font-semibold text-sm mb-4 uppercase tracking-wider">Legal</h4>
        <ul class="space-y-2.5 text-sm">
          <li><a href="#" class="hover:text-teal-400 transition-colors">About Us</a></li>
          <li><a href="#" class="hover:text-teal-400 transition-colors">Privacy Policy</a></li>
          <li><a href="#" class="hover:text-teal-400 transition-colors">Terms of Service</a></li>
          <li><a href="#" class="hover:text-teal-400 transition-colors">Disclosures</a></li>
        </ul>
      </div>
    </div>

    <div class="border-t border-gray-800 pt-8">
      <div class="bg-gray-900 rounded-xl p-5 mb-8 text-xs text-gray-500 leading-relaxed">
        <strong class="text-gray-400 block mb-1">Important Disclosures</strong>
        BearLoanNow offers loan amounts from $200 to $10,000 with APR ranging from 0% to 35.99% and repayment terms of 61 to 2,190 days. Not all applicants will qualify for the lowest rates or highest loan amounts. Loan availability and terms vary by state. A soft credit inquiry is used during the application process and does not impact your credit score. This is not a commitment to lend. All loans are subject to credit approval. BearLoanNow is not a bank. Loans are provided by third-party lenders and are subject to lender approval.
      </div>
      <div class="flex flex-col md:flex-row items-center justify-between gap-4">
        <p class="text-xs text-gray-600">&copy; {year} BearLoanNow. All rights reserved.</p>
        <div class="flex flex-wrap items-center gap-5 text-xs">
          <a href="#" class="text-gray-600 hover:text-gray-400 transition-colors">Privacy Policy</a>
          <a href="#" class="text-gray-600 hover:text-gray-400 transition-colors">Terms of Service</a>
          <a href="#" class="text-gray-600 hover:text-gray-400 transition-colors">Licensing Disclosures</a>
          <a href="#" class="text-gray-600 hover:text-gray-400 transition-colors">Do Not Sell My Info</a>
        </div>
      </div>
    </div>
  </div>
</footer>
