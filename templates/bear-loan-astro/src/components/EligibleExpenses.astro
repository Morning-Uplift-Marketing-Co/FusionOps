---
---
<section id="expenses" class="py-20 lg:py-28 bg-amber-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-14">
      <span class="inline-block text-amber-700 font-semibold text-sm uppercase tracking-widest mb-3">What's Covered</span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-gray-900 mb-4">Eligible Pet Care Expenses</h2>
      <p class="text-lg text-gray-500">BearLoanNow financing covers a wide range of veterinary and pet care needs — from routine visits to emergency surgeries.</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {[
        { icon: 'M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z', title: 'Emergency Care', desc: 'Unexpected accidents, injuries, or sudden illness requiring immediate veterinary attention.' },
        { icon: 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4', title: 'Routine & Preventive Care', desc: 'Annual wellness exams, vaccinations, heartworm testing, and flea/tick prevention.' },
        { icon: 'M14.121 14.121L19 19m-7-7l7-7m-7 7l-2.879 2.879M12 12L9.121 9.121m0 5.758a3 3 0 10-4.243 4.243 3 3 0 004.243-4.243zm0-5.758a3 3 0 10-4.243-4.243 3 3 0 004.243 4.243z', title: 'Surgical Procedures', desc: 'Orthopedic surgeries, soft tissue operations, tumor removal, and spay/neuter procedures.' },
        { icon: 'M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z', title: 'Dental Procedures', desc: 'Professional dental cleaning, tooth extractions, oral surgery, and gum disease treatment.' },
        { icon: 'M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z', title: 'Medications', desc: 'Prescription medications, long-term treatment drugs, supplements, and specialty medications.' },
        { icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z', title: 'Specialist Visits', desc: 'Cardiology, oncology, dermatology, ophthalmology, and other veterinary specialist consultations.' },
        { icon: 'M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z', title: 'Diagnostics & Labs', desc: 'X-rays, MRIs, CT scans, bloodwork, urinalysis, biopsies, and other diagnostic testing.' },
        { icon: 'M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z', title: 'Rehabilitation', desc: 'Physical therapy, hydrotherapy, acupuncture, laser therapy, and post-surgical recovery care.' },
      ].map(item => (
        <div class="group bg-white rounded-2xl p-6 shadow-sm border border-amber-100 hover:shadow-md hover:-translate-y-1 transition-all duration-300">
          <div class="w-12 h-12 bg-amber-100 group-hover:bg-amber-200 rounded-2xl flex items-center justify-center mb-4 transition-colors">
            <svg class="w-6 h-6 text-amber-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.icon}/></svg>
          </div>
          <h3 class="font-bold text-gray-900 mb-2">{item.title}</h3>
          <p class="text-gray-500 text-sm leading-relaxed">{item.desc}</p>
        </div>
      ))}
    </div>

    <div class="mt-12 bg-gradient-to-r from-teal-700 to-teal-800 rounded-2xl p-8 md:p-10 text-center shadow-lg">
      <p class="text-white text-lg font-semibold mb-2">Not sure if your pet's care qualifies?</p>
      <p class="text-teal-200 mb-6 text-sm max-w-xl mx-auto">Most veterinary and animal care expenses are eligible. Apply in 3 minutes with no commitment and no impact on your credit score.</p>
      <a href="#apply" class="inline-flex items-center gap-2 bg-amber-500 hover:bg-amber-400 text-white font-bold px-8 py-3.5 rounded-xl shadow-lg hover:shadow-xl transition-all duration-200">
        Check My Eligibility — Free
      </a>
    </div>
  </div>
</section>
