---
interface Props {
  aid?: string;
  conversionId?: string;
  formStartLabel?: string;
  formSubmitLabel?: string;
  voluumDomain?: string;
  voluumClickUrl?: string;
}
const { aid = '', conversionId = '', formStartLabel = '', formSubmitLabel = '', voluumDomain = '', voluumClickUrl = '' } = Astro.props;
const ctaUrl = voluumClickUrl || '/apply';
---

<section id="apply" class="relative overflow-hidden">
  <!-- Background gradient -->
  <div class="absolute inset-0" style="background:linear-gradient(135deg,#0f4c4c 0%,#0d6e6e 40%,#0e7f74 70%,#1a6a5a 100%)"></div>
  <!-- Pattern overlay -->
  <div class="absolute inset-0 opacity-10" style="background-image:url(\"data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='1'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E\")"></div>
  <!-- Glow orbs -->
  <div class="absolute top-20 right-0 w-96 h-96 bg-teal-400 rounded-full opacity-5 blur-3xl translate-x-1/2"></div>
  <div class="absolute bottom-0 left-0 w-80 h-80 bg-amber-400 rounded-full opacity-5 blur-3xl -translate-x-1/2"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-20 pb-24 md:pt-28 md:pb-32">
    <div class="max-w-3xl">
      <!-- Badge -->
      <div class="inline-flex items-center gap-2 bg-white/10 border border-white/20 rounded-full px-4 py-1.5 mb-6">
        <span class="flex h-2 w-2 relative">
          <span class="animate-ping absolute inline-flex h-2 w-2 rounded-full bg-amber-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-amber-400"></span>
        </span>
        <span class="text-white/90 text-sm font-medium">Pet Care Financing — 0% APR Available</span>
      </div>

      <!-- Headline -->
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white leading-tight mb-6">
        Your Pet Deserves the <span class="text-amber-400">Best Care.</span><br />
        We Make It Affordable.
      </h1>

      <p class="text-lg sm:text-xl text-teal-100 leading-relaxed mb-10 max-w-2xl">
        Flexible installment loans from <strong class="text-white">$200 to $10,000</strong> for veterinary and pet care expenses. No hard credit check, instant approval decisions, and funds as soon as the next business day.
      </p>

      <!-- ZIP Form -->
      <div class="mb-14">
        <form id="hero-form" class="flex flex-col gap-2 max-w-sm">
          <div class="flex items-stretch shadow-xl rounded-xl overflow-hidden">
            <div class="relative flex-1">
              <svg class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              <input
                id="zip-input"
                type="text"
                inputmode="numeric"
                placeholder="Enter ZIP Code"
                maxlength="5"
                aria-label="ZIP code"
                class="w-full h-full pl-9 pr-4 py-4 text-gray-900 font-semibold text-base placeholder-gray-400 focus:outline-none bg-white"
              />
            </div>
            <button type="submit" class="bg-amber-500 hover:bg-amber-400 active:scale-95 text-white font-bold text-base px-6 py-4 transition-all duration-200 whitespace-nowrap">
              Check My Rate
            </button>
          </div>
          <p id="zip-error" class="text-red-300 text-xs font-medium pl-1 hidden"></p>
          <p class="text-teal-200/70 text-xs pl-1">No hard credit check &middot; Instant decision</p>
        </form>
      </div>

      <!-- Trust badges -->
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-3">
        <div class="bg-white/10 backdrop-blur-sm border border-white/15 rounded-xl p-4 hover:bg-white/15 transition-colors">
          <svg class="w-5 h-5 text-amber-400 mb-2" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
          <div class="text-white font-semibold text-sm">4.9/5 Stars</div>
          <div class="text-teal-200 text-xs mt-0.5">2,400+ Reviews</div>
        </div>
        <div class="bg-white/10 backdrop-blur-sm border border-white/15 rounded-xl p-4 hover:bg-white/15 transition-colors">
          <svg class="w-5 h-5 text-amber-400 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
          <div class="text-white font-semibold text-sm">No Hard Credit Check</div>
          <div class="text-teal-200 text-xs mt-0.5">Soft pull only</div>
        </div>
        <div class="bg-white/10 backdrop-blur-sm border border-white/15 rounded-xl p-4 hover:bg-white/15 transition-colors">
          <svg class="w-5 h-5 text-amber-400 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
          <div class="text-white font-semibold text-sm">Instant Decision</div>
          <div class="text-teal-200 text-xs mt-0.5">Approved in seconds</div>
        </div>
        <div class="bg-white/10 backdrop-blur-sm border border-white/15 rounded-xl p-4 hover:bg-white/15 transition-colors">
          <svg class="w-5 h-5 text-amber-400 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <div class="text-white font-semibold text-sm">$200 – $10,000</div>
          <div class="text-teal-200 text-xs mt-0.5">Flexible loan amounts</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Wave divider -->
  <div class="absolute bottom-0 left-0 right-0">
    <svg viewBox="0 0 1440 60" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full">
      <path d="M0 60L1440 60L1440 0C1200 50 800 60 720 60C640 60 240 50 0 0L0 60Z" fill="#f8fafc"/>
    </svg>
  </div>
</section>

<script is:inline define:vars={{ ctaUrl, conversionId, formStartLabel, formSubmitLabel }}>
  var _formStarted = false;
  function fireFormStart() {
    if (_formStarted) return;
    _formStarted = true;
    if (conversionId && formStartLabel && typeof gtag === 'function')
      gtag('event', 'conversion', { send_to: conversionId + '/' + formStartLabel });
    if (window.pixel) window.pixel('fs');
  }

  var zipInput = document.getElementById('zip-input');
  var zipError = document.getElementById('zip-error');

  zipInput.addEventListener('focus', fireFormStart);
  zipInput.addEventListener('input', function() {
    this.value = this.value.replace(/\D/g,'').slice(0,5);
    if (zipError) zipError.classList.add('hidden');
    if (this.value.length === 5 && window.pixel) window.pixel('ze', { zip: this.value });
  });

  document.getElementById('hero-form').addEventListener('submit', function(e) {
    e.preventDefault();
    var zip = zipInput.value;
    if (!/^\d{5}$/.test(zip)) {
      zipError.textContent = 'Please enter a valid 5-digit ZIP code';
      zipError.classList.remove('hidden');
      return;
    }
    if (window.pixel) window.pixel('cta', { zip: zip });
    sessionStorage.setItem('zip', zip);
    if (conversionId && formSubmitLabel && typeof gtag === 'function')
      gtag('event', 'conversion', { send_to: conversionId + '/' + formSubmitLabel });
    window.location.href = ctaUrl + (ctaUrl.includes('?') ? '&' : '?') + 'zip=' + zip;
  });
</script>
