---
---
<section id="how-it-works" class="py-20 lg:py-28 bg-slate-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-14">
      <span class="inline-block text-teal-700 font-semibold text-sm uppercase tracking-widest mb-3">Simple Process</span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-gray-900 mb-4">How It Works</h2>
      <p class="text-lg text-gray-500">Getting financing for your pet's care is quick, easy, and stress-free.</p>
    </div>

    <div class="relative">
      <!-- Connector line desktop -->
      <div class="hidden lg:block absolute top-16 left-[calc(16.66%+2rem)] right-[calc(16.66%+2rem)] h-0.5 bg-gradient-to-r from-teal-200 via-teal-400 to-teal-200 z-0"></div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 relative z-10">
        <!-- Step 1 -->
        <div class="bg-white rounded-2xl p-8 shadow-sm border border-gray-100 hover:shadow-lg hover:-translate-y-1 transition-all duration-300 h-full flex flex-col">
          <div class="flex items-start gap-4 mb-5">
            <div class="relative">
              <div class="w-14 h-14 bg-teal-50 rounded-2xl flex items-center justify-center shrink-0">
                <svg class="w-7 h-7 text-teal-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
              </div>
              <span class="absolute -top-2 -right-2 w-6 h-6 bg-teal-700 text-white text-xs font-bold rounded-full flex items-center justify-center">1</span>
            </div>
            <div>
              <span class="text-xs font-bold text-teal-600 uppercase tracking-wider">01</span>
              <h3 class="text-xl font-bold text-gray-900">Apply Online</h3>
            </div>
          </div>
          <p class="text-gray-500 leading-relaxed flex-1 mb-5">Fill out our simple, 3-minute application. Tell us about yourself and how much you need. No paperwork, no fax, no branch visit required.</p>
          <div class="inline-flex items-center gap-1.5 bg-amber-50 text-amber-700 text-xs font-semibold px-3 py-1.5 rounded-full self-start">
            <span class="w-1.5 h-1.5 bg-amber-500 rounded-full"></span>Takes about 3 minutes
          </div>
        </div>

        <!-- Step 2 -->
        <div class="bg-white rounded-2xl p-8 shadow-sm border border-gray-100 hover:shadow-lg hover:-translate-y-1 transition-all duration-300 h-full flex flex-col">
          <div class="flex items-start gap-4 mb-5">
            <div class="relative">
              <div class="w-14 h-14 bg-teal-50 rounded-2xl flex items-center justify-center shrink-0">
                <svg class="w-7 h-7 text-teal-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              </div>
              <span class="absolute -top-2 -right-2 w-6 h-6 bg-teal-700 text-white text-xs font-bold rounded-full flex items-center justify-center">2</span>
            </div>
            <div>
              <span class="text-xs font-bold text-teal-600 uppercase tracking-wider">02</span>
              <h3 class="text-xl font-bold text-gray-900">Get an Instant Decision</h3>
            </div>
          </div>
          <p class="text-gray-500 leading-relaxed flex-1 mb-5">We use a soft credit check that has zero impact on your credit score. Most applicants receive an approval decision within seconds.</p>
          <div class="inline-flex items-center gap-1.5 bg-amber-50 text-amber-700 text-xs font-semibold px-3 py-1.5 rounded-full self-start">
            <span class="w-1.5 h-1.5 bg-amber-500 rounded-full"></span>Decision in seconds
          </div>
        </div>

        <!-- Step 3 -->
        <div class="bg-white rounded-2xl p-8 shadow-sm border border-gray-100 hover:shadow-lg hover:-translate-y-1 transition-all duration-300 h-full flex flex-col">
          <div class="flex items-start gap-4 mb-5">
            <div class="relative">
              <div class="w-14 h-14 bg-teal-50 rounded-2xl flex items-center justify-center shrink-0">
                <svg class="w-7 h-7 text-teal-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
              </div>
              <span class="absolute -top-2 -right-2 w-6 h-6 bg-teal-700 text-white text-xs font-bold rounded-full flex items-center justify-center">3</span>
            </div>
            <div>
              <span class="text-xs font-bold text-teal-600 uppercase tracking-wider">03</span>
              <h3 class="text-xl font-bold text-gray-900">Access Your Funds</h3>
            </div>
          </div>
          <p class="text-gray-500 leading-relaxed flex-1 mb-5">Once approved, funds are deposited directly to your account as soon as the next business day — so you can focus on your pet, not paperwork.</p>
          <div class="inline-flex items-center gap-1.5 bg-amber-50 text-amber-700 text-xs font-semibold px-3 py-1.5 rounded-full self-start">
            <span class="w-1.5 h-1.5 bg-amber-500 rounded-full"></span>Funds next business day
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
