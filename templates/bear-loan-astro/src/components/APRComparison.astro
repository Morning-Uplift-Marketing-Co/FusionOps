<section class="py-20 lg:py-28 bg-gray-50">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <span class="inline-block text-teal-700 font-semibold text-sm uppercase tracking-widest mb-3">Rate Comparison</span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-gray-900 mb-4">See How We Compare</h2>
      <p class="text-gray-500 text-lg">Based on a representative example of a $5,000 loan over 60 months.</p>
    </div>

    <div class="overflow-x-auto rounded-2xl shadow-lg border border-gray-200">
      <table class="w-full text-sm">
        <thead>
          <tr class="bg-gray-900 text-white">
            <th class="text-left px-6 py-4 font-semibold text-gray-300 w-48">Lender</th>
            <th class="text-center px-4 py-4 font-semibold text-gray-300">APR Range</th>
            <th class="text-center px-4 py-4 font-semibold text-gray-300">Monthly Payment<div class="text-gray-500 font-normal text-xs">$5,000 / 60 mo</div></th>
            <th class="text-center px-4 py-4 font-semibold text-gray-300">Total Repayable</th>
            <th class="text-center px-4 py-4 font-semibold text-gray-300">No Hard Pull</th>
            <th class="text-center px-4 py-4 font-semibold text-gray-300">Pet-Specific</th>
            <th class="text-center px-4 py-4 font-semibold text-gray-300">Same-Day Fund</th>
          </tr>
        </thead>
        <tbody>
          <!-- BearLoanNow row (highlighted) -->
          <tr class="border-t border-gray-100 bg-teal-50 border-l-4 border-l-teal-600">
            <td class="px-6 py-5"><div class="font-bold text-teal-800">BearLoanNow <span class="ml-2 inline-block bg-amber-500 text-white text-xs font-semibold px-2 py-0.5 rounded-full">Best Value</span></div><div class="text-gray-400 text-xs mt-0.5">Representative example</div></td>
            <td class="px-4 py-5 text-center"><span class="font-bold text-base text-teal-700">0%–35.99%</span><div class="text-gray-400 text-xs mt-0.5">repr. 9.99% APR</div></td>
            <td class="px-4 py-5 text-center"><span class="font-extrabold text-lg text-amber-500">$106.24</span></td>
            <td class="px-4 py-5 text-center"><span class="font-semibold text-teal-700">$6,374.40</span></td>
            <td class="px-4 py-5 text-center"><svg class="w-5 h-5 mx-auto text-teal-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg></td>
            <td class="px-4 py-5 text-center"><svg class="w-5 h-5 mx-auto text-teal-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg></td>
            <td class="px-4 py-5 text-center"><svg class="w-5 h-5 mx-auto text-teal-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg></td>
          </tr>
          <!-- Personal Bank -->
          <tr class="border-t border-gray-100 bg-white hover:bg-gray-50">
            <td class="px-6 py-5"><div class="font-bold text-gray-800">Personal Bank Loan</div><div class="text-gray-400 text-xs mt-0.5">Typical bank rate</div></td>
            <td class="px-4 py-5 text-center"><span class="font-bold text-base text-gray-700">10.99%–24.99%</span><div class="text-gray-400 text-xs mt-0.5">repr. 18.0% APR</div></td>
            <td class="px-4 py-5 text-center"><span class="font-extrabold text-lg text-gray-800">$127.16</span></td>
            <td class="px-4 py-5 text-center"><span class="font-semibold text-gray-700">$7,629.60</span></td>
            <td class="px-4 py-5 text-center"><svg class="w-5 h-5 mx-auto text-red-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/></svg></td>
            <td class="px-4 py-5 text-center"><svg class="w-5 h-5 mx-auto text-red-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/></svg></td>
            <td class="px-4 py-5 text-center"><svg class="w-5 h-5 mx-auto text-red-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/></svg></td>
          </tr>
          <!-- Credit Card -->
          <tr class="border-t border-gray-100 bg-white hover:bg-gray-50">
            <td class="px-6 py-5"><div class="font-bold text-gray-800">Credit Card (Avg.)</div><div class="text-gray-400 text-xs mt-0.5">National average APR</div></td>
            <td class="px-4 py-5 text-center"><span class="font-bold text-base text-gray-700">20.49%–29.99%</span><div class="text-gray-400 text-xs mt-0.5">repr. 24.99% APR</div></td>
            <td class="px-4 py-5 text-center"><span class="font-extrabold text-lg text-gray-800">$146.41</span></td>
            <td class="px-4 py-5 text-center"><span class="font-semibold text-gray-700">$8,784.60</span></td>
            <td class="px-4 py-5 text-center"><svg class="w-5 h-5 mx-auto text-red-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/></svg></td>
            <td class="px-4 py-5 text-center"><svg class="w-5 h-5 mx-auto text-red-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/></svg></td>
            <td class="px-4 py-5 text-center"><svg class="w-5 h-5 mx-auto text-teal-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg></td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="mt-6 bg-white border border-gray-200 rounded-xl p-5">
      <div class="flex gap-3 items-start">
        <svg class="w-4 h-4 text-teal-600 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        <div class="text-xs text-gray-500 leading-relaxed">
          <p class="font-semibold text-gray-700 mb-1">Representative Example (BearLoanNow)</p>
          <p>Borrowing <strong>$5,000</strong> over <strong>60 months</strong> at a representative APR of <strong>9.99%</strong> (fixed): monthly repayment of <strong>$106.24</strong>, total amount repayable <strong>$6,374.40</strong>. Rates available from 0% to 35.99% APR. Your actual rate depends on your credit profile and the plan you select.</p>
        </div>
      </div>
    </div>
  </div>
</section>
