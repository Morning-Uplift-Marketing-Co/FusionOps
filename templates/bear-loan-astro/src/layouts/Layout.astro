---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  site?: {
    brand?: string;
    domain?: string;
    conversionId?: string;
    formStartLabel?: string;
    formSubmitLabel?: string;
    aid?: string;
    voluumDomain?: string;
  };
}

const {
  title = 'BearLoanNow – Pet Care Financing $200–$10,000 | Instant Decision',
  description = 'Flexible installment loans for veterinary and pet care expenses. No hard credit check. Instant decision. Funds as soon as next business day.',
  canonicalUrl = 'https://bearloannow.com',
  site = {},
} = Astro.props;

const conversionId = site.conversionId || '';
const aid = site.aid || '';
const voluumDomain = site.voluumDomain || '';
const domain = site.domain || 'bearloannow.com';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Google Ads gtag (AW only, no GA4) -->
    {conversionId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${conversionId}`}></script>
        <script is:inline define:vars={{ conversionId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){ dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', conversionId);
        </script>
      </>
    )}

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FinancialProduct",
      "name": "BearLoanNow Pet Care Loan",
      "description": "Pet care installment loans from $200 to $10,000 with instant approval",
      "provider": {
        "@type": "FinancialService",
        "name": "BearLoanNow",
        "url": "https://bearloannow.com",
        "telephone": "+18002327562"
      },
      "annualPercentageRate": {
        "@type": "QuantitativeValue",
        "minValue": 0,
        "maxValue": 35.99,
        "unitCode": "P1"
      },
      "amount": {
        "@type": "MonetaryAmount",
        "minValue": 200,
        "maxValue": 10000,
        "currency": "USD"
      }
    }
    </script>
  </head>
  <body class="min-h-screen bg-white font-sans antialiased">
    <slot />

    <!-- First-party pixel + GCLID capture -->
    <script is:inline define:vars={{ domain, conversionId, formStartLabel: site.formStartLabel || '', formSubmitLabel: site.formSubmitLabel || '', aid, voluumDomain }}>
    (function(){
      var up = new URLSearchParams(window.location.search);
      var gid = up.get('gclid') || sessionStorage.getItem('gclid') || '';
      var cid = up.get('clickid') || up.get('click_id') || sessionStorage.getItem('click_id') || '';
      var sid = sessionStorage.getItem('_sid') || ('s_' + Date.now() + '_' + Math.random().toString(36).slice(2,8));
      sessionStorage.setItem('_sid', sid);
      if (gid) sessionStorage.setItem('gclid', gid);
      if (cid) sessionStorage.setItem('click_id', cid);

      var PX = 'https://t.' + domain + '/e';
      function pixel(e, d) {
        var p = new URLSearchParams({ e: e, sid: sid, cid: cid, gid: gid, ts: Date.now(), url: window.location.pathname });
        if (d) for (var k in d) p.set(k, d[k]);
        if (navigator.sendBeacon) navigator.sendBeacon(PX, p);
        else new Image(1,1).src = PX + '?' + p.toString();
      }
      window.pixel = pixel;
      pixel('pv');

      // Scroll tracking
      var scrollFired = {};
      window.addEventListener('scroll', function(){
        var pct = Math.round(100 * window.scrollY / (document.body.scrollHeight - window.innerHeight));
        [25,50,75,100].forEach(function(t){
          if (pct >= t && !scrollFired[t]) { scrollFired[t]=true; pixel('scroll_'+t); }
        });
      }, {passive:true});

      setTimeout(function(){ pixel('top_30s'); }, 30000);
      setTimeout(function(){ pixel('top_60s'); }, 60000);

      window.__TRK = { conversionId, formStartLabel, formSubmitLabel, aid, voluumDomain, clickId: cid, gclid: gid, sid };
    })();
    </script>
  </body>
</html>
