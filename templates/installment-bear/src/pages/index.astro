---
const brand       = import.meta.env.PUBLIC_BRAND       || 'BearLoans';
const domain      = import.meta.env.PUBLIC_DOMAIN      || 'example.com';
const h1          = import.meta.env.PUBLIC_H1          || `Get Up to $${import.meta.env.PUBLIC_AMOUNTMAX || '5,000'} Today`;
const sub         = import.meta.env.PUBLIC_SUB         || 'Fast approvals. Flexible installment plans. No hard credit check.';
const cta         = import.meta.env.PUBLIC_CTA         || 'Check My Rate';
const phone       = import.meta.env.PUBLIC_PHONE       || '';
const email       = import.meta.env.PUBLIC_EMAIL       || `support@${import.meta.env.PUBLIC_DOMAIN || 'example.com'}`;
const address     = import.meta.env.PUBLIC_ADDRESS     || '';
const aid         = import.meta.env.PUBLIC_AID         || '';
const amountMin   = import.meta.env.PUBLIC_AMOUNTMIN   || '100';
const amountMax   = import.meta.env.PUBLIC_AMOUNTMAX   || '5,000';
const amountMinRaw = String(Number(amountMin.replace(/[^0-9.]/g,'')) || 100);
const amountMaxRaw = String(Number(amountMax.replace(/[^0-9.]/g,'')) || 5000);
const primaryColor = import.meta.env.PUBLIC_PRIMARYCOLOR || '#3b5bdb';
const accentColor  = import.meta.env.PUBLIC_ACCENTCOLOR  || '#f97316';
const aprMin      = import.meta.env.PUBLIC_APRMIN      || '5.99';
const aprMax      = import.meta.env.PUBLIC_APRMAX      || '35.99';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>${brand} — Installment Loans | Flexible Payment Plans</title>
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='8' fill='${primaryColor}'/><text x='50%' y='54%' dominant-baseline='middle' text-anchor='middle' font-size='18' font-family='system-ui,sans-serif' font-weight='800' fill='white'>$</text></svg>" />
  <meta name="description" content="Get up to $${amountMax} with flexible installment plans. Fast approval, no hard credit check. Apply in minutes." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  <style>
    :root {
      --color-primary: ${primaryColor};
      --color-accent: ${accentColor};
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body { font-family: 'Inter', system-ui, sans-serif; background: #f8f9fa; color: #1a1a2e; line-height: 1.6; -webkit-font-smoothing: antialiased; }

    /* ── Layout ── */
    .container { width: 100%; max-width: 1100px; margin: 0 auto; padding: 0 20px; }
    a { color: inherit; text-decoration: none; }
    img { display: block; max-width: 100%; }

    /* ── NAV ── */
    nav { position: fixed; top: 0; left: 0; right: 0; z-index: 100; background: #fff; border-bottom: 1px solid #e8eaf0; height: 64px; display: flex; align-items: center; }
    .nav-inner { display: flex; align-items: center; justify-content: space-between; width: 100%; }
    .nav-logo { font-size: 1.2rem; font-weight: 800; color: #1a1a2e; display: flex; align-items: center; gap: 8px; }
    .nav-logo span { font-size: 1.4rem; }
    .nav-right { display: flex; align-items: center; gap: 20px; }
    .nav-phone { font-size: 0.875rem; font-weight: 600; color: #4a5568; display: flex; align-items: center; gap: 6px; }
    .btn-nav { background: var(--color-primary); color: #fff; padding: 9px 22px; border-radius: 8px; font-weight: 700; font-size: 0.875rem; border: none; cursor: pointer; transition: background 0.2s; }
    .btn-nav:hover { background: var(--color-primary); opacity: 0.88; }

    /* ── HERO ── */
    .hero { background: linear-gradient(135deg, color-mix(in srgb, var(--color-primary) 80%, #000) 0%, var(--color-primary) 50%, color-mix(in srgb, var(--color-primary) 80%, #fff) 100%); color: #fff; padding: 120px 20px 80px; text-align: center; position: relative; overflow: hidden; }
    .hero::before { content: ''; position: absolute; inset: 0; background: radial-gradient(ellipse at 70% 50%, rgba(255,255,255,0.06) 0%, transparent 60%); pointer-events: none; }
    .hero-badge { display: inline-flex; align-items: center; gap: 8px; background: rgba(255,255,255,0.15); border: 1px solid rgba(255,255,255,0.25); border-radius: 99px; padding: 6px 16px; font-size: 0.8125rem; font-weight: 600; margin-bottom: 24px; }
    .hero-badge::before { content: '✦'; color: #ffd43b; }
    .hero h1 { font-size: clamp(2rem, 5vw, 3.5rem); font-weight: 900; line-height: 1.1; margin-bottom: 20px; max-width: 780px; margin-left: auto; margin-right: auto; }
    .hero h1 em { font-style: normal; color: #ffd43b; }
    .hero-sub { font-size: 1.125rem; opacity: 0.88; max-width: 520px; margin: 0 auto 32px; }
    .hero-pills { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px 24px; margin-bottom: 36px; }
    .hero-pill { display: flex; align-items: center; gap: 7px; font-size: 0.875rem; font-weight: 500; opacity: 0.92; }
    .hero-pill::before { content: '✓'; color: #69db7c; font-weight: 700; }

    /* ── ZIP FORM ── */
    .hero-form { max-width: 460px; margin: 0 auto 16px; }
    .zip-group { display: flex; gap: 0; background: #fff; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 24px rgba(0,0,0,0.18); }
    .zip-input { flex: 1; border: none; outline: none; padding: 16px 20px; font-size: 1.0625rem; font-family: inherit; color: #1a1a2e; background: transparent; }
    .zip-input::placeholder { color: #9ca3af; }
    .btn-cta { background: var(--color-accent); color: #fff; border: none; padding: 16px 28px; font-size: 1.0625rem; font-weight: 800; cursor: pointer; font-family: inherit; transition: background 0.2s, transform 0.15s; white-space: nowrap; display: flex; align-items: center; gap: 8px; }
    .btn-cta:hover { background: var(--color-accent); opacity: 0.88; transform: translateX(2px); }
    .btn-cta svg { width: 18px; height: 18px; flex-shrink: 0; }
    .hero-form-note { color: rgba(255,255,255,0.7); font-size: 0.8125rem; text-align: center; }
    .hero-trust { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px 28px; margin-top: 36px; padding-top: 28px; border-top: 1px solid rgba(255,255,255,0.15); }
    .trust-item { display: flex; align-items: center; gap: 7px; font-size: 0.8125rem; font-weight: 500; opacity: 0.88; }
    .trust-item svg { width: 16px; height: 16px; opacity: 0.8; }

    /* ── REVIEWS TOP ── */
    .reviews-banner { background: #fff; padding: 48px 0; border-bottom: 1px solid #e8eaf0; }
    .reviews-header { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px; margin-bottom: 32px; }
    .reviews-header h2 { font-size: 1.625rem; font-weight: 800; }
    .stars-badge { display: flex; align-items: center; gap: 8px; }
    .stars { color: #f59e0b; font-size: 1.1rem; letter-spacing: 2px; }
    .stars-label { font-size: 0.875rem; color: #6b7280; }
    .reviews-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px; }
    .review-card { background: #f8f9fa; border: 1px solid #e8eaf0; border-radius: 16px; padding: 24px; }
    .review-stars { color: #f59e0b; font-size: 0.875rem; margin-bottom: 12px; }
    .review-text { font-size: 0.9375rem; color: #374151; line-height: 1.65; margin-bottom: 16px; font-style: italic; }
    .reviewer { display: flex; align-items: center; gap: 12px; }
    .reviewer-avatar { width: 40px; height: 40px; border-radius: 99px; background: var(--color-primary); color: #fff; font-weight: 700; font-size: 0.875rem; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .reviewer-name { font-weight: 700; font-size: 0.875rem; }
    .reviewer-loc { font-size: 0.8125rem; color: #9ca3af; }
    .reviewer-time { margin-left: auto; font-size: 0.75rem; color: #9ca3af; }

    /* ── CALC ── */
    .calc-section { background: #f0f4ff; padding: 72px 0; }
    .section-label { display: inline-flex; align-items: center; gap: 8px; background: color-mix(in srgb, var(--color-primary) 12%, #fff); color: var(--color-primary); border-radius: 99px; padding: 5px 14px; font-size: 0.8125rem; font-weight: 700; margin-bottom: 16px; }
    .section-header { text-align: center; margin-bottom: 48px; }
    .section-header h2 { font-size: clamp(1.5rem, 3vw, 2.25rem); font-weight: 800; margin-bottom: 10px; }
    .section-header p { color: #6b7280; max-width: 480px; margin: 0 auto; }
    .calc-card { background: #fff; border-radius: 20px; padding: 36px; max-width: 680px; margin: 0 auto; box-shadow: 0 4px 24px rgba(59,91,219,0.08); }
    .calc-amount-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; font-weight: 600; }
    .calc-amount-val { font-size: 1.5rem; font-weight: 800; color: var(--color-primary); }
    .calc-slider { width: 100%; height: 6px; appearance: none; background: linear-gradient(to right, var(--color-primary) var(--pct,50%), #e8eaf0 var(--pct,50%)); border-radius: 99px; outline: none; cursor: pointer; margin-bottom: 8px; }
    .calc-slider::-webkit-slider-thumb { appearance: none; width: 22px; height: 22px; background: var(--color-primary); border-radius: 99px; border: 3px solid #fff; box-shadow: 0 2px 8px rgba(59,91,219,0.35); }
    .calc-range-labels { display: flex; justify-content: space-between; font-size: 0.8125rem; color: #9ca3af; margin-bottom: 28px; }
    .calc-tiers { display: grid; grid-template-columns: repeat(3,1fr); gap: 16px; margin-bottom: 24px; }
    .calc-tier { border: 2px solid #e8eaf0; border-radius: 14px; padding: 18px 14px; text-align: center; cursor: pointer; transition: border-color 0.2s, background 0.2s; position: relative; }
    .calc-tier.active { border-color: var(--color-primary); background: color-mix(in srgb, var(--color-primary) 8%, #fff); }
    .calc-tier-best { position: absolute; top: -11px; left: 50%; transform: translateX(-50%); background: var(--color-accent); color: #fff; font-size: 0.6875rem; font-weight: 700; padding: 3px 10px; border-radius: 99px; white-space: nowrap; }
    .calc-tier-name { font-size: 0.875rem; font-weight: 700; color: #374151; margin-bottom: 4px; }
    .calc-tier-rate { font-size: 0.75rem; color: #10b981; font-weight: 600; margin-bottom: 6px; }
    .calc-tier-payment { font-size: 1.375rem; font-weight: 800; color: #1a1a2e; }
    .calc-tier-mo { font-size: 0.75rem; color: #9ca3af; }
    .calc-tier-details { margin-top: 8px; font-size: 0.75rem; color: #9ca3af; line-height: 1.5; }
    .btn-calc { display: flex; align-items: center; justify-content: center; gap: 10px; width: 100%; background: var(--color-accent); color: #fff; border: none; padding: 16px; font-size: 1.0625rem; font-weight: 800; border-radius: 12px; cursor: pointer; font-family: inherit; transition: background 0.2s; }
    .btn-calc:hover { background: var(--color-accent); opacity: 0.88; }
    .calc-footnote { text-align: center; font-size: 0.8125rem; color: #9ca3af; margin-top: 10px; }

    /* ── WHY ── */
    .why-section { background: #fff; padding: 72px 0; }
    .features-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px,1fr)); gap: 28px; }
    .feature-card { padding: 28px; border: 1px solid #e8eaf0; border-radius: 16px; transition: box-shadow 0.2s; }
    .feature-card:hover { box-shadow: 0 8px 32px rgba(59,91,219,0.10); }
    .feature-icon { width: 48px; height: 48px; background: #f0f4ff; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.4rem; margin-bottom: 16px; }
    .feature-card h3 { font-size: 1rem; font-weight: 700; margin-bottom: 8px; }
    .feature-card p { font-size: 0.875rem; color: #6b7280; line-height: 1.6; }

    /* ── HOW ── */
    .how-section { background: #f8f9fa; padding: 72px 0; }
    .steps-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px,1fr)); gap: 32px; position: relative; }
    .step { text-align: center; padding: 0 16px; }
    .step-num { width: 56px; height: 56px; background: var(--color-primary); color: #fff; border-radius: 99px; display: flex; align-items: center; justify-content: center; font-size: 1.25rem; font-weight: 800; margin: 0 auto 16px; }
    .step-icon { font-size: 1.75rem; margin-bottom: 12px; }
    .step h3 { font-size: 1rem; font-weight: 700; margin-bottom: 8px; }
    .step p { font-size: 0.875rem; color: #6b7280; }

    /* ── FAQ ── */
    .faq-section { background: #fff; padding: 72px 0; }
    .faq-wrap { max-width: 720px; margin: 0 auto; }
    .faq-item { border-bottom: 1px solid #e8eaf0; }
    .faq-btn { width: 100%; display: flex; align-items: center; justify-content: space-between; background: none; border: none; padding: 20px 0; font-family: inherit; font-size: 1rem; font-weight: 600; color: #1a1a2e; cursor: pointer; text-align: left; gap: 16px; }
    .faq-icon { width: 24px; height: 24px; background: color-mix(in srgb, var(--color-primary) 10%, #fff); border-radius: 99px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; color: var(--color-primary); font-size: 1.1rem; font-weight: 700; transition: transform 0.2s; }
    .faq-item.open .faq-icon { transform: rotate(45deg); }
    .faq-body { font-size: 0.9375rem; color: #6b7280; line-height: 1.7; padding-bottom: 20px; display: none; }
    .faq-item.open .faq-body { display: block; }

    /* ── TRUST BADGES ── */
    .trust-section { background: #f0f4ff; padding: 48px 0; }
    .trust-grid { display: flex; flex-wrap: wrap; justify-content: center; gap: 16px 40px; }
    .trust-badge { display: flex; align-items: center; gap: 12px; background: #fff; border: 1px solid #e0e7ff; border-radius: 12px; padding: 14px 20px; }
    .trust-badge-icon { font-size: 1.4rem; }
    .trust-badge-text strong { display: block; font-size: 0.875rem; font-weight: 700; }
    .trust-badge-text span { font-size: 0.75rem; color: #6b7280; }

    /* ── SECURITY BAR ── */
    .sec-bar { background: #1a1a2e; padding: 20px 0; }
    .sec-bar-inner { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px 32px; }
    .sec-item { display: flex; align-items: center; gap: 8px; color: rgba(255,255,255,0.75); font-size: 0.8125rem; font-weight: 500; }
    .sec-item::before { content: '🔒'; font-size: 0.875rem; }

    /* ── FOOTER ── */
    footer { background: #111827; color: rgba(255,255,255,0.65); padding: 56px 0 32px; }
    .footer-top { display: grid; grid-template-columns: 1.5fr 1fr 1fr; gap: 40px; margin-bottom: 40px; }
    .footer-brand { font-size: 1.1rem; font-weight: 800; color: #fff; margin-bottom: 12px; display: flex; align-items: center; gap: 8px; }
    .footer-brand span { font-size: 1.3rem; }
    .footer-desc { font-size: 0.875rem; line-height: 1.7; margin-bottom: 16px; }
    .footer-contact p { font-size: 0.8125rem; margin-bottom: 6px; }
    footer h4 { font-size: 0.875rem; font-weight: 700; color: #fff; margin-bottom: 14px; }
    .footer-links { list-style: none; }
    .footer-links li { margin-bottom: 8px; }
    .footer-links a { font-size: 0.875rem; color: rgba(255,255,255,0.55); transition: color 0.2s; cursor: pointer; }
    .footer-links a:hover { color: #fff; }
    .footer-divider { border: none; border-top: 1px solid rgba(255,255,255,0.08); margin-bottom: 28px; }
    .footer-disclosure { font-size: 0.75rem; line-height: 1.7; color: rgba(255,255,255,0.4); margin-bottom: 16px; }
    .footer-copy { font-size: 0.8125rem; color: rgba(255,255,255,0.35); }

    /* ── MODALS ── */
    .modal-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.55); z-index: 200; align-items: center; justify-content: center; padding: 20px; }
    .modal-overlay.open { display: flex; }
    .modal { background: #fff; border-radius: 20px; max-width: 560px; width: 100%; max-height: 80vh; overflow-y: auto; padding: 36px; position: relative; }
    .modal-close { position: absolute; top: 16px; right: 16px; background: #f3f4f6; border: none; width: 32px; height: 32px; border-radius: 99px; cursor: pointer; font-size: 1rem; display: flex; align-items: center; justify-content: center; }
    .modal h3 { font-size: 1.25rem; font-weight: 800; margin-bottom: 16px; }
    .modal p { font-size: 0.9rem; color: #6b7280; line-height: 1.7; margin-bottom: 12px; }

    /* ── RESPONSIVE ── */
    @media (max-width: 768px) {
      .nav-phone { display: none; }
      .hero h1 { font-size: 1.875rem; }
      .zip-group { flex-direction: column; border-radius: 12px; }
      .zip-input { border-radius: 12px 12px 0 0; border-bottom: 1px solid #e8eaf0; }
      .btn-cta { border-radius: 0 0 12px 12px; justify-content: center; }
      .calc-tiers { grid-template-columns: 1fr; }
      .footer-top { grid-template-columns: 1fr; gap: 28px; }
      .hero-trust { gap: 8px 16px; }
    }
    @media (max-width: 480px) {
      .reviews-grid { grid-template-columns: 1fr; }
      .features-grid { grid-template-columns: 1fr; }
      .steps-grid { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>

<!-- NAV -->
<nav>
  <div class="container nav-inner">
    <div class="nav-logo"><span>💰</span>${brand}</div>
    <div class="nav-right">
      <a href="tel:${phone}" class="nav-phone">📞 ${phone}</a>
      <button class="btn-nav" onclick="document.getElementById('zip-main').focus()">Apply Now</button>
    </div>
  </div>
</nav>

<!-- HERO -->
<section class="hero">
  <div class="container">
    <div class="hero-badge">Join 50,000+ People Who Got Funded This Month.</div>
    <h1>${h1} <em>Up to $${amountMax}</em> by Tomorrow.</h1>
    <p class="hero-sub">${sub}</p>
    <div class="hero-pills">
      <span class="hero-pill">No hard credit check</span>
      <span class="hero-pill">Instant decision</span>
      <span class="hero-pill">Funds next day</span>
    </div>
    <div class="hero-form">
      <form class="zip-group" onsubmit="handleZip(event)">
        <input id="zip-main" class="zip-input" type="text" inputmode="numeric" maxlength="5" placeholder="Enter your ZIP Code" autocomplete="postal-code" />
        <button type="submit" class="btn-cta">
          ${cta}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </button>
      </form>
      <p class="hero-form-note" style="margin-top:10px">Apply now — get funded as soon as tomorrow</p>
    </div>
    <div class="hero-trust">
      <span class="trust-item">⭐ 4.9/5 (5,000+ reviews)</span>
      <span class="trust-item">🔒 256-bit SSL</span>
      <span class="trust-item">✓ No Hard Credit Check</span>
      <span class="trust-item">⚡ Instant Decision</span>
    </div>
  </div>
</section>

<!-- REVIEWS BANNER -->
<section class="reviews-banner">
  <div class="container">
    <div class="reviews-header">
      <h2>What Our Customers Say</h2>
      <div class="stars-badge">
        <span class="stars">★★★★★</span>
        <span class="stars-label">4.9/5 from 5,000+ reviews</span>
      </div>
    </div>
    <div class="reviews-grid">
      <div class="review-card">
        <div class="review-stars">★★★★★</div>
        <p class="review-text">"A surprise car repair hit right before rent. ${brand} approved me quickly with just a few documents. The rep was so kind and explained everything clearly. Funds arrived the next day. Lifesaver."</p>
        <div class="reviewer">
          <div class="reviewer-avatar">JR</div>
          <div><div class="reviewer-name">Jasmine R.</div><div class="reviewer-loc">Phoenix, AZ</div></div>
          <div class="reviewer-time">2 weeks ago</div>
        </div>
      </div>
      <div class="review-card">
        <div class="review-stars">★★★★★</div>
        <p class="review-text">"Medical bill stress had me up all night. The application was simple, and customer service felt like a warm hug. Clear terms, fair payments, no pressure. I paid it off early without fees."</p>
        <div class="reviewer">
          <div class="reviewer-avatar">MT</div>
          <div><div class="reviewer-name">Miguel T.</div><div class="reviewer-loc">Chicago, IL</div></div>
          <div class="reviewer-time">5 days ago</div>
        </div>
      </div>
      <div class="review-card">
        <div class="review-stars">★★★★★</div>
        <p class="review-text">"I'm a gig worker, so paperwork can be a headache. ${brand} only asked for essentials and approved me fast. Honest rates and real people on the phone — felt supported from start to finish."</p>
        <div class="reviewer">
          <div class="reviewer-avatar">AW</div>
          <div><div class="reviewer-name">Alyssa W.</div><div class="reviewer-loc">Miami, FL</div></div>
          <div class="reviewer-time">1 month ago</div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- PAYMENT CALCULATOR -->
<section class="calc-section">
  <div class="container">
    <div class="section-header">
      <div class="section-label">💳 Payment Calculator</div>
      <h2>See Your Monthly Payment</h2>
      <p>Choose your loan amount and see instant payment options</p>
    </div>
    <div class="calc-card">
      <div class="calc-amount-row">
        <span>Loan Amount</span>
        <span class="calc-amount-val" id="calc-display">$2,000</span>
      </div>
      <input type="range" class="calc-slider" id="calc-slider" min="${amountMinRaw}" max="${amountMaxRaw}" value="${amountMaxRaw}" oninput="updateCalc(this.value); selectTier(6);" />
      <div class="calc-range-labels"><span>$${amountMin}</span><span>$${amountMax}</span></div>
      <div class="calc-tiers">
        <div class="calc-tier active" id="tier-6" onclick="selectTier(6)">
          <div class="calc-tier-best">BEST VALUE</div>
          <div class="calc-tier-name">Pay in 6</div>
          <div class="calc-tier-rate">0% Interest</div>
          <div class="calc-tier-payment" id="pay-6">$333/mo</div>
          <div class="calc-tier-mo">per month</div>
