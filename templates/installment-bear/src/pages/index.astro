<script>
/* ── ZIP FLOW ── */
function handleZip(e) {
  e.preventDefault();
  var zip = document.getElementById('zip-main').value.trim();
  if (!/^\d{5}$/.test(zip)) {
    document.getElementById('zip-main').style.outline = '2px solid #ef4444';
    document.getElementById('zip-main').placeholder = 'Enter a valid 5-digit ZIP';
    setTimeout(function() {
      document.getElementById('zip-main').style.outline = '';
      document.getElementById('zip-main').placeholder = 'Enter your ZIP Code';
    }, 2000);
    return;
  }
  var params = new URLSearchParams(window.location.search);
  params.set('zip', zip);
  window.location.href = '/apply?' + params.toString();
}

/* ── CALCULATOR ── */
var _slider = document.getElementById('calc-slider');
var calcMin = parseInt(_slider ? _slider.min : '100') || 100;
var calcMax = parseInt(_slider ? _slider.max : '5000') || 5000;
var calcInitVal = parseInt(_slider ? _slider.value : '0') || calcMax;
var calcAmount = calcInitVal;
function updateCalc(val) {
  calcAmount = parseInt(val);
  var pct = ((calcAmount - calcMin) / (calcMax - calcMin)) * 100;
  document.getElementById('calc-slider').style.setProperty('--pct', pct + '%');
  document.getElementById('calc-display').textContent = '$' + calcAmount.toLocaleString();
  document.getElementById('calc-apply-btn').textContent = '';
  document.getElementById('calc-apply-btn').innerHTML = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg> Apply for $' + calcAmount.toLocaleString();

  var p6 = Math.ceil(calcAmount / 6);
  document.getElementById('pay-6').textContent = '$' + p6.toLocaleString() + '/mo';
  document.getElementById('detail-6').textContent = 'APR: 0% · Total: $' + calcAmount.toLocaleString();

  var total12 = Math.ceil(calcAmount * 1.08);
  document.getElementById('pay-12').textContent = '$' + Math.ceil(total12 / 12).toLocaleString() + '/mo';
  document.getElementById('detail-12').textContent = 'APR: 15.99% · Total: $' + total12.toLocaleString();

  var total24 = Math.ceil(calcAmount * 1.12);
  document.getElementById('pay-24').textContent = '$' + Math.ceil(total24 / 24).toLocaleString() + '/mo';
  document.getElementById('detail-24').textContent = 'APR: 19.99% · Total: $' + total24.toLocaleString();
}
updateCalc(calcInitVal);

function selectTier(months) {
  ['tier-6','tier-12','tier-24'].forEach(function(id) { document.getElementById(id).classList.remove('active'); });
  document.getElementById('tier-' + months).classList.add('active');
}

function handleCalcApply() {
  window.location.href = '/apply?amount=' + calcAmount + '&' + window.location.search.slice(1);
}

/* ── FAQ ── */
function toggleFaq(btn) {
  var item = btn.parentElement;
  var wasOpen = item.classList.contains('open');
  document.querySelectorAll('.faq-item').forEach(function(i) { i.classList.remove('open'); });
  if (!wasOpen) item.classList.add('open');
}

/* ── MODALS ── */
function openModal(name) { document.getElementById('modal-' + name).classList.add('open'); }
function closeModal(name) { document.getElementById('modal-' + name).classList.remove('open'); }
document.addEventListener('keydown', function(e) { if (e.key === 'Escape') { document.querySelectorAll('.modal-overlay').forEach(function(m) { m.classList.remove('open'); }); } });
</script>

