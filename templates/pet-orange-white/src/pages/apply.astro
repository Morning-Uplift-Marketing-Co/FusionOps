---
export const prerender = true;

const brand      = import.meta.env.PUBLIC_BRAND   || 'Scratchpay';
const accountId  = import.meta.env.PUBLIC_LEADSGATE_ACCOUNT_ID  || '14881';
const campaignId = import.meta.env.PUBLIC_LEADSGATE_CAMPAIGN_ID || '';
const source     = import.meta.env.PUBLIC_LEADSGATE_SOURCE      || 'pet-orange-white';
const aid        = import.meta.env.PUBLIC_AID || accountId;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Apply | {brand}</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="dns-prefetch" href="//apikeep.com" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { height: 100%; background: #f8fafc; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; }
    body { display: flex; flex-direction: column; align-items: center; justify-content: flex-start; padding: 24px 16px 48px; }
    #_lg_form_ { width: 100%; max-width: 640px; }
  </style>
</head>
<body>
  <div id="_lg_form_"></div>

  <script is:inline define:vars={{ accountId, campaignId, source, aid }}>
    (function () {
      var params = new URLSearchParams(window.location.search);
      var rawZip  = params.get('zip') || '';
      var safeZip = /^\d{5}$/.test(rawZip) ? rawZip : '';
      var clickId = params.get('click_id') || params.get('cid') || '';
      var trackingParams = {};
      params.forEach(function (val, key) { trackingParams[key] = val; });
      var resolvedAccount  = accountId  || aid  || '14881';
      var resolvedCampaign = campaignId || params.get('campaign_id') || '';
      window._lg_form_init_ = {
        account_id:  resolvedAccount,
        campaign_id: resolvedCampaign,
        click_id:    clickId,
        zip:         safeZip,
        source:      source,
        meta:        trackingParams,
      };
    })();
  </script>
  <script is:inline src="https://apikeep.com/form/applicationInit.js"></script>
</body>
</html>
