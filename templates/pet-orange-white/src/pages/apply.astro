---
export const prerender = true;
import BaseLayout from "../layouts/BaseLayout.astro";

const accountId = import.meta.env.PUBLIC_LEADSGATE_ACCOUNT_ID ?? "";
const campaignId = import.meta.env.PUBLIC_LEADSGATE_CAMPAIGN_ID ?? "";
const source = import.meta.env.PUBLIC_LEADSGATE_SOURCE ?? "flexible-funding-template";
---

<BaseLayout
  title="Apply | Tailored Credit Options"
  description="Complete your application step and review available lending options and terms."
>
  <Fragment slot="head">
    <link rel="dns-prefetch" href="//apikeep.com" />
  </Fragment>

  <main class="page-reveal pb-24 md:pb-16 pt-6 md:pt-12">
    <!-- Header/Logo area -->
    <div class="mx-auto w-full max-w-7xl px-6 mb-8">
      <div class="flex items-center gap-2">
        <div
          class="w-8 h-8 rounded-lg bg-orange-500 flex items-center justify-center shadow-lg shadow-orange-500/30"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="w-5 h-5 text-white"
          >
            <path
              fill-rule="evenodd"
              d="M12 1.5a5.25 5.25 0 00-5.25 5.25v3a3 3 0 00-3 3v6.75a3 3 0 003 3h10.5a3 3 0 003-3v-6.75a3 3 0 00-3-3v-3c0-2.9-2.35-5.25-5.25-5.25zm3.75 8.25v-3a3.75 3.75 0 10-7.5 0v3h7.5z"
              clip-rule="evenodd"></path>
          </svg>
        </div>
        <a
          href="/"
          class="font-bold font-heading text-xl tracking-tight text-slate-900"
          >Secure<span class="text-orange-500">Loan</span></a
        >
      </div>
    </div>

    <section class="mx-auto w-full max-w-7xl px-6">
      <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr]">
        <!-- Left info panel -->
        <aside class="section-stagger lg:pt-8" style="--delay: 100ms;">
          <h1
            class="text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl mb-4 text-balance font-heading"
          >
            Complete Your Request
          </h1>
          <p class="text-lg text-slate-600 mb-8 leading-relaxed max-w-md">
            You're just a few steps away. Securely complete the form to view
            potential loan options.
          </p>

          <div class="glass-card p-6 border-slate-200/60 mb-8 shadow-sm">
            <h3
              class="font-bold text-slate-900 mb-4 border-b border-slate-100 pb-3 flex items-center gap-2"
            >
              <svg
                class="w-5 h-5 text-slate-400"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                ></path></svg
              >
              Session Details
            </h3>
            <dl class="space-y-4 text-sm">
              <div class="flex items-center justify-between">
                <dt class="font-medium text-slate-500">Entered ZIP</dt>
                <dd
                  class="font-bold text-slate-900 bg-slate-100 px-3 py-1 rounded-md"
                >
                  <span id="apply-zip-display">—</span>
                </dd>
              </div>
              <div class="flex items-center justify-between">
                <dt class="font-medium text-slate-500">Connection</dt>
                <dd
                  class="font-bold text-emerald-600 flex items-center gap-1.5"
                >
                  <span class="relative flex h-2 w-2">
                    <span
                      class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"
                    ></span>
                    <span
                      class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"
                    ></span>
                  </span>
                  High Security 256-bit
                </dd>
              </div>
            </dl>
          </div>

          <ul class="space-y-6">
            <li class="flex items-start gap-4">
              <div
                class="w-10 h-10 rounded-full bg-white shadow-sm border border-slate-100 flex items-center justify-center flex-shrink-0 text-slate-600"
              >
                <svg
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                  class="w-5 h-5"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z"
                  ></path></svg
                >
              </div>
              <div>
                <h4 class="font-bold text-slate-900">Encrypted transmission</h4>
                <p class="text-sm text-slate-500 mt-1 leading-relaxed">
                  Your data is secured with bank-level encryption standards.
                </p>
              </div>
            </li>
            <li class="flex items-start gap-4">
              <div
                class="w-10 h-10 rounded-full bg-white shadow-sm border border-slate-100 flex items-center justify-center flex-shrink-0 text-slate-600"
              >
                <svg
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                  class="w-5 h-5"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m3.75 9v6m3-3H9m1.5-12H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"
                  ></path></svg
                >
              </div>
              <div>
                <h4 class="font-bold text-slate-900">Clear disclosures</h4>
                <p class="text-sm text-slate-500 mt-1 leading-relaxed">
                  Read all terms and conditions clearly before making any
                  decision.
                </p>
              </div>
            </li>
            <li class="flex items-start gap-4">
              <div
                class="w-10 h-10 rounded-full bg-white shadow-sm border border-slate-100 flex items-center justify-center flex-shrink-0 text-slate-600"
              >
                <svg
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                  class="w-5 h-5"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                  ></path></svg
                >
              </div>
              <div>
                <h4 class="font-bold text-slate-900">No obligation</h4>
                <p class="text-sm text-slate-500 mt-1 leading-relaxed">
                  You are never required to accept any offer presented to you.
                </p>
              </div>
            </li>
          </ul>
        </aside>

        <!-- Right LeadsGate Form -->
        <section class="section-stagger" style="--delay: 200ms;">
          <!-- decorative blur behind form -->
          <div
            class="absolute -inset-1 rounded-[2.5rem] bg-gradient-to-br from-white via-slate-100 to-sky-100 opacity-60 blur-2xl pointer-events-none"
          >
          </div>

          <div
            class="glass-card relative p-2 sm:p-5 shadow-lg border border-white"
          >
            <div id="_lg_form_"></div>
          </div>
        </section>
      </div>
    </section>
  </main>
</BaseLayout>

<script is:inline define:vars={{ accountId, campaignId, source }}>
  (function () {
    var params = new URLSearchParams(window.location.search);
    var rawZip = params.get("zip") ?? "";
    var safeZip = /^\d{5}$/.test(rawZip) ? rawZip : "";
    var clickId = params.get("click_id") ?? params.get("cid") ?? "";
    var trackingParams = {};
    params.forEach(function (val, key) {
      if (key !== "zip") trackingParams[key] = val;
    });
    window._lg_form_init_ = {
      account_id: accountId,
      campaign_id: campaignId,
      click_id: clickId,
      zip: safeZip,
      source: source,
      meta: trackingParams,
    };
    // Show ZIP in session details
    var zipEl = document.getElementById("apply-zip-display");
    if (zipEl) zipEl.textContent = safeZip || "Not provided";
  })();
</script>
<script is:inline src="https://apikeep.com/form/applicationInit.js"></script>
