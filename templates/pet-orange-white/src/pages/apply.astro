---
export const prerender = true;

const brand = import.meta.env.PUBLIC_BRAND || 'Scratchpay';
const aid   = import.meta.env.PUBLIC_AID   || '14881';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Apply | {brand}</title>
  <meta name="robots" content="noindex, nofollow" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { height: 100%; min-height: 100vh; background: #f8fafc; }
    iframe { display: block; width: 100%; border: none; min-height: 100vh; }
  </style>
</head>
<body>
  <iframe
    src={`https://flow.leadsgate.com/en/form/${aid}`}
    allowfullscreen
    loading="eager"
  ></iframe>
</body>
</html>
