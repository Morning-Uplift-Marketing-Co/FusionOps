---
const aprMin = import.meta.env.PUBLIC_APRMIN || '5.99';
const aprMax = import.meta.env.PUBLIC_APRMAX || '35.99';
const amountMin    = import.meta.env.PUBLIC_AMOUNTMIN    || '$100';
const amountMax    = import.meta.env.PUBLIC_AMOUNTMAX    || '$5,000';
const amountMinRaw = String(Number((amountMin).replace(/[^0-9.]/g,'')) || 100);
const amountMaxRaw = String(Number((amountMax).replace(/[^0-9.]/g,'')) || 5000);
---

<section
    class="section-stagger mx-auto w-full max-w-7xl px-6 mt-16 sm:mt-24"
    style="--delay: 150ms;"
>
    <div
        class="glass-card overflow-hidden grid lg:grid-cols-[1.3fr_0.7fr] border border-slate-200 shadow-sm relative"
    >
        <!-- Left: Calculator Inputs -->
        <div class="p-8 sm:p-10 relative bg-white/50">
            <div class="mb-8">
                <h2 class="text-3xl font-bold font-heading text-slate-900 mb-2">
                    Payment Calculator
                </h2>
                <p class="text-slate-500 text-sm">
                    Estimate your monthly payments. Rates may vary by state and
                    lender qualifications.
                </p>
            </div>

            <div class="space-y-8">
                <!-- Loan Amount -->
                <div>
                    <div class="flex justify-between items-end mb-4">
                        <label class="block font-semibold text-slate-700">Loan Amount</label>
                        <span id="calc-amount-display" class="font-bold text-slate-900 text-lg">$1,000</span>
                    </div>
                    <div class="grid grid-cols-3 sm:grid-cols-3 gap-2" id="calc-amount-buttons">
                        <button type="button" data-amount={amountMinRaw} class="amount-btn rounded-xl border border-slate-200 bg-white py-2 px-3 text-sm font-semibold text-slate-700 hover:border-orange-400 hover:text-orange-600 transition-colors">{amountMin}</button>
                        <button type="button" data-amount="500" class="amount-btn rounded-xl border border-slate-200 bg-white py-2 px-3 text-sm font-semibold text-slate-700 hover:border-orange-400 hover:text-orange-600 transition-colors">$500</button>
                        <button type="button" data-amount="1000" class="amount-btn amount-btn-active rounded-xl border border-orange-500 bg-orange-50 py-2 px-3 text-sm font-semibold text-orange-600 transition-colors">$1,000</button>
                        <button type="button" data-amount="2000" class="amount-btn rounded-xl border border-slate-200 bg-white py-2 px-3 text-sm font-semibold text-slate-700 hover:border-orange-400 hover:text-orange-600 transition-colors">$2,000</button>
                        <button type="button" data-amount="3000" class="amount-btn rounded-xl border border-slate-200 bg-white py-2 px-3 text-sm font-semibold text-slate-700 hover:border-orange-400 hover:text-orange-600 transition-colors">$3,000</button>
                        <button type="button" data-amount={amountMaxRaw} class="amount-btn rounded-xl border border-slate-200 bg-white py-2 px-3 text-sm font-semibold text-slate-700 hover:border-orange-400 hover:text-orange-600 transition-colors">{amountMax}</button>
                    </div>
                    <input type="hidden" id="calc-amount" value="1000" />
                </div>

                <!-- Term Length -->
                <div>
                    <div class="flex justify-between items-end mb-4">
                        <label class="block font-semibold text-slate-700">Repayment Period</label>
                        <span id="calc-term-display" class="font-bold text-slate-900 text-lg">24 mo</span>
                    </div>
                    <div class="grid grid-cols-5 gap-2" id="calc-term-buttons">
                        <button type="button" data-term="12" class="term-btn rounded-xl border border-slate-200 bg-white py-2 px-3 text-sm font-semibold text-slate-700 hover:border-orange-400 hover:text-orange-600 transition-colors">12 mo</button>
                        <button type="button" data-term="24" class="term-btn term-btn-active rounded-xl border border-orange-500 bg-orange-50 py-2 px-3 text-sm font-semibold text-orange-600 transition-colors">24 mo</button>
                        <button type="button" data-term="48" class="term-btn rounded-xl border border-slate-200 bg-white py-2 px-3 text-sm font-semibold text-slate-700 hover:border-orange-400 hover:text-orange-600 transition-colors">48 mo</button>
                        <button type="button" data-term="60" class="term-btn rounded-xl border border-slate-200 bg-white py-2 px-3 text-sm font-semibold text-slate-700 hover:border-orange-400 hover:text-orange-600 transition-colors">60 mo</button>
                        <button type="button" data-term="72" class="term-btn rounded-xl border border-slate-200 bg-white py-2 px-3 text-sm font-semibold text-slate-700 hover:border-orange-400 hover:text-orange-600 transition-colors">72 mo</button>
                    </div>
                    <input type="hidden" id="calc-term" value="24" />
                </div>

                <!-- APR -->
                <div>
                    <div class="flex justify-between items-end mb-4">
                        <label
                            for="calc-apr"
                            class="block font-semibold text-slate-700"
                            >Estimated APR <span
                                class="text-orange-500 font-normal">*</span
                            ></label
                        >
                        <div class="relative hidden sm:block">
                            <input
                                type="number"
                                id="calc-apr"
                                value="15.0"
                                min={aprMin}
                                max={aprMax}
                                step="0.1"
                                class="w-24 rounded-xl border-slate-200 bg-white py-2 pl-3 pr-7 text-right font-bold text-slate-900 shadow-sm focus:border-orange-500 focus:ring-orange-500"
                            />
                            <span
                                class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-500 font-semibold text-sm"
                                >%</span
                            >
                        </div>
                    </div>
                    <input
                        type="range"
                        id="calc-apr-slider"
                        min={aprMin}
                        max={aprMax}
                        step="0.1"
                        value="15.0"
                        class="w-full h-2 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-orange-500"
                    />
                    <div
                        class="flex justify-between text-xs font-semibold text-slate-400 mt-2"
                    >
                        <span>{aprMin}%</span>
                        <span>{aprMax}%</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right: Calculator Output -->
        <div
            class="bg-slate-900 p-8 sm:p-10 text-white flex flex-col justify-center relative overflow-hidden"
        >
            <!-- Glow effect -->
            <div
                class="absolute -top-32 -right-32 w-64 h-64 bg-orange-500 rounded-full blur-[100px] opacity-40"
            >
            </div>

            <div class="relative z-10">
                <h3
                    class="font-heading font-medium text-slate-400 mb-2 tracking-wide uppercase text-sm"
                >
                    Estimated Monthly Payment
                </h3>
                <p
                    class="text-5xl font-extrabold text-white mb-8 tracking-tight flex items-baseline gap-1"
                    id="calc-monthly-output"
                >
                    $484<span class="text-xl font-medium text-slate-400"
                        >/mo</span
                    >
                </p>

                <div class="space-y-4 pt-6 border-t border-slate-700/50">
                    <div class="flex justify-between items-center text-sm">
                        <span class="text-slate-400">Principal Amount</span>
                        <span
                            class="font-semibold text-white"
                            id="calc-principal-output">$10,000</span
                        >
                    </div>
                    <div class="flex justify-between items-center text-sm">
                        <span class="text-slate-400">Total Interest</span>
                        <span
                            class="font-semibold text-white"
                            id="calc-interest-output">$1,636</span
                        >
                    </div>
                    <div class="flex justify-between items-center text-sm pt-2">
                        <span class="text-slate-300 font-medium"
                            >Total Repayment</span
                        >
                        <span
                            class="font-bold text-white text-lg"
                            id="calc-total-output">$11,636</span
                        >
                    </div>
                </div>

                <div class="mt-8 text-center sm:text-left">
                    <a
                        href="#eligibility-form"
                        class="inline-flex w-full cursor-pointer items-center justify-center rounded-xl px-6 py-4 text-sm font-bold text-slate-900 transition duration-200 bg-white hover:bg-slate-100 ring-1 ring-inset ring-slate-200 shadow-sm"
                    >
                        Check Your Eligibility Now
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
        // Inputs
        const amtInput = document.getElementById("calc-amount");
        const amtDisplay = document.getElementById("calc-amount-display");
        const amtButtons = document.querySelectorAll(".amount-btn");
        const termInput = document.getElementById("calc-term");
        const termDisplay = document.getElementById("calc-term-display");
        const termButtons = document.querySelectorAll(".term-btn");
        const aprInput = document.getElementById("calc-apr");
        const aprSlider = document.getElementById("calc-apr-slider");

        // Outputs
        const monthlyOut = document.getElementById("calc-monthly-output");
        const principalOut = document.getElementById("calc-principal-output");
        const interestOut = document.getElementById("calc-interest-output");
        const totalOut = document.getElementById("calc-total-output");

        // Amount buttons
        const activeClass = ["border-orange-500", "bg-orange-50", "text-orange-600"];
        const inactiveClass = ["border-slate-200", "bg-white", "text-slate-700"];
        amtButtons.forEach((btn) => {
            btn.addEventListener("click", () => {
                amtButtons.forEach((b) => {
                    b.classList.remove(...activeClass);
                    b.classList.add(...inactiveClass);
                });
                btn.classList.remove(...inactiveClass);
                btn.classList.add(...activeClass);
                amtInput.value = btn.dataset.amount;
                amtDisplay.textContent = new Intl.NumberFormat("en-US", { style: "currency", currency: "USD", maximumFractionDigits: 0 }).format(btn.dataset.amount);
                calculate();
            });
        });

        // Term buttons
        termButtons.forEach((btn) => {
            btn.addEventListener("click", () => {
                termButtons.forEach((b) => {
                    b.classList.remove(...activeClass);
                    b.classList.add(...inactiveClass);
                });
                btn.classList.remove(...inactiveClass);
                btn.classList.add(...activeClass);
                termInput.value = btn.dataset.term;
                termDisplay.textContent = btn.dataset.term + " mo";
                calculate();
            });
        });

        // Sync apr input <-> slider
        const sync = (inputNode, sliderNode) => {
            inputNode.addEventListener("input", (e) => {
                sliderNode.value = e.target.value;
                calculate();
            });
            sliderNode.addEventListener("input", (e) => {
                inputNode.value = e.target.value;
                calculate();
            });
        };

        sync(aprInput, aprSlider);

        // Formatter
        const currency = new Intl.NumberFormat("en-US", {
            style: "currency",
            currency: "USD",
            maximumFractionDigits: 0,
        });

        const calculate = () => {
            const p = parseFloat(amtInput.value) || 1000;
            const termMonths = parseInt(termInput.value) || 1;
            const aprValue = parseFloat(aprInput.value) || 0;

            if (p <= 0 || termMonths <= 0) {
                monthlyOut.innerHTML = `$0<span class="text-xl font-medium text-slate-400">/mo</span>`;
                return;
            }

            if (aprValue === 0) {
                // Zero interest
                const monthly = p / termMonths;
                monthlyOut.innerHTML = `${currency.format(monthly)}<span class="text-xl font-medium text-slate-400">/mo</span>`;
                principalOut.textContent = currency.format(p);
                interestOut.textContent = currency.format(0);
                totalOut.textContent = currency.format(p);
                return;
            }

            const r = aprValue / 100 / 12;
            const n = termMonths;

            // PMT Formula: M = P[r(1+r)^n] / [(1+r)^n - 1]
            const numerator = p * r * Math.pow(1 + r, n);
            const denominator = Math.pow(1 + r, n) - 1;
            const pmt = numerator / denominator;

            const totalRepaid = pmt * n;
            const totalInterest = totalRepaid - p;

            monthlyOut.innerHTML = `${currency.format(pmt)}<span class="text-xl font-medium text-slate-400">/mo</span>`;
            principalOut.textContent = currency.format(p);
            interestOut.textContent = currency.format(totalInterest);
            totalOut.textContent = currency.format(totalRepaid);
        };

        // Initial calc
        aprSlider.value = aprInput.value;
        calculate();
    });
</script>
