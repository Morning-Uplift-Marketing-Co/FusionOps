---
---

<section class="mx-auto w-full max-w-7xl px-6 mt-12 sm:mt-16 section-stagger" style="--delay: 200ms;">
  <div class="mb-8 text-center">
    <h2 class="text-2xl sm:text-3xl font-extrabold font-heading text-slate-900 mb-2">
      How It Works
    </h2>
    <p class="text-sm sm:text-base text-slate-500 max-w-md mx-auto leading-relaxed">
      Get connected with a lender in minutes — no credit impact during pre-check.
    </p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 sm:gap-6 relative">
    <!-- Connector line (desktop only) -->
    <div class="hidden sm:block absolute top-10 left-[calc(16.67%+1.5rem)] right-[calc(16.67%+1.5rem)] h-0.5 bg-gradient-to-r from-orange-200 via-orange-300 to-orange-200 z-0"></div>

    <!-- Step 1 -->
    <div class="relative z-10 bg-white rounded-2xl border border-slate-100 shadow-sm p-6 flex sm:flex-col items-start sm:items-center gap-4 sm:gap-3 sm:text-center">
      <div class="flex-shrink-0 w-12 h-12 rounded-2xl bg-orange-500 flex items-center justify-center shadow-md shadow-orange-500/30">
        <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
        </svg>
      </div>
      <div>
        <p class="text-[0.65rem] font-bold text-orange-500 uppercase tracking-widest mb-0.5">Step 1</p>
        <h3 class="text-base font-bold text-slate-900 mb-1">Enter Your ZIP Code</h3>
        <p class="text-sm text-slate-500 leading-relaxed">Start with a quick ZIP pre-check. No credit impact, no commitment required.</p>
      </div>
    </div>

    <!-- Step 2 -->
    <div class="relative z-10 bg-white rounded-2xl border border-slate-100 shadow-sm p-6 flex sm:flex-col items-start sm:items-center gap-4 sm:gap-3 sm:text-center">
      <div class="flex-shrink-0 w-12 h-12 rounded-2xl bg-sky-500 flex items-center justify-center shadow-md shadow-sky-500/30">
        <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
        </svg>
      </div>
      <div>
        <p class="text-[0.65rem] font-bold text-sky-500 uppercase tracking-widest mb-0.5">Step 2</p>
        <h3 class="text-base font-bold text-slate-900 mb-1">Review Your Options</h3>
        <p class="text-sm text-slate-500 leading-relaxed">Compare tailored loan offers with clear rates, terms, and monthly payment estimates.</p>
      </div>
    </div>

    <!-- Step 3 -->
    <div class="relative z-10 bg-white rounded-2xl border border-slate-100 shadow-sm p-6 flex sm:flex-col items-start sm:items-center gap-4 sm:gap-3 sm:text-center">
      <div class="flex-shrink-0 w-12 h-12 rounded-2xl bg-emerald-500 flex items-center justify-center shadow-md shadow-emerald-500/30">
        <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z" />
        </svg>
      </div>
      <div>
        <p class="text-[0.65rem] font-bold text-emerald-500 uppercase tracking-widest mb-0.5">Step 3</p>
        <h3 class="text-base font-bold text-slate-900 mb-1">Get Funded</h3>
        <p class="text-sm text-slate-500 leading-relaxed">Accept an offer that suits you and receive funds as fast as the next business day.</p>
      </div>
    </div>
  </div>
</section>
