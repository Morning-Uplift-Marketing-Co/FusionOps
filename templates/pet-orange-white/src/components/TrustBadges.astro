---

---

<section
  class="section-stagger mx-auto w-full max-w-7xl px-6 mt-16 sm:mt-20"
  style="--delay: 150ms;"
>
  <p class="text-center text-xs font-semibold uppercase tracking-widest text-slate-400 mb-6">
    Trusted & Secure
  </p>

  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">

    <!-- SSL Encrypted -->
    <div class="flex flex-col items-center gap-2 rounded-2xl border border-slate-100 bg-white px-4 py-5 shadow-sm text-center">
      <div class="w-10 h-10 rounded-xl bg-emerald-50 flex items-center justify-center text-emerald-600 border border-emerald-100">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
        </svg>
      </div>
      <span class="text-xs font-semibold text-slate-700 leading-tight">256-bit SSL<br/>Encrypted</span>
    </div>

    <!-- No Hard Pull -->
    <div class="flex flex-col items-center gap-2 rounded-2xl border border-slate-100 bg-white px-4 py-5 shadow-sm text-center">
      <div class="w-10 h-10 rounded-xl bg-sky-50 flex items-center justify-center text-sky-600 border border-sky-100">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>
      <span class="text-xs font-semibold text-slate-700 leading-tight">No Hard<br/>Credit Pull</span>
    </div>

    <!-- Data Privacy -->
    <div class="flex flex-col items-center gap-2 rounded-2xl border border-slate-100 bg-white px-4 py-5 shadow-sm text-center">
      <div class="w-10 h-10 rounded-xl bg-violet-50 flex items-center justify-center text-violet-600 border border-violet-100">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
        </svg>
      </div>
      <span class="text-xs font-semibold text-slate-700 leading-tight">Data Privacy<br/>Protected</span>
    </div>

    <!-- No Obligation -->
    <div class="flex flex-col items-center gap-2 rounded-2xl border border-slate-100 bg-white px-4 py-5 shadow-sm text-center">
      <div class="w-10 h-10 rounded-xl bg-orange-50 flex items-center justify-center text-orange-500 border border-orange-100">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 12c0-1.232-.046-2.453-.138-3.662a4.006 4.006 0 00-3.7-3.7 48.678 48.678 0 00-7.324 0 4.006 4.006 0 00-3.7 3.7c-.017.22-.032.441-.046.662M19.5 12l3-3m-3 3l-3-3m-12 3c0 1.232.046 2.453.138 3.662a4.006 4.006 0 003.7 3.7 48.656 48.656 0 007.324 0 4.006 4.006 0 003.7-3.7c.017-.22.032-.441.046-.662M4.5 12l3 3m-3-3l-3 3" />
        </svg>
      </div>
      <span class="text-xs font-semibold text-slate-700 leading-tight">No Obligation<br/>to Accept</span>
    </div>

    <!-- FCRA Compliant -->
    <div class="flex flex-col items-center gap-2 rounded-2xl border border-slate-100 bg-white px-4 py-5 shadow-sm text-center">
      <div class="w-10 h-10 rounded-xl bg-slate-50 flex items-center justify-center text-slate-600 border border-slate-200">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
        </svg>
      </div>
      <span class="text-xs font-semibold text-slate-700 leading-tight">FCRA<br/>Compliant</span>
    </div>

    <!-- Free Service -->
    <div class="flex flex-col items-center gap-2 rounded-2xl border border-slate-100 bg-white px-4 py-5 shadow-sm text-center">
      <div class="w-10 h-10 rounded-xl bg-amber-50 flex items-center justify-center text-amber-600 border border-amber-100">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>
      <span class="text-xs font-semibold text-slate-700 leading-tight">100% Free<br/>Service</span>
    </div>

  </div>
</section>
