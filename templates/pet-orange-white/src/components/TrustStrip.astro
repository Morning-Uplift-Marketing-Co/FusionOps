---

---

<section
  class="section-stagger w-full max-w-7xl mx-auto px-6"
  style="--delay: 300ms;"
>
  <div class="grid gap-6 sm:grid-cols-3">
    <div
      class="glass-card p-6 flex flex-col sm:items-center text-left sm:text-center transition-transform hover:-translate-y-1"
    >
      <div
        class="w-12 h-12 bg-sky-100/80 rounded-2xl flex items-center justify-center text-sky-600 mb-4 shadow-sm border border-sky-200/50"
      >
        <svg
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          class="w-6 h-6"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M15.042 21.672L13.684 16.6m0 0l-2.51 2.225.569-9.47 5.227 7.917-3.286-.672zm-7.518-.267A8.25 8.25 0 1120.25 10.5M8.288 14.212A5.25 5.25 0 1117.25 10.5"
          ></path></svg
        >
      </div>
      <h3 class="text-lg font-bold text-slate-900 mb-2">
        Straightforward Process
      </h3>
      <p class="text-sm text-slate-500 leading-relaxed text-balance">
        Start with ZIP, continue through a guided form, and review options
        clearly.
      </p>
    </div>

    <div
      class="glass-card p-6 flex flex-col sm:items-center text-left sm:text-center transition-transform hover:-translate-y-1 relative overflow-hidden"
    >
      <!-- subtle highlight -->
      <div
        class="absolute -top-10 -right-10 w-32 h-32 bg-orange-100 rounded-full blur-2xl opacity-60 pointer-events-none"
      >
      </div>

      <div
        class="relative w-12 h-12 bg-orange-100/80 rounded-2xl flex items-center justify-center text-orange-600 mb-4 shadow-sm border border-orange-200/50"
      >
        <svg
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          class="w-6 h-6"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m3.75 9v6m3-3H9m1.5-12H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"
          ></path></svg
        >
      </div>
      <h3 class="relative text-lg font-bold text-slate-900 mb-2">
        Transparent Terms
      </h3>
      <p class="relative text-sm text-slate-500 leading-relaxed text-balance">
        Rates, repayment details, and lender conditions are presented before
        acceptance.
      </p>
    </div>

    <div
      class="glass-card p-6 flex flex-col sm:items-center text-left sm:text-center transition-transform hover:-translate-y-1"
    >
      <div
        class="w-12 h-12 bg-emerald-100/80 rounded-2xl flex items-center justify-center text-emerald-600 mb-4 shadow-sm border border-emerald-200/50"
      >
        <svg
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          class="w-6 h-6"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z"
          ></path></svg
        >
      </div>
      <h3 class="text-lg font-bold text-slate-900 mb-2">
        Built for Confidence
      </h3>
      <p class="text-sm text-slate-500 leading-relaxed text-balance">
        Compliance-minded experience designed to help users make informed
        decisions.
      </p>
    </div>
  </div>
</section>
