---

---

<dialog
    id="legal-modal"
    class="backdrop:bg-slate-900/60 p-0 rounded-3xl max-w-2xl w-11/12 mx-auto my-auto shadow-2xl open:animate-in open:zoom-in-95 backdrop:open:animate-in backdrop:open:fade-in border-0 open:flex flex-col max-h-[85vh]"
>
    <div
        class="px-6 py-4 flex items-center justify-between border-b border-slate-100 bg-white sticky top-0"
    >
        <h3
            id="modal-title"
            class="font-bold text-slate-900 text-lg sm:text-xl font-heading"
        >
            Legal Information
        </h3>
        <button
            id="close-modal"
            class="p-2 hover:bg-slate-100 rounded-full transition-colors text-slate-500 hover:text-slate-800 focus-visible:outline-2 focus-visible:outline-orange-500"
        >
            <svg
                class="w-5 h-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M6 18L18 6M6 6l12 12"></path></svg
            >
            <span class="sr-only">Close</span>
        </button>
    </div>

    <div
        id="modal-content"
        class="p-6 overflow-y-auto bg-slate-50 text-slate-600 text-sm leading-relaxed prose prose-slate"
    >
        <!-- Dynamic content injected here via client JS -->
        <div class="animate-pulse space-y-4">
            <div class="h-4 bg-slate-200 rounded w-3/4"></div>
            <div class="h-4 bg-slate-200 rounded w-1/2"></div>
            <div class="h-4 bg-slate-200 rounded w-5/6"></div>
            <div class="h-4 bg-slate-200 rounded w-2/3"></div>
            <div class="h-4 bg-slate-200 rounded w-full"></div>
            <div class="h-4 bg-slate-200 rounded w-4/5"></div>
        </div>
    </div>
    <div
        class="px-6 py-4 border-t border-slate-100 bg-white sm:flex sm:flex-row-reverse sticky bottom-0"
    >
        <button
            id="close-modal-bottom"
            type="button"
            class="mt-3 inline-flex w-full justify-center rounded-xl bg-slate-100 px-4 py-2.5 text-sm font-semibold text-slate-900 shadow-sm ring-1 ring-inset ring-slate-300 hover:bg-slate-200 sm:mt-0 sm:w-auto transition-colors focus-visible:outline-2 focus-visible:outline-orange-500"
        >
            Close
        </button>
    </div>
</dialog>

<script data-cfasync="false" is:inline>
    document.addEventListener("DOMContentLoaded", () => {
        const dialog = document.getElementById("legal-modal");
        const closeBtns = [
            document.getElementById("close-modal"),
            document.getElementById("close-modal-bottom"),
        ];
        const modalTitle = document.getElementById("modal-title");
        const modalContent = document.getElementById("modal-content");
        const triggerLinks = document.querySelectorAll("a[data-legal-modal]");

        const contentCache = {};

        const openModal = async (url, title) => {
            modalTitle.textContent = title;
            dialog.showModal();
            document.body.style.overflow = "hidden";

            if (contentCache[url]) {
                modalContent.innerHTML = contentCache[url];
                return;
            }

            // Show skeleton
            modalContent.innerHTML = `
        <div class="animate-pulse space-y-4">
          <div class="h-4 bg-slate-200 rounded w-3/4"></div>
          <div class="h-4 bg-slate-200 rounded w-full"></div>
          <div class="h-4 bg-slate-200 rounded w-5/6"></div>
          <div class="h-4 bg-slate-200 rounded w-4/5"></div>
        </div>
      `;

            try {
                const res = await fetch(url);
                const html = await res.text();
                const parser = new DOMParser();
                const doc = parser.parseFromString(html, "text/html");
                // Assuming pages have a main tag containing the content
                const mainContent =
                    doc.querySelector("main")?.innerHTML ||
                    "<p>Error loading content.</p>";
                contentCache[url] = mainContent;
                modalContent.innerHTML = mainContent;
            } catch (err) {
                modalContent.innerHTML =
                    '<p class="text-red-500">Failed to load legal document.</p>';
            }
        };

        const closeModal = () => {
            dialog.close();
            document.body.style.overflow = "";
            modalContent.scrollTo(0, 0);
        };

        triggerLinks.forEach((link) => {
            link.addEventListener("click", (e) => {
                e.preventDefault();
                openModal(link.href, link.textContent);
            });
        });

        closeBtns.forEach((btn) => {
            if (btn) btn.addEventListener("click", closeModal);
        });

        // Close on backdrop click
        dialog.addEventListener("click", (e) => {
            const dialogDimensions = dialog.getBoundingClientRect();
            if (
                e.clientX < dialogDimensions.left ||
                e.clientX > dialogDimensions.right ||
                e.clientY < dialogDimensions.top ||
                e.clientY > dialogDimensions.bottom
            ) {
                closeModal();
            }
        });
    });
</script>

<style>
    /* Basic enter animation for native dialog */
    dialog[open] {
        animation: zoom-in 0.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    dialog::backdrop {
        animation: fade-in 0.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    @keyframes zoom-in {
        0% {
            transform: scale(0.95);
            opacity: 0;
        }
        100% {
            transform: scale(1);
            opacity: 1;
        }
    }
    @keyframes fade-in {
        0% {
            background-color: rgba(15, 23, 42, 0);
        }
        100% {
            background-color: rgba(15, 23, 42, 0.6);
        }
    }
</style>
