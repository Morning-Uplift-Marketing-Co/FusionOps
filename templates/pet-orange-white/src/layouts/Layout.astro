---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

const conversionId   = import.meta.env.PUBLIC_CONVERSIONID      || '';
const formStartLabel = import.meta.env.PUBLIC_FORMSTARTLABEL    || '';
const formSubmitLabel= import.meta.env.PUBLIC_FORMSUBMITLABEL   || '';
const voluumClickUrl = import.meta.env.PUBLIC_VOLUUM_CLICK_URL  || '';
const voluumDomain   = import.meta.env.PUBLIC_VOLUUMDOMAIN      || '';
const domain         = import.meta.env.PUBLIC_DOMAIN            || '';
const ctaHref        = voluumClickUrl || '#apply';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <slot name="head" />
    <style is:inline>body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif}</style>
    {conversionId && (
      <script data-cfasync="false" async src={`https://www.googletagmanager.com/gtag/js?id=${conversionId}`} is:inline></script>
    )}
    {voluumDomain && (
      <script data-cfasync="false" is:inline define:vars={{ voluumDomain }}>
        (function(){var s=document.createElement('script');s.src='https://'+voluumDomain+'/scripts/vp.js';s.async=true;document.head.appendChild(s);})();
      </script>
    )}
    <script data-cfasync="false" is:inline define:vars={{ conversionId, formStartLabel, formSubmitLabel }}>
      (function(){
        function gtag(){window.dataLayer=window.dataLayer||[];window.dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', conversionId);
        window.__gtagConversionId = conversionId;
        window.__formStartLabel   = formStartLabel;
        window.__formSubmitLabel  = formSubmitLabel;
      })();
    </script>
  </head>
  <body
    class="bg-[#f8fafc] text-slate-800 antialiased selection:bg-orange-500 selection:text-white"
  >
    <script data-cfasync="false" is:inline define:vars={{ domain }}>
    (function(){
      function fpPixel(eventName, extra) {
        try {
          var endpoint = 'https://t.' + window.location.hostname + '/e';
          var payload = Object.assign({ e: eventName, d: window.location.hostname, ts: Date.now() }, extra || {});
          navigator.sendBeacon(endpoint, JSON.stringify(payload));
        } catch(_) {}
      }
      if (!window.__fpPageTracked) { window.__fpPageTracked = true; fpPixel('pv'); }
      window.__fpPixel = fpPixel;
    })();
    </script>

    <div class="relative min-h-screen overflow-hidden flex flex-col">
      <div
        class="fixed inset-0 z-0 pointer-events-none w-full h-full overflow-hidden"
      >
        <div
          class="absolute -top-[10%] -left-[10%] w-[50%] h-[50%] rounded-full bg-sky-200/30 blur-[80px]"
        >
        </div>
        <div
          class="absolute top-[20%] -right-[10%] w-[40%] h-[60%] rounded-full bg-orange-100/30 blur-[80px]"
        >
        </div>
        <div
          class="absolute -bottom-[20%] left-[20%] w-[60%] h-[50%] rounded-full bg-emerald-100/30 blur-[80px]"
        >
        </div>
      </div>

      <div class="relative z-10 flex-1 flex flex-col">
        <slot />
      </div>

      <footer
        class="relative z-10 mt-auto border-t border-slate-200/60 bg-white/80 backdrop-blur-md py-10"
      >
        <div
          class="mx-auto flex w-full max-w-7xl flex-col gap-6 px-6 md:flex-row md:items-center md:justify-between text-sm text-slate-500"
        >
          <div class="max-w-3xl">
            <p class="font-semibold text-slate-900 mb-2">
              Affiliate & Regulatory Disclosure
            </p>
            <p class="leading-relaxed mb-4 text-xs text-slate-500">
              This website is not a lender and does not make credit decisions.
              We provide a marketing lead generation service to a network of
              independent lenders. We may receive compensation from the lenders
              we connect you with. This compensation may impact how and where
              products appear on this site. This service is not available in all
              states. You are under no obligation to use this site or accept any
              loan offer from our network. Always review your lender's terms
              carefully before accepting an offer.
            </p>
            <p class="font-medium text-orange-600">
              Borrow only what you need and can afford to repay.
            </p>
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>
