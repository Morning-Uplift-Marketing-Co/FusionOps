# Public client-safe variables (Astro exposes only PUBLIC_* to browser)
PUBLIC_LEADSGATE_ACCOUNT_ID=your_public_account_id
PUBLIC_LEADSGATE_CAMPAIGN_ID=your_public_campaign_id
PUBLIC_LEADSGATE_SOURCE=flexible-funding-template

# Server-only variables (never exposed to browser)
BACKEND_BASE_URL=https://your-backend.example.com
CALLBACK_TOKEN=replace_with_secure_callback_token
DEFAULT_ACCOUNT_ID=optional_fallback_account_id
