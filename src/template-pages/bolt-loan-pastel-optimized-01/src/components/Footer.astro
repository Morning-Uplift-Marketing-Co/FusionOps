---
const brand = import.meta.env.PUBLIC_BRAND || 'Pastel Lending';
const aprMin = import.meta.env.PUBLIC_APRMIN || '5.99';
const aprMax = import.meta.env.PUBLIC_APRMAX || '34.99';
const amtMin = import.meta.env.PUBLIC_AMOUNTMIN || '1,000';
const amtMax = import.meta.env.PUBLIC_AMOUNTMAX || '5,000';
---

<!-- Pre-footer CTA -->
<section class="relative py-24 overflow-hidden prefooter-glow">
  <div class="max-w-2xl mx-auto px-4 sm:px-6 text-center reveal">
    <span class="section-label">Competitive Rates Available</span>
    <h2 class="text-3xl sm:text-4xl font-display font-bold text-foreground mb-4 leading-tight">
      Your Best Rate Is Waiting
    </h2>
    <p class="text-foreground/55 text-base mb-8 max-w-lg mx-auto leading-relaxed">
      Check your rate in 3 minutes with no impact to your credit score. Join 50,000+ borrowers who chose {brand}.
    </p>
    <a href="/apply" class="btn-primary inline-flex">
      Get My Rate Now — It's Free
    </a>
    <div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-3 max-w-xl mx-auto">
      {[
        'No hard credit pull to check rate',
        'Funds as fast as same day',
        'Fixed monthly payments',
        'No prepayment penalties',
      ].map(item => (
        <div class="flex items-center gap-2 text-xs text-foreground/55">
          <svg class="w-3.5 h-3.5 text-primary flex-shrink-0" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
          </svg>
          {item}
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Regulatory Disclosures -->
<section class="py-10 bg-secondary/30 border-t border-border/60">
  <div class="max-w-4xl mx-auto px-4 sm:px-6">
    <div class="disclosure-border border-l-2 pl-5">
      <button class="flex items-center gap-2 text-xs font-semibold text-foreground/50 uppercase tracking-wider mb-3 hover:text-foreground/80 transition-colors" id="disclosure-toggle">
        <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/></svg>
        Important Regulatory Disclosures
      </button>
      <div id="disclosure-content" class="hidden">
        <p class="text-xs text-foreground/40 leading-relaxed mb-2">
          <strong>Loan Terms &amp; Amounts:</strong> Loan amounts range from ${amtMin} to ${amtMax}. Minimum repayment term: 61 days. Maximum repayment term: 60 months (5 years). All loan products offered through this platform require repayment in full in 61 days or longer.
        </p>
        <p class="text-xs text-foreground/40 leading-relaxed mb-2">
          <strong>Maximum APR:</strong> The maximum Annual Percentage Rate (APR) for personal loans available through this platform is {aprMax}%. APR is calculated in accordance with the Truth in Lending Act (TILA), 12 CFR Part 1026, and includes the interest rate plus all applicable fees. Minimum APR: {aprMin}%.
        </p>
        <p class="text-xs text-foreground/40 leading-relaxed mb-2">
          <strong>Representative Example:</strong> A loan of $5,000 repaid over 36 months at a fixed APR of 14.99% results in 36 monthly payments of $173.17. Total amount repayable: $6,234.12 (including $1,234.12 in interest and fees). Representative APR: 14.99%. Your actual rate will depend on credit score, income, loan amount, loan term, and other factors. Not all applicants will qualify for the lowest rate advertised.
        </p>
        <p class="text-xs text-foreground/40 leading-relaxed">
          <strong>Marketplace Disclosure:</strong> {brand} is not a direct lender. {brand} operates as a loan referral marketplace connecting consumers with a network of third-party lenders. {brand} does not make credit decisions. {brand} may receive compensation from lenders for referrals. Please review each lender's terms, rates, and fees carefully before accepting any loan offer.
        </p>
      </div>
    </div>
  </div>
</section>

<!-- Main Footer -->
<footer class="bg-foreground/5 border-t border-border pt-14 pb-8">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-8 mb-12">
      <!-- Brand -->
      <div class="col-span-2 sm:col-span-1">
        <div class="flex items-center gap-2 mb-3">
          <div class="w-7 h-7 rounded-lg brand-icon-bg flex items-center justify-center">
            <svg class="w-4 h-4 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
          </div>
          <span class="font-display font-bold text-foreground text-base">{brand}</span>
        </div>
        <p class="text-xs text-foreground/45 leading-relaxed mb-3">
          Premium installment loans with fixed payments and transparent terms. NMLS #123456.
        </p>
        <div class="flex items-center gap-1.5 text-xs text-foreground/35">
          <svg class="w-3 h-3 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
          256-bit SSL Encrypted
        </div>
      </div>
      {[
        { heading: 'Loans', links: ['Debt Consolidation', 'Home Improvement', 'Medical Loans'] },
        { heading: 'Learn', links: ['How It Works', 'Payment Calculator', 'APR & Rates', 'FAQ'] },
        { heading: 'Company', links: ['About Us', 'Privacy Policy', 'Terms of Service', 'Accessibility'] },
      ].map(col => (
        <div>
          <h4 class="text-xs font-bold text-foreground/70 uppercase tracking-wider mb-3">{col.heading}</h4>
          <ul class="space-y-2">
            {col.links.map(link => (
              <li>
                <button
                  class="text-xs text-foreground/45 hover:text-foreground transition-colors text-left"
                  data-popup={link}
                >
                  {link}
                </button>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <div class="border-t border-border/60 pt-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
      <p class="text-xs text-foreground/30">&copy; {new Date().getFullYear()} {brand}. All rights reserved. NMLS #123456.</p>
      <p class="text-xs text-foreground/25">Loans subject to lender approval and applicable state and federal laws. Not available in all states.</p>
    </div>
  </div>
</footer>

<!-- Popup modal -->
<div id="popup-modal" class="fixed inset-0 z-50 flex items-end sm:items-center justify-center p-4 opacity-0 pointer-events-none transition-opacity duration-200" aria-hidden="true">
  <div class="absolute inset-0 bg-foreground/30 backdrop-blur-sm" id="popup-modal-backdrop"></div>
  <div id="popup-modal-box" class="relative glass-card max-w-md w-full p-6 sm:p-8 scale-95 transition-transform duration-200 inert">
    <button id="popup-modal-close" class="absolute top-4 right-4 w-8 h-8 flex items-center justify-center rounded-full hover:bg-secondary/50 transition-colors text-foreground/50 hover:text-foreground">
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
    </button>
    <h3 id="popup-modal-title" class="font-display font-bold text-lg text-foreground mb-3"></h3>
    <p id="popup-modal-body" class="text-sm text-foreground/60 leading-relaxed whitespace-pre-line"></p>
  </div>
</div>

<script>
  // popupContent moved from frontmatter to script so it's available at runtime
  var popupContent = {
    'Debt Consolidation': {
      title: 'Debt Consolidation',
      body: 'Combine multiple high-interest debts into one simple monthly payment. Many borrowers reduce their overall interest cost significantly by consolidating credit cards and other loans.',
    },
    'Home Improvement': {
      title: 'Home Improvement',
      body: 'Finance repairs, renovations, or upgrades without tapping into your home equity. Fixed monthly payments make it easy to budget for your project from start to finish.',
    },
    'Medical Loans': {
      title: 'Medical Loans',
      body: 'Cover unexpected medical expenses with a fixed-rate loan. We work with borrowers across a wide credit spectrum and offer same-day funding in most cases.',
    },
    'How It Works': {
      title: 'How It Works',
      body: '1. Check your rate in minutes with no impact to your credit score.\n2. Review your personalized offers and choose the best fit.\n3. Sign your documents electronically.\n4. Receive funds directly in your bank account — often the same day.',
    },
    'Payment Calculator': {
      title: 'Payment Calculator',
      body: 'Use our interactive calculator to estimate your monthly payment. Adjust the loan amount, term, and APR to see how different scenarios affect your budget before you apply.',
    },
    'APR & Rates': {
      title: 'APR & Rates',
      body: 'Rates range from 5.99% to 34.99% APR based on creditworthiness and loan term. Rates are fixed for the life of the loan — your payment will never change. No hidden fees or prepayment penalties.',
    },
    'FAQ': {
      title: 'Frequently Asked Questions',
      body: 'Q: Will checking my rate hurt my credit?\nA: No. Rate checks use a soft inquiry.\n\nQ: How fast can I receive funds?\nA: As fast as same business day after approval.\n\nQ: Are there prepayment penalties?\nA: Never. Pay off early at no cost.',
    },
    'About Us': {
      title: 'About Us',
      body: 'We connect borrowers with a network of trusted lenders to deliver competitive fixed-rate personal loans. Our mission is to make borrowing transparent, fast, and fair for everyone.',
    },
    'Privacy Policy': {
      title: 'Privacy Policy',
      body: 'We collect only the information necessary to process your loan application. Your data is encrypted, never sold to third parties, and stored in compliance with applicable federal and state privacy laws. You may request deletion of your data at any time.',
    },
    'Terms of Service': {
      title: 'Terms of Service',
      body: 'By using our service, you agree to our terms governing loan applications, rate inquiries, and communications. We operate as a loan marketplace. Loan approval and terms are determined by individual lenders.',
    },
    'Accessibility': {
      title: 'Accessibility',
      body: 'We are committed to ensuring digital accessibility for people with disabilities. We continually improve the user experience for everyone and apply relevant accessibility standards.',
    },
  };

  var modal = document.getElementById('popup-modal');
  var modalBox = document.getElementById('popup-modal-box');
  var titleEl = document.getElementById('popup-modal-title');
  var bodyEl = document.getElementById('popup-modal-body');
  var closeBtn = document.getElementById('popup-modal-close');
  var backdrop = document.getElementById('popup-modal-backdrop');

  var lastFocusedEl = null;

  function openPopup(key, triggerEl) {
    var entry = popupContent[key];
    if (!entry || !modal) return;
    lastFocusedEl = triggerEl || null;
    titleEl.textContent = entry.title;
    bodyEl.textContent = entry.body;
    modal.removeAttribute('aria-hidden');
    modalBox.removeAttribute('inert');
    modal.classList.remove('opacity-0', 'pointer-events-none');
    modalBox.classList.remove('scale-95');
    document.body.classList.add('overflow-hidden');
    if (closeBtn) closeBtn.focus();
  }

  function closePopup() {
    if (!modal) return;
    modal.setAttribute('aria-hidden', 'true');
    modalBox.setAttribute('inert', '');
    modal.classList.add('opacity-0', 'pointer-events-none');
    modalBox.classList.add('scale-95');
    document.body.classList.remove('overflow-hidden');
    if (lastFocusedEl) lastFocusedEl.focus();
  }

  document.addEventListener('click', function(e) {
    var btn = e.target.closest('[data-popup]');
    if (btn) { openPopup(btn.dataset.popup, btn); return; }
    if (e.target === modal || e.target === backdrop) closePopup();
  });

  if (closeBtn) closeBtn.addEventListener('click', closePopup);

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closePopup();
  });

  // Disclosure toggle
  var discToggle = document.getElementById('disclosure-toggle');
  var discContent = document.getElementById('disclosure-content');
  if (discToggle && discContent) {
    discToggle.addEventListener('click', function() {
      discContent.classList.toggle('hidden');
    });
  }
</script>
