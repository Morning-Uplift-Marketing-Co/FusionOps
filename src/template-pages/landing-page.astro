---
/// Landing Page Template with Hero, Calculator, Reviews, FAQ, and Trust Badges
/// Variables (configure these via Astro props or integration):
/// - brand: Company name
/// - h1: Main heading text
/// - sub: Subheading/hero text
/// - cta: CTA button text
/// - phone: Contact phone number
/// - email: Contact email
/// - primaryColor: Primary brand color (hex)
/// - accentColor: Accent color (hex)
/// - amountMin: Minimum loan amount
/// - amountMax: Maximum loan amount
/// - amountMinRaw: Minimum for slider
/// - amountMaxRaw: Maximum for slider
/// - aprMin: Minimum APR
/// - aprMax: Maximum APR

interface Props {
  brand: string;
  h1: string;
  sub: string;
  cta: string;
  phone: string;
  email: string;
  primaryColor: string;
  accentColor: string;
  amountMin: string;
  amountMax: string;
  amountMinRaw: string;
  amountMaxRaw: string;
  aprMin: string;
  aprMax: string;
  conversionId: string;
}

const {
  brand = "LoanBridge",
  h1 = "Get Fast Approval",
  sub = "Flexible payment plans for your needs",
  cta = "Get Started",
  phone = "1-800-555-0123",
  email = "support@example.com",
  primaryColor = "#3b5bdb",
  accentColor = "#00b894",
  amountMin = "500",
  amountMax = "10,000",
  amountMinRaw = "500",
  amountMaxRaw = "10000",
  aprMin = "5.99",
  aprMax = "35.99",
  conversionId = "G-XXXXXXXXXX"
} = Astro.props as Props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{brand} — Installment Loans | Flexible Payment Plans</title>
  <link rel="icon" type="image/svg+xml" href={`data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='8' fill='${primaryColor}'/><text x='50%' y='54%' dominant-baseline='middle' text-anchor='middle' font-size='18' font-family='system-ui,sans-serif' font-weight='800' fill='white'>$</text></svg>`} />
  <meta name="description" content={`Get up to $${amountMax} with flexible installment plans. Fast approval, no hard credit check. Apply in minutes.`} />
  <script async src={`https://www.googletagmanager.com/gtag/js?id=${conversionId}`}></script>
  <script is:inline define:vars={{ conversionId }}>
    window.dataLayer = window.dataLayer || [];
    function gtag() { window.dataLayer.push(arguments); }
    window.gtag = window.gtag || gtag;
    window.gtag('js', new Date());
    window.gtag('config', conversionId);
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  <style define:vars={{
    colorPrimary: primaryColor,
    colorAccent: accentColor
  }}>
    :root {
      --color-primary: var(--colorPrimary);
      --color-accent: var(--colorAccent);
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body { font-family: 'Inter', system-ui, sans-serif; background: #f8f9fa; color: #1a1a2e; line-height: 1.6; -webkit-font-smoothing: antialiased; }
    .container { width: 100%; max-width: 1100px; margin: 0 auto; padding: 0 20px; }
    a { color: inherit; text-decoration: none; }
    img { display: block; max-width: 100%; }

    /* ── NAV ── */
    nav { position: fixed; top: 0; left: 0; right: 0; z-index: 100; background: #fff; border-bottom: 1px solid #e8eaf0; height: 64px; display: flex; align-items: center; }
    .nav-inner { display: flex; align-items: center; justify-content: space-between; width: 100%; }
    .nav-logo { font-size: 1.2rem; font-weight: 800; color: #1a1a2e; display: flex; align-items: center; gap: 8px; }
    .nav-logo span { font-size: 1.4rem; }
    .nav-right { display: flex; align-items: center; gap: 20px; }
    .nav-phone { font-size: 0.875rem; font-weight: 600; color: #4a5568; display: flex; align-items: center; gap: 6px; }
    .btn-nav { background: var(--color-primary); color: #fff; padding: 9px 22px; border-radius: 8px; font-weight: 700; font-size: 0.875rem; border: none; cursor: pointer; transition: background 0.2s; }
    .btn-nav:hover { background: var(--color-primary); opacity: 0.88; }

    /* ── HERO ── */
    .hero { background: linear-gradient(135deg, color-mix(in srgb, var(--color-primary) 80%, #000) 0%, var(--color-primary) 50%, color-mix(in srgb, var(--color-primary) 80%, #fff) 100%); color: #fff; padding: 120px 20px 80px; text-align: center; position: relative; overflow: hidden; }
    .hero::before { content: ''; position: absolute; inset: 0; background: radial-gradient(ellipse at 70% 50%, rgba(255,255,255,0.06) 0%, transparent 60%); pointer-events: none; }
    .hero-badge { display: inline-flex; align-items: center; gap: 8px; background: rgba(255,255,255,0.15); border: 1px solid rgba(255,255,255,0.25); border-radius: 99px; padding: 6px 16px; font-size: 0.8125rem; font-weight: 600; margin-bottom: 24px; }
    .hero-badge::before { content: '✦'; color: #ffd43b; }
    .hero h1 { font-size: clamp(2rem, 5vw, 3.5rem); font-weight: 900; line-height: 1.1; margin-bottom: 20px; max-width: 780px; margin-left: auto; margin-right: auto; }
    .hero h1 em { font-style: normal; color: #ffd43b; }
    .hero-sub { font-size: 1.125rem; opacity: 0.88; max-width: 520px; margin: 0 auto 32px; }
    .hero-pills { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px 24px; margin-bottom: 36px; }
    .hero-pill { display: flex; align-items: center; gap: 7px; font-size: 0.875rem; font-weight: 500; opacity: 0.92; }
    .hero-pill::before { content: '✓'; color: #69db7c; font-weight: 700; }

    /* ── ZIP FORM ── */
    .hero-form { max-width: 460px; margin: 0 auto 16px; }
    .zip-group { display: flex; gap: 0; background: #fff; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 24px rgba(0,0,0,0.18); }
    .zip-input { flex: 1; border: none; outline: none; padding: 16px 20px; font-size: 1.0625rem; font-family: inherit; color: #1a1a2e; background: transparent; }
    .zip-input::placeholder { color: #9ca3af; }
    .btn-cta { background: var(--color-accent); color: #fff; border: none; padding: 16px 28px; font-size: 1.0625rem; font-weight: 800; cursor: pointer; font-family: inherit; transition: background 0.2s, transform 0.15s; white-space: nowrap; display: flex; align-items: center; gap: 8px; }
    .btn-cta:hover { background: var(--color-accent); opacity: 0.88; transform: translateX(2px); }
    .btn-cta svg { width: 18px; height: 18px; flex-shrink: 0; }
    .hero-form-note { color: rgba(255,255,255,0.7); font-size: 0.8125rem; text-align: center; }
    .hero-trust { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px 28px; margin-top: 36px; padding-top: 28px; border-top: 1px solid rgba(255,255,255,0.15); }
    .trust-item { display: flex; align-items: center; gap: 7px; font-size: 0.8125rem; font-weight: 500; opacity: 0.88; }

    /* ── CALC ── */
    .calc-section { background: #f0f4ff; padding: 72px 0; }
    .section-label { display: inline-flex; align-items: center; gap: 8px; background: color-mix(in srgb, var(--color-primary) 12%, #fff); color: var(--color-primary); border-radius: 99px; padding: 5px 14px; font-size: 0.8125rem; font-weight: 700; margin-bottom: 16px; }
    .section-header { text-align: center; margin-bottom: 48px; }
    .section-header h2 { font-size: clamp(1.5rem, 3vw, 2.25rem); font-weight: 800; margin-bottom: 10px; }
    .section-header p { color: #6b7280; max-width: 480px; margin: 0 auto; }
    .calc-card { background: #fff; border-radius: 20px; padding: 36px; max-width: 680px; margin: 0 auto; box-shadow: 0 4px 24px rgba(59,91,219,0.08); }
    .calc-amount-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; font-weight: 600; }
    .calc-amount-val { font-size: 1.5rem; font-weight: 800; color: var(--color-primary); }
    .calc-slider { width: 100%; height: 6px; appearance: none; background: linear-gradient(to right, var(--color-primary) var(--pct,50%), #e8eaf0 var(--pct,50%)); border-radius: 99px; outline: none; cursor: pointer; margin-bottom: 8px; }
    .calc-slider::-webkit-slider-thumb { appearance: none; width: 22px; height: 22px; background: var(--color-primary); border-radius: 99px; border: 3px solid #fff; box-shadow: 0 2px 8px rgba(59,91,219,0.35); }
    .calc-range-labels { display: flex; justify-content: space-between; font-size: 0.8125rem; color: #9ca3af; margin-bottom: 28px; }
    .calc-tiers { display: grid; grid-template-columns: repeat(3,1fr); gap: 16px; margin-bottom: 24px; }
    .calc-tier { border: 2px solid #e8eaf0; border-radius: 14px; padding: 18px 14px; text-align: center; cursor: pointer; transition: border-color 0.2s, background 0.2s; position: relative; }
    .calc-tier.active { border-color: var(--color-primary); background: color-mix(in srgb, var(--color-primary) 8%, #fff); }
    .calc-tier-best { position: absolute; top: -11px; left: 50%; transform: translateX(-50%); background: var(--color-accent); color: #fff; font-size: 0.6875rem; font-weight: 700; padding: 3px 10px; border-radius: 99px; white-space: nowrap; }
    .calc-tier-name { font-size: 0.875rem; font-weight: 700; color: #374151; margin-bottom: 4px; }
    .calc-tier-rate { font-size: 0.75rem; color: #10b981; font-weight: 600; margin-bottom: 6px; }
    .calc-tier-payment { font-size: 1.375rem; font-weight: 800; color: #1a1a2e; }
    .calc-tier-mo { font-size: 0.75rem; color: #9ca3af; }
    .calc-tier-details { margin-top: 8px; font-size: 0.75rem; color: #9ca3af; line-height: 1.5; }
    .btn-calc { display: flex; align-items: center; justify-content: center; gap: 10px; width: 100%; background: var(--color-accent); color: #fff; border: none; padding: 16px; font-size: 1.0625rem; font-weight: 800; border-radius: 12px; cursor: pointer; font-family: inherit; transition: background 0.2s; }
    .btn-calc:hover { background: var(--color-accent); opacity: 0.88; }
    .calc-footnote { text-align: center; font-size: 0.8125rem; color: #9ca3af; margin-top: 10px; }

    /* ── APR TABLE ── */
    .apr-section { background: #fff; padding: 72px 0 80px; }
    .apr-wrap { max-width: 860px; margin: 0 auto; }
    .apr-title { text-align: center; margin-bottom: 20px; }
    .apr-title h2 { font-size: clamp(1.35rem, 2.6vw, 2rem); font-weight: 800; margin-bottom: 8px; }
    .apr-title p { color: #6b7280; font-size: 0.95rem; }
    .apr-table-wrap { overflow-x: auto; border: 1px solid #e8eaf0; border-radius: 14px; background: #fff; }
    .apr-table { width: 100%; border-collapse: collapse; min-width: 580px; }
    .apr-table th, .apr-table td { padding: 14px 16px; border-bottom: 1px solid #eef1f6; text-align: left; font-size: 0.9rem; }
    .apr-table th { background: #f8f9fd; font-weight: 700; color: #374151; }
    .apr-table tr:last-child td { border-bottom: none; }
    .apr-note { margin-top: 12px; color: #6b7280; font-size: 0.8125rem; text-align: center; }

    /* ── MODALS ── */
    .modal-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.55); z-index: 200; align-items: center; justify-content: center; padding: 20px; }
    .modal-overlay.open { display: flex; }
    .modal { background: #fff; border-radius: 20px; max-width: 560px; width: 100%; max-height: 80vh; overflow-y: auto; padding: 36px; position: relative; }
    .modal-close { position: absolute; top: 16px; right: 16px; background: #f3f4f6; border: none; width: 32px; height: 32px; border-radius: 99px; cursor: pointer; font-size: 1rem; display: flex; align-items: center; justify-content: center; }
    .modal h3 { font-size: 1.25rem; font-weight: 800; margin-bottom: 16px; }
    .modal p { font-size: 0.9rem; color: #6b7280; line-height: 1.7; margin-bottom: 12px; }

    @media (max-width: 768px) {
      .nav-phone { display: none; }
      .hero h1 { font-size: 1.875rem; }
      .zip-group { flex-direction: column; border-radius: 12px; }
      .zip-input { border-radius: 12px 12px 0 0; border-bottom: 1px solid #e8eaf0; }
      .btn-cta { border-radius: 0 0 12px 12px; justify-content: center; }
      .calc-tiers { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>

<!-- NAV -->
<nav>
  <div class="container nav-inner">
    <div class="nav-logo"><span>💰</span>{brand}</div>
    <div class="nav-right">
      <a href={`tel:${phone}`} class="nav-phone">📞 {phone}</a>
      <button class="btn-nav" onclick="document.getElementById('zip-main').focus()">Apply Now</button>
    </div>
  </div>
</nav>

<!-- HERO -->
<section class="hero">
  <div class="container">
    <div class="hero-badge">Join 50,000+ People Who Got Funded This Month.</div>
    <h1 set:html={`${h1} <em>Up to $${amountMax}</em> by Tomorrow.`}></h1>
    <p class="hero-sub">{sub}</p>
    <div class="hero-pills">
      <span class="hero-pill">No hard credit check</span>
      <span class="hero-pill">Instant decision</span>
      <span class="hero-pill">Funds next day</span>
    </div>
    <div class="hero-form">
      <form class="zip-group" onsubmit="handleZip(event)">
        <input id="zip-main" class="zip-input" type="text" inputmode="numeric" maxlength="5" placeholder="Enter your ZIP Code" autocomplete="postal-code" />
        <input type="hidden" name="gclid" id="gclid-hidden" />
        <button type="submit" class="btn-cta">
          {cta}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"></path></svg>
        </button>
      </form>
      <p class="hero-form-note" style="margin-top:10px">Apply now — get funded as soon as tomorrow</p>
    </div>
  </div>
</section>

<!-- PAYMENT CALCULATOR -->
<section class="calc-section">
  <div class="container">
    <div class="section-header">
      <div class="section-label">💳 Payment Calculator</div>
      <h2>See Your Monthly Payment</h2>
      <p>Choose your loan amount and see instant payment options</p>
    </div>
    <div class="calc-card">
      <div class="calc-amount-row">
        <span>Loan Amount</span>
        <span class="calc-amount-val" id="calc-display">$2,000</span>
      </div>
      <input type="range" class="calc-slider" id="calc-slider" min={amountMinRaw} max={amountMaxRaw} value={amountMaxRaw} oninput="updateCalc(this.value); selectTier(6);" />
      <div class="calc-range-labels"><span>$${amountMin}</span><span>$${amountMax}</span></div>
      <div class="calc-tiers">
        <div class="calc-tier active" id="tier-6" onclick="selectTier(6)">
          <div class="calc-tier-best">BEST VALUE</div>
          <div class="calc-tier-name">Pay in 6</div>
          <div class="calc-tier-rate">0% Interest</div>
          <div class="calc-tier-payment" id="pay-6">$333/mo</div>
          <div class="calc-tier-mo">per month</div>
          <div class="calc-tier-details" id="detail-6">APR: 0% · Total: $2,000</div>
        </div>
        <div class="calc-tier" id="tier-12" onclick="selectTier(12)">
          <div class="calc-tier-name">Pay in 12</div>
          <div class="calc-tier-rate">15.99% APR</div>
          <div class="calc-tier-payment" id="pay-12">$180/mo</div>
          <div class="calc-tier-mo">per month</div>
          <div class="calc-tier-details" id="detail-12">APR: 15.99% · Total: $2,160</div>
        </div>
        <div class="calc-tier" id="tier-24" onclick="selectTier(24)">
          <div class="calc-tier-name">Pay in 24</div>
          <div class="calc-tier-rate">19.99% APR</div>
          <div class="calc-tier-payment" id="pay-24">$100/mo</div>
          <div class="calc-tier-mo">per month</div>
          <div class="calc-tier-details" id="detail-24">APR: 19.99% · Total: $2,400</div>
        </div>
      </div>
      <button class="btn-calc" id="calc-apply-btn" onclick="handleCalcApply()">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"></path></svg>
        Apply for $2,000
      </button>
      <p class="calc-footnote">No impact on your credit score to check eligibility</p>
    </div>
  </div>
</section>

<!-- APR TABLE -->
<section class="apr-section" aria-label="APR Comparison Table">
  <div class="container apr-wrap">
    <div class="apr-title">
      <h2>APR Comparison Table</h2>
      <p>Review estimated costs by term length before you apply.</p>
    </div>
    <div class="apr-table-wrap">
      <table class="apr-table">
        <thead>
          <tr>
            <th>Repayment Term</th>
            <th>Estimated APR</th>
            <th>Est. Monthly Payment</th>
            <th>Est. Total Cost</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>6 months</td>
            <td>0.00%</td>
            <td id="apr-pay-6">$333</td>
            <td id="apr-total-6">$2,000</td>
          </tr>
          <tr>
            <td>12 months</td>
            <td>15.99%</td>
            <td id="apr-pay-12">$180</td>
            <td id="apr-total-12">$2,160</td>
          </tr>
          <tr>
            <td>24 months</td>
            <td>19.99%</td>
            <td id="apr-pay-24">$100</td>
            <td id="apr-total-24">$2,400</td>
          </tr>
        </tbody>
      </table>
    </div>
    <p class="apr-note">Representative APR range: {aprMin}% to {aprMax}% (actual offer may vary by lender).</p>
  </div>
</section>

<!-- MODALS -->
<div class="modal-overlay" id="modal-privacy" onclick="closeModal('privacy')">
  <div class="modal" onclick="event.stopPropagation()">
    <button class="modal-close" onclick="closeModal('privacy')">✕</button>
    <h3>Privacy Policy</h3>
    <p>Your privacy is important to us. We use industry-standard encryption to protect your data.</p>
  </div>
</div>

<div class="modal-overlay" id="modal-terms" onclick="closeModal('terms')">
  <div class="modal" onclick="event.stopPropagation()">
    <button class="modal-close" onclick="closeModal('terms')">✕</button>
    <h3>Terms of Service</h3>
    <p>{brand} is a loan matching service. APR ranges from {aprMin}% to {aprMax}%.</p>
  </div>
</div>

<script is:inline>
var currentGclid = '';

function getGclidFromUrl() {
  var params = new URLSearchParams(window.location.search);
  return params.get('gclid') || params.get('GCLID') || '';
}

function firePixel(eventName, amount) {
  var qs = new URLSearchParams();
  qs.set('event', eventName);
  if (amount) qs.set('amount', String(amount));
  if (currentGclid) qs.set('gclid', currentGclid);
  var endpoint = 'https://t.' + window.location.hostname + '/e?' + qs.toString();
  if (navigator.sendBeacon) {
    navigator.sendBeacon(endpoint);
  } else {
    fetch(endpoint, { method: 'GET', keepalive: true }).catch(function () {});
  }
}

function handleZip(e) {
  e.preventDefault();
  var zip = document.getElementById('zip-main').value.trim();
  if (!/^\d{5}$/.test(zip)) {
    document.getElementById('zip-main').style.outline = '2px solid #ef4444';
    setTimeout(() => { document.getElementById('zip-main').style.outline = ''; }, 2000);
    return;
  }
  firePixel('zip_submit');
  if (window.gtag) {
    window.gtag('event', 'zip_submit', { gclid: currentGclid || undefined });
  }
  window.location.href = '/apply?zip=' + zip;
}

var _slider = document.getElementById('calc-slider');
var calcMin = parseInt(_slider?.min || '100');
var calcMax = parseInt(_slider?.max || '5000');
var calcAmount = calcMax;

function updateCalc(val) {
  calcAmount = parseInt(val);
  var pct = ((calcAmount - calcMin) / (calcMax - calcMin)) * 100;
  document.getElementById('calc-slider').style.setProperty('--pct', pct + '%');
  document.getElementById('calc-display').textContent = '$' + calcAmount.toLocaleString();
  document.getElementById('calc-apply-btn').innerHTML = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"></path></svg> Apply for $' + calcAmount.toLocaleString();
  document.getElementById('pay-6').textContent = '$' + Math.ceil(calcAmount / 6).toLocaleString() + '/mo';
  document.getElementById('pay-12').textContent = '$' + Math.ceil(calcAmount * 1.08 / 12).toLocaleString() + '/mo';
  document.getElementById('pay-24').textContent = '$' + Math.ceil(calcAmount * 1.12 / 24).toLocaleString() + '/mo';
  document.getElementById('apr-pay-6').textContent = '$' + Math.ceil(calcAmount / 6).toLocaleString();
  document.getElementById('apr-pay-12').textContent = '$' + Math.ceil(calcAmount * 1.08 / 12).toLocaleString();
  document.getElementById('apr-pay-24').textContent = '$' + Math.ceil(calcAmount * 1.12 / 24).toLocaleString();
  document.getElementById('apr-total-6').textContent = '$' + calcAmount.toLocaleString();
  document.getElementById('apr-total-12').textContent = '$' + Math.ceil(calcAmount * 1.08).toLocaleString();
  document.getElementById('apr-total-24').textContent = '$' + Math.ceil(calcAmount * 1.12).toLocaleString();
}

function selectTier(m) {
  ['tier-6','tier-12','tier-24'].forEach(id => document.getElementById(id)?.classList.remove('active'));
  document.getElementById('tier-' + m)?.classList.add('active');
}

function handleCalcApply() {
  firePixel('calc_apply_click', calcAmount);
  if (window.gtag) {
    window.gtag('event', 'conversion', {
      send_to: 'AW-CONVERSION_ID/default',
      value: calcAmount,
      currency: 'USD',
      gclid: currentGclid || undefined
    });
  }
  window.location.href = '/apply?amount=' + encodeURIComponent(String(calcAmount));
}

function openModal(name) { document.getElementById('modal-' + name)?.classList.add('open'); }
function closeModal(name) { document.getElementById('modal-' + name)?.classList.remove('open'); }

currentGclid = getGclidFromUrl();
var gclidHidden = document.getElementById('gclid-hidden');
if (gclidHidden) gclidHidden.value = currentGclid;
updateCalc(calcAmount);
</script>

</body>
</html>
