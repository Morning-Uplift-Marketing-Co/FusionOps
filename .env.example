# FusionOps / lp-factory-web — copy to ".env" at repo root (see README.md Quick Start).
# Copy to ".env" in this folder (repo root) and fill in real values.
# For the same data as the live dashboard, use the SAME VITE_NEON_URL + VITE_API_BASE as production CI/build.
# cp .env.example .env   (macOS/Linux)
# copy .env.example .env (Windows CMD)
#
# VITE_* are embedded in the client bundle — treat every value as public.

# Neon — FusionOps project, branch you use (e.g. production). Pooler URL recommended.
VITE_NEON_URL=postgresql://USER:PASSWORD@ep-xxxxx.region.aws.neon.tech/neondb?sslmode=require

# Cloudflare Worker API base (must end with /api)
VITE_API_BASE=https://your-worker.workers.dev/api

# Cloudflare (dashboard deploy / DNS). Optional if you only use Settings UI + Neon.
# Do not put production tokens in git. GitHub Actions uses repo secrets
# CLOUDFLARE_API_TOKEN and CLOUDFLARE_ACCOUNT_ID (see .github/workflows/deploy-lp.yml).
VITE_CF_ACCOUNT_ID=
VITE_CF_API_TOKEN=

# Voluum (optional)
VITE_VOLUUM_ACCESS_KEY_ID=
VITE_VOLUUM_ACCESS_KEY=

# LeadingCards (optional)
VITE_LENDINGCARD_TOKEN=

# Sentry (optional)
VITE_SENTRY_DSN=
VITE_SENTRY_DEV=
PUBLIC_SENTRY_DSN=
PUBLIC_SENTRY_DEV=

# E2E only
# VITE_E2E=1

# --- See docs/DATABASES.md for Neon vs D1 vs Cloudflare “accounts” ---
